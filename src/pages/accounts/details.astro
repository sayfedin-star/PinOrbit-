  });

  // Unified Single Source of Truth UI State Sync
  function refreshAccountUI(updatedPayload?: Partial<Account>) {
    if (updatedPayload && currentAccount) {
      Object.assign(currentAccount, updatedPayload);
    }

    if (currentAccount) {
      renderHeader(currentAccount);
      if (currentStats) {
        renderKPIs(currentStats, currentAccount);
      }
      renderScheduling(currentAccount);
    }
  }

  async function handleToggleActive() {
    if (!currentAccount) return;
    try {
      const newStatus = !currentAccount.is_active;
      const res = await toggleAccountActive(currentAccount.id, newStatus);
      if (res.data || res.success) {
        const updated = res.data || { ...currentAccount, is_active: newStatus };
        refreshAccountUI(updated);
        showFeedbackBanner(`Account status updated to ${newStatus ? 'Active' : 'Inactive'}.`, 'success');
        // Authoritative background sync
        loadAllData();
      } else if (res.error) {
        showFeedbackBanner(res.error, 'error');
      }
    } catch (err: any) {
      showFeedbackBanner(err.message || 'Failed to toggle account status', 'error');
    }
  }

  function openLimitModal() {
    if (!currentAccount) return;
    const modal = document.getElementById('edit-limit-modal');
    const input = document.getElementById('limit-input-num') as HTMLInputElement;
    if (input) input.value = String(currentAccount.max_pins_per_day);
    modal?.classList.remove('hidden');
    modal?.classList.add('flex');
  }

  function setupModalListeners() {
    // Direct listeners — all action buttons are static HTML, always in DOM
    // btn-open-create-board-modal is wired inside initCreateBoardModal()
    document.getElementById('open-webhooks-modal-btn')?.addEventListener('click', () => openManageWebhooksModal());
    document.getElementById('btn-edit-limit')?.addEventListener('click', () => openLimitModal());
    document.getElementById('btn-toggle-active')?.addEventListener('click', () => handleToggleActive());

    // Static once-only delegated listeners
    document.getElementById('btn-test-webhook-ping')?.addEventListener('click', () =>
      showFeedbackBanner('⚡ Webhook Ping: Server Response 200 OK (Active & Healthy).', 'success')
    );

    // Delegated: copy account ID — btn-copy-acc-id is inside account-header-info which re-renders
    document.getElementById('account-header-info')?.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('#btn-copy-acc-id');
      if (!btn) return;
      e.preventDefault();
      const idStr = btn.getAttribute('data-id') || '';
      if (idStr) {
        navigator.clipboard.writeText(idStr);
        showFeedbackBanner(`Account ID (${idStr}) copied to clipboard.`, 'success');
      }
    });

    // Delegated: auto-pacing button — rendered dynamically inside paceDescElem
    document.getElementById('sched-pace-desc')?.addEventListener('click', async (e) => {
      const btn = (e.target as HTMLElement).closest('#btn-apply-optimal-pacing');
      if (!btn || !currentAccount) return;
      e.preventDefault();
      const targetMins = parseInt(btn.getAttribute('data-optimal') || '0', 10);
      if (!targetMins) return;
      const res = await updateAccountSchedule(currentAccount.id, { posting_interval_minutes: targetMins });
      refreshAccountUI({ ...(res.data || {}), posting_interval_minutes: targetMins });
      showFeedbackBanner(`Posting interval auto-adjusted to optimal ${targetMins} minutes pacing.`, 'success');
      loadAllData();
    });

    // Escape key closes any open modal
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      // create-board-modal handled by its own Escape-aware close inside initCreateBoardModal
      const modals = [
        { id: 'edit-limit-modal',      close: closeLimitModal },
        { id: 'webhooks-manage-modal', close: closeWebhooksModal },
        { id: 'create-board-modal',    close: () => {
            const m = document.getElementById('create-board-modal');
            m?.classList.add('hidden'); m?.classList.remove('flex');
          }
        },
      ];
      for (const { id, close } of modals) {
        const el = document.getElementById(id);
        if (el && !el.classList.contains('hidden')) { close(); return; }
      }
    });

    // Limit modal
    document.getElementById('close-limit-btn')?.addEventListener('click', closeLimitModal);
    document.getElementById('cancel-limit-btn')?.addEventListener('click', closeLimitModal);
    document.getElementById('edit-limit-backdrop')?.addEventListener('click', closeLimitModal);

    document.getElementById('limit-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!currentAccount) return;
      const val = parseInt((document.getElementById('limit-input-num') as HTMLInputElement).value, 10);
      if (isNaN(val) || val < 1) return;

      const limitSaveBtn = document.querySelector('#limit-form [type="submit"]') as HTMLButtonElement | null;
      if (limitSaveBtn) { limitSaveBtn.disabled = true; limitSaveBtn.textContent = 'Saving...'; }

      const res = await updateAccountDailyLimit(currentAccount.id, val);

      if (limitSaveBtn) { limitSaveBtn.disabled = false; limitSaveBtn.textContent = 'Save Limit'; }
      if (res.data || res.success) {
        const updated = res.data || { ...currentAccount, max_pins_per_day: val };
        refreshAccountUI(updated);
        closeLimitModal();
        showFeedbackBanner(`Account daily limit updated to ${val} pins/day.`, 'success');
        // Authoritative background sync
        loadAllData();
      } else if (res.error) {
        showFeedbackBanner('Failed to update daily limit: ' + res.error, 'error');
      }
    });

    // Webhook manager modal listeners
    document.getElementById('close-webhooks-modal')?.addEventListener('click', closeWebhooksModal);
    document.getElementById('dismiss-webhooks-modal')?.addEventListener('click', closeWebhooksModal);
    document.getElementById('webhooks-manage-backdrop')?.addEventListener('click', closeWebhooksModal);
    document.getElementById('open-add-webhook-btn')?.addEventListener('click', () => showWebhookForm());
    document.getElementById('cancel-webhook-form')?.addEventListener('click', hideWebhookForm);

    // Phase 3: Create Board — single init owns open/close/submit lifecycle
    initCreateBoardModal();

    document.getElementById('submit-webhook-form')?.addEventListener('click', async () => {
      if (!currentAccount) return;
      hideWebhooksModalFeedback();

      const webhookId = (document.getElementById('form-webhook-id') as HTMLInputElement).value;
      const label = (document.getElementById('form-hook-label') as HTMLInputElement).value.trim();
      const url = (document.getElementById('form-hook-url') as HTMLInputElement).value.trim();
      const cap = parseInt((document.getElementById('form-hook-capacity') as HTMLInputElement).value, 10);
      const prio = parseInt((document.getElementById('form-hook-priority') as HTMLInputElement).value, 10);
      const active = (document.getElementById('form-hook-active') as HTMLInputElement).checked;
      const primary = (document.getElementById('form-hook-primary') as HTMLInputElement).checked;

      if (!label) {
        showWebhooksModalError('Label is required.');
        return;
      }
      if (!url || !url.startsWith('http')) {
        showWebhooksModalError('Valid HTTP/HTTPS Webhook URL is required.');
        return;
      }
      if (isNaN(cap) || cap < 1) {
        showWebhooksModalError('Monthly capacity must be a positive integer (minimum 1).');
        return;
      }
      if (isNaN(prio) || prio < 1) {
        showWebhooksModalError('Priority must be a positive integer (minimum 1).');
        return;
      }

      // Check duplicates for this account
      const labelDup = activeAccountWebhooks.some(
        (w) => w.id !== webhookId && w.label.toLowerCase() === label.toLowerCase()
      );
      if (labelDup) {
        showWebhooksModalError(`A webhook labeled "${label}" already exists for this account.`);
        return;
      }

      const urlDup = activeAccountWebhooks.some(
        (w) => w.id !== webhookId && w.webhook_url.toLowerCase() === url.toLowerCase()
      );
      if (urlDup) {
        showWebhooksModalError('This webhook URL is already registered for this account.');
        return;
      }

      if (webhookId) {
        // Edit existing
        const { error } = await updateAccountWebhook(webhookId, {
          label,
          webhook_url: url,
          monthly_capacity: cap,
          priority: prio,
          is_active: active,
          is_primary: primary,
        });
        if (error) showWebhooksModalError(error);
        else {
          showWebhooksModalSuccess('Webhook channel updated successfully.');
          hideWebhookForm();
          await refreshWebhooksList();
          await loadAllData();
        }
      } else {
        // Create new
        const { error } = await createAccountWebhook({
          account_id: currentAccount.id,
          label,
          webhook_url: url,
          monthly_capacity: cap,
          priority: prio,
          is_active: active,
          is_primary: primary,
        });
        if (error) showWebhooksModalError(error);
        else {
          showWebhooksModalSuccess('New webhook channel added successfully.');
          hideWebhookForm();
          await refreshWebhooksList();
          await loadAllData();
        }
      }
    });

    // Board action listeners (Refresh list & Delete board)
    document.getElementById('btn-refresh-boards')?.addEventListener('click', async () => {
      if (!accountId) return;
      try {
        const r = await fetch('/api/boards/action', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ account_id: accountId, action: 'list' })
        });
        const d = await r.json();
        if (r.ok) {
          showFeedbackBanner('Board list refresh request sent. Boards will sync via Make callback.', 'success');
          setTimeout(() => window.location.reload(), 1500);
        } else {
          alert(d.error || 'Failed to refresh boards');
        }
      } catch (e: any) {
        alert('Failed to refresh boards: ' + e.message);
      }
    });

    document.addEventListener('click', async (e) => {
      const target = e.target as HTMLElement;
      const deleteBtn = target.closest('.board-delete-btn');
      if (deleteBtn && accountId) {
        const boardId = deleteBtn.getAttribute('data-board-id');
        const boardName = deleteBtn.getAttribute('data-board-name');
        if (!boardId || !confirm(`Delete board "${boardName}"? This will remove it from Pinterest.`)) return;
        
        try {
          const r = await fetch('/api/boards/action', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ account_id: accountId, action: 'delete', board_id: boardId })
          });
          const d = await r.json();
          if (r.ok) {
            showFeedbackBanner(`Board "${boardName}" deletion request sent.`, 'success');
            setTimeout(() => window.location.reload(), 1500);
          } else {
            alert(d.error || 'Failed to delete board');
          }
        } catch (e: any) {
          alert('Failed to delete board: ' + e.message);
        }
      }
    });
  }

  function hideWebhookForm() {
    const formContainer = document.getElementById('webhook-form-container');
    if (formContainer) formContainer.classList.add('hidden');
  }

  function hideWebhooksModalFeedback() {
    const err = document.getElementById('webhooks-modal-error');
    const succ = document.getElementById('webhooks-modal-success');
    if (err) err.classList.add('hidden');
    if (succ) succ.classList.add('hidden');
  }

  function showWebhooksModalError(msg: string) {
    const err = document.getElementById('webhooks-modal-error');
    if (err) {
      err.textContent = msg;
      err.classList.remove('hidden');
    }
  }

  function showWebhooksModalSuccess(msg: string) {
    const succ = document.getElementById('webhooks-modal-success');
    if (succ) {
      succ.textContent = msg;
      succ.classList.remove('hidden');
    }
  }

  async function openManageWebhooksModal() {
    if (!currentAccount) return;
    const modal = document.getElementById('webhooks-manage-modal');
    const subtitle = document.getElementById('manage-webhooks-subtitle');
    if (subtitle) subtitle.textContent = `Managing Webhooks for: ${currentAccount.account_name}`;

    hideWebhookForm();
    hideWebhooksModalFeedback();

    modal?.classList.remove('hidden');
    modal?.classList.add('flex');

    await refreshWebhooksList();
  }

  function closeWebhooksModal() {
    const modal = document.getElementById('webhooks-manage-modal');
    modal?.classList.add('hidden');
    modal?.classList.remove('flex');
    hideWebhookForm();
  }

  // ── Create Board Modal ─────────────────────────────────────────────────────
  // Single function owns the full lifecycle: open → fetch webhooks → submit → close
  function initCreateBoardModal() {
    const modal       = document.getElementById('create-board-modal')!;
    const form        = document.getElementById('create-board-form') as HTMLFormElement;
    const nameInput   = document.getElementById('new-board-name-input') as HTMLInputElement;
    const hookSelect  = document.getElementById('new-board-webhook-select') as HTMLSelectElement;
    const loadingEl   = document.getElementById('create-board-webhook-loading')!;
    const errorBox    = document.getElementById('create-board-error')!;
    const errorText   = document.getElementById('create-board-error-text')!;
    const successBox  = document.getElementById('create-board-success')!;
    const successText = document.getElementById('create-board-success-text')!;
    const reusedBox   = document.getElementById('create-board-reused')!;
    const reusedText  = document.getElementById('create-board-reused-text')!;
    const submitBtn   = document.getElementById('submit-create-board-btn') as HTMLButtonElement;
    const spinner     = document.getElementById('create-board-spinner')!;
    const btnLabel    = document.getElementById('create-board-btn-label')!;

    // ── Helpers ──
    function resetFeedback() {
      errorBox.classList.add('hidden');
      successBox.classList.add('hidden');
      reusedBox.classList.add('hidden');
    }

    function showError(msg: string) {
      resetFeedback();
      errorText.textContent = msg;
      errorBox.classList.remove('hidden');
    }

    function showSuccess(msg: string) {
      resetFeedback();
      successText.textContent = msg;
      successBox.classList.remove('hidden');
    }

    function showReused(msg: string) {
      resetFeedback();
      reusedText.textContent = msg;
      reusedBox.classList.remove('hidden');
    }

    function setSubmitting(loading: boolean) {
      submitBtn.disabled = loading;
      spinner.classList.toggle('hidden', !loading);
      btnLabel.textContent = loading ? 'Creating...' : 'Create Board';
    }

    function closeModal() {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      // Reset form state after animation
      setTimeout(() => {
        form.reset();
        resetFeedback();
        setSubmitting(false);
      }, 150);
    }

    async function populateWebhooks() {
      if (!currentAccount) return;

      // Show skeleton, hide real select
      loadingEl.classList.remove('hidden');
      hookSelect.classList.add('hidden');

      try {
        const hooks = await getAccountWebhooks(currentAccount.id);
        const activeHooks = hooks.filter((h) => h.is_active);
        const preferredId = currentAccount.board_creation_webhook_id
          || (activeHooks.find((h) => h.is_primary) || activeHooks[0])?.id;

        if (activeHooks.length === 0) {
          hookSelect.innerHTML = '<option value="" disabled selected>No active webhooks configured</option>';
          showError('No active webhook channels found. Please add a webhook first via Manage Webhooks.');
        } else {
          hookSelect.innerHTML = activeHooks
            .map((h) =>
              `<option value="${h.id}" ${h.id === preferredId ? 'selected' : ''}>
                ${escapeHtml(h.label)} (${h.remaining_capacity} capacity)
              </option>`
            ).join('');
        }
      } catch (err) {
        hookSelect.innerHTML = '<option value="" disabled selected>Error loading webhooks</option>';
        showError('Failed to load webhook channels. Please try again.');
      } finally {
        loadingEl.classList.add('hidden');
        hookSelect.classList.remove('hidden');
      }
    }

    // ── Open ──
    async function openModal() {
      if (!currentAccount) {
        console.warn('openCreateBoardModal: no currentAccount yet');
        return;
      }
      // Reset then show
      form.reset();
      resetFeedback();
      setSubmitting(false);
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      nameInput.focus();

      // Fetch webhooks after showing modal (non-blocking UX)
      await populateWebhooks();
    }

    // ── Submit ──
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!currentAccount) return;

      resetFeedback();
      const boardName = nameInput.value.trim();
      const webhookId = hookSelect.value || undefined;

      if (!boardName) {
        showError('Please enter a board name.');
        nameInput.focus();
        return;
      }

      setSubmitting(true);

      try {
        const res = await createBoardViaWebhook({
          accountId: currentAccount.id,
          boardName,
          webhookId,
          triggerSource: 'account_details_manual',
        });

        setSubmitting(false);

        if (res.success && res.reused) {
          showReused(`Board "${boardName}" already exists on this account — reusing it.`);
          setTimeout(() => { closeModal(); loadAllData(); }, 1800);
        } else if (res.success && res.board) {
          showSuccess(`Board "${boardName}" created successfully!`);
          setTimeout(() => { closeModal(); loadAllData(); }, 1200);
        } else {
          showError(res.error || 'Failed to create board. Please try again.');
        }
      } catch (err: any) {
        setSubmitting(false);
        showError('An unexpected error occurred. Please try again.');
      }
    });

    // ── Close triggers ──
    document.getElementById('close-create-board-modal')?.addEventListener('click', closeModal);
    document.getElementById('cancel-create-board-btn')?.addEventListener('click', closeModal);
    document.getElementById('btn-open-create-board-modal')?.addEventListener('click', () => openModal());
    modal.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });

    // Escape key for this modal is handled by the global Escape listener in setupModalListeners
  }

  async function refreshWebhooksList() {
    if (!currentAccount) return;
    const container = document.getElementById('webhooks-list-container');
    if (!container) return;

    container.innerHTML = '<div class="p-8 text-center text-xs text-muted-foreground animate-pulse">Loading account webhooks...</div>';

    activeAccountWebhooks = await getAccountWebhooks(currentAccount.id);

    if (!activeAccountWebhooks || activeAccountWebhooks.length === 0) {
      container.innerHTML = renderEmptyStateHTML(
        'No Webhooks Configured',
        'Click "+ Add Webhook" above to create your first Make.com outbound channel.',
        'inbox'
      );
      return;
    }

    renderWebhookCards();
  }

  function renderWebhookCards() {
    const container = document.getElementById('webhooks-list-container');
    if (!container) return;

    const cardsHtml = activeAccountWebhooks
      .map((hook) => {
        const masked = hook.webhook_url.length > 25
          ? hook.webhook_url.slice(0, 22) + '••••' + hook.webhook_url.slice(-4)
          : hook.webhook_url;
        const remCap = Math.max(0, (hook.monthly_capacity ?? 500) - (hook.monthly_usage ?? 0));
        const capPct = Math.min(100, Math.round((remCap / (hook.monthly_capacity || 500)) * 100));

        return `
          <div class="rounded-xl border border-border bg-card p-4 space-y-3 shadow-sm transition-all hover:border-primary/30">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-2">
                <span class="font-bold text-sm text-foreground">${escapeHtml(hook.label)}</span>
                ${
                  hook.is_primary
                    ? `<span class="rounded-full bg-primary/10 text-primary border border-primary/20 px-2 py-0.5 text-[10px] font-bold">PRIMARY</span>`
                    : ''
                }
                <span class="rounded-md bg-muted px-2 py-0.5 text-[10px] font-semibold text-muted-foreground">Priority ${hook.priority}</span>
              </div>
              <div class="flex items-center gap-2">
                ${renderStatusBadge(hook.is_active)}
              </div>
            </div>

            <div class="font-mono text-xs text-muted-foreground bg-muted/50 rounded-lg px-2.5 py-1.5 truncate" title="Masked Endpoint">
              ${escapeHtml(masked)}
            </div>

            <div class="space-y-1">
              <div class="flex items-center justify-between text-xs">
                <span class="text-muted-foreground font-medium">Monthly Capacity:</span>
                <span class="font-semibold text-foreground">${remCap} / ${hook.monthly_capacity} pins remaining</span>
              </div>
              <div class="h-2 w-full rounded-full bg-muted overflow-hidden">
                <div
                  class="h-full rounded-full transition-all duration-300 ${remCap > 50 ? 'bg-emerald-500' : remCap > 0 ? 'bg-amber-500' : 'bg-rose-500'}"
                  style="width: ${capPct}%"
                ></div>
              </div>
            </div>

            ${
              hook.last_failure_reason
                ? `<div class="rounded-lg bg-rose-500/10 border border-rose-500/20 p-2 text-[11px] text-rose-500 flex items-start gap-1.5">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 flex-shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                    <span>Failure Reason: ${escapeHtml(hook.last_failure_reason)}</span>
                  </div>`
                : ''
            }

            <div class="flex items-center justify-between border-t border-border pt-2.5 text-xs">
              <span class="text-[11px] text-muted-foreground">
                ${hook.last_used_at ? 'Last used: ' + formatDate(hook.last_used_at) : 'Never used'}
              </span>
              <div class="flex items-center gap-2">
                ${
                  !hook.is_primary
                    ? `<button
                        data-webhook-action="set-primary"
                        data-id="${hook.id}"
                        class="text-xs text-primary font-semibold hover:underline"
                      >Set Primary</button>`
                    : ''
                }
                <button
                  data-webhook-action="toggle-active"
                  data-id="${hook.id}"
                  data-active="${hook.is_active}"
                  class="text-xs text-muted-foreground hover:text-foreground font-medium"
                >${hook.is_active ? 'Deactivate' : 'Activate'}</button>
                <button
                  data-webhook-action="edit"
                  data-id="${hook.id}"
                  class="rounded border border-border px-2 py-0.5 text-xs text-foreground hover:bg-muted font-medium"
                >Edit</button>
              </div>
            </div>
          </div>
        `;
      })
      .join('');

    container.innerHTML = cardsHtml;
    bindWebhookCardListeners();
  }

  function bindWebhookCardListeners() {
    document.querySelectorAll('[data-webhook-action="set-primary"]').forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        const id = (e.currentTarget as HTMLElement).getAttribute('data-id') || '';
        if (!currentAccount) return;
        const { error } = await setPrimaryWebhook(id, currentAccount.id);
        if (error) showWebhooksModalError(error);
        else {
          showWebhooksModalSuccess('Primary webhook updated successfully.');
          await refreshWebhooksList();
          await loadAllData();
        }
      });
    });

    document.querySelectorAll('[data-webhook-action="toggle-active"]').forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        const id = (e.currentTarget as HTMLElement).getAttribute('data-id') || '';
        const isActive = (e.currentTarget as HTMLElement).getAttribute('data-active') === 'true';
        const { error } = await toggleAccountWebhookActive(id, !isActive);
        if (error) showWebhooksModalError(error);
        else {
          showWebhooksModalSuccess(`Webhook ${!isActive ? 'activated' : 'deactivated'}.`);
          await refreshWebhooksList();
          await loadAllData();
        }
      });
    });

    document.querySelectorAll('[data-webhook-action="edit"]').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const id = (e.currentTarget as HTMLElement).getAttribute('data-id') || '';
        const target = activeAccountWebhooks.find((w) => w.id === id);
        if (target) showWebhookForm(target);
      });
    });
  }

  function showWebhookForm(target?: AccountWebhook) {
    const formContainer = document.getElementById('webhook-form-container');
    const formTitle = document.getElementById('webhook-form-title');
    const idInput = document.getElementById('form-webhook-id') as HTMLInputElement;
    const labelInput = document.getElementById('form-hook-label') as HTMLInputElement;
    const urlInput = document.getElementById('form-hook-url') as HTMLInputElement;
    const capInput = document.getElementById('form-hook-capacity') as HTMLInputElement;
    const prioInput = document.getElementById('form-hook-priority') as HTMLInputElement;
    const activeCheck = document.getElementById('form-hook-active') as HTMLInputElement;
    const primaryCheck = document.getElementById('form-hook-primary') as HTMLInputElement;

    hideWebhooksModalFeedback();

    if (target) {
      if (formTitle) formTitle.textContent = 'Edit Webhook Channel';
      idInput.value = target.id;
      labelInput.value = target.label;
      urlInput.value = target.webhook_url;
      capInput.value = String(target.monthly_capacity);
      prioInput.value = String(target.priority);
      activeCheck.checked = target.is_active;
      primaryCheck.checked = target.is_primary;
    } else {
      if (formTitle) formTitle.textContent = 'Add New Webhook Channel';
      idInput.value = '';
      labelInput.value = '';
      urlInput.value = '';
      capInput.value = '500';
      prioInput.value = '1';
      activeCheck.checked = true;
      primaryCheck.checked = activeAccountWebhooks.length === 0;
    }

    formContainer?.classList.remove('hidden');
  }

  function closeLimitModal() {
    const modal = document.getElementById('edit-limit-modal');
    modal?.classList.add('hidden');
    modal?.classList.remove('flex');
  }

  // ===== Posting Schedules (engine) wiring =====
  let accountSchedules: any[] = [];

  async function loadSchedules() {
    const rowsEl = document.getElementById('account-schedules-rows');
    if (!rowsEl || !accountId) return;
    try {
      const r = await fetch('/api/schedules?account_id=' + encodeURIComponent(accountId));
      const d = await r.json();
      accountSchedules = Array.isArray(d) ? d : [];
    } catch { accountSchedules = []; }
    rowsEl.innerHTML = accountSchedules.length === 0
      ? '<tr><td colspan="7" class="p-3 text-center text-muted-foreground">No engine schedules yet. Use "Convert current schedule" or "+ Add Posting Schedule".</td></tr>'
      : accountSchedules.map((s: any) =>
          '<tr class="border-b">' +
          '<td class="p-2">' + escapeHtml(s.label || '(unnamed)') + '</td>' +
          '<td class="p-2">' + escapeHtml(s.webhook_id ? 'selected' : 'auto') + '</td>' +
          '<td class="p-2">' + escapeHtml(s.window_start) + '–' + escapeHtml(s.window_end) + '<br/>' + escapeHtml(s.timezone) + '</td>' +
          '<td class="p-2">' + s.interval_minutes + 'm ±' + s.random_delay_minutes + 'm</td>' +
          '<td class="p-2">' + escapeHtml((s.active_days || []).join(',')) + '</td>' +
          '<td class="p-2">' + escapeHtml(s.status) + (s.fastcron_job_id ? '' : ' (no job)') + (s.started_at && new Date(s.started_at) > new Date() ? ' • starts ' + String(s.started_at).slice(0, 10) : '') + '</td>' +
          '<td class="p-2">' +
          '<button data-sact="run" data-sid="' + s.id + '">Run</button> ' +
          '<button data-sact="edit" data-sid="' + s.id + '">Edit</button> ' +
          '<button data-sact="' + (s.status === 'paused' ? 'resume' : 'pause') + '" data-sid="' + s.id + '">' + (s.status === 'paused' ? 'Resume' : 'Pause') + '</button> ' +
          '<button data-sact="clone" data-sid="' + s.id + '">Clone</button> ' +
          '<button data-sact="logs" data-sid="' + s.id + '">Logs</button> ' +
          '<button data-sact="delete" data-sid="' + s.id + '">Del</button>' +
          '</td></tr>').join('');
  }

  function populateChannelSelect() {
    const sel = document.getElementById('f-channel') as HTMLSelectElement | null;
    if (!sel) return;
    const active = (activeAccountWebhooks || []).filter((w: any) => w.is_active);
    sel.innerHTML = active.length
      ? active.map((w: any, i: number) => '<option value="' + w.id + '">' + escapeHtml((w as any).label || (i === 0 ? 'Primary' : 'Channel ' + (i + 1))) + '</option>').join('')
      : '<option value="">No active webhook</option>';
  }

  function updateSchedCadence() {
    const interval = Number((document.getElementById('f-sched-interval') as HTMLInputElement).value || 36);
    const start = (document.getElementById('f-sched-start') as HTMLInputElement).value || '09:00';
    const end = (document.getElementById('f-sched-end') as HTMLInputElement).value || '21:00';
    const h = Math.max(0, Number(end.slice(0, 2)) - Number(start.slice(0, 2)));
    const el = document.getElementById('sched-cadence');
    if (el) el.textContent = '≈ ' + Math.floor((h * 60) / interval) + ' pins/day capacity at ' + interval + 'm interval across ' + h + 'h window.';
  }

  function openScheduleModal(s?: any) {
    populateChannelSelect();
    const acc: any = currentAccount || {};
    (document.getElementById('schedule-modal-title') as HTMLElement).textContent = s ? 'Edit Posting Schedule' : 'Add Posting Schedule';
    (document.getElementById('f-sched-id') as HTMLInputElement).value = s?.id || '';
    (document.getElementById('f-sched-label') as HTMLInputElement).value = s?.label || '';
    (document.getElementById('f-fc-token') as HTMLInputElement).value = '';

    const statusEl = document.getElementById('fc-token-status');
    if (statusEl) {
      if (s?.has_fastcron_token && s?.fastcron_token_masked) {
        statusEl.innerHTML = '<span class="text-emerald-600">Custom: ' + escapeHtml(s.fastcron_token_masked) + '</span>';
      } else {
        statusEl.innerHTML = '<span class="text-muted-foreground">Using default (environment)</span>';
      }
    }

    if (s?.webhook_id) (document.getElementById('f-channel') as HTMLSelectElement).value = s.webhook_id;
    (document.getElementById('f-sched-tz') as HTMLInputElement).value = s?.timezone || acc.timezone || 'UTC';
    (document.getElementById('f-sched-batch') as HTMLInputElement).value = String(s?.batch ?? 1);
    (document.getElementById('f-sched-start') as HTMLInputElement).value = (s?.window_start || acc.posting_window_start || '09:00').slice(0, 5);
    (document.getElementById('f-sched-end') as HTMLInputElement).value = (s?.window_end || acc.posting_window_end || '21:00').slice(0, 5);
    (document.getElementById('f-sched-interval') as HTMLInputElement).value = String(s?.interval_minutes ?? acc.posting_interval_minutes ?? 36);
    (document.getElementById('f-sched-delay') as HTMLInputElement).value = String(s?.random_delay_minutes ?? acc.random_delay_minutes ?? 0);
    const days = s?.active_days ?? acc.active_days;
    (document.getElementById('f-sched-days') as HTMLInputElement).value = Array.isArray(days) ? days.join(',') : (typeof days === 'string' ? (days as string).replace(/[{}"']/g, '') : 'Mon,Tue,Wed,Thu,Fri,Sat,Sun');
    (document.getElementById('f-sched-started') as HTMLInputElement).value = s?.started_at ? String(s.started_at).slice(0, 10) : '';
    updateSchedCadence();
    (document.getElementById('schedule-modal') as any)?.showModal?.();
  }

  async function scheduleAction(id: string, act: string) {
    if (act === 'edit') { openScheduleModal(accountSchedules.find((x) => x.id === id)); return; }
    if (act === 'logs') {
      const r = await fetch('/api/schedules/' + id + '/fastcron?view=logs');
      const d = await r.json();
      alert(JSON.stringify(d, null, 2));
      return;
    }
    if (act === 'delete' && !confirm('Delete this schedule?')) return;
    const r = await fetch('/api/schedules/' + id + '/action', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: act }) });
    const d = await r.json();
    if (!r.ok) alert(d.error || 'Failed');
    await loadSchedules();
  }

  let schedulesListenersAttached = false;
  function setupSchedulesListeners() {
    if (schedulesListenersAttached) return;
    schedulesListenersAttached = true;
    document.getElementById('btn-refresh-schedules')?.addEventListener('click', () => loadSchedules());
    document.getElementById('btn-sync-missing')?.addEventListener('click', async () => {
      const r = await fetch('/api/schedules/sync-missing', { method: 'POST' });
      const d = await r.json();
      alert(JSON.stringify(d));
      await loadSchedules();
    });
    document.getElementById('btn-add-schedule')?.addEventListener('click', () => openScheduleModal());
    document.getElementById('btn-convert-legacy')?.addEventListener('click', async () => {
      if (!currentAccount) return;
      const acc: any = currentAccount;
      const firstWebhook: any = (activeAccountWebhooks || []).filter((w: any) => w.is_active)[0];
      const body = {
        account_id: accountId,
        label: 'Legacy schedule',
        webhook_id: firstWebhook?.id || null,
        timezone: acc.timezone || 'UTC',
        window_start: (acc.posting_window_start || '09:00').slice(0, 5),
        window_end: (acc.posting_window_end || '21:00').slice(0, 5),
        interval_minutes: acc.posting_interval_minutes || 36,
        random_delay_minutes: acc.random_delay_minutes || 0,
        active_days: Array.isArray(acc.active_days) ? acc.active_days : String(acc.active_days || 'Mon,Tue,Wed,Thu,Fri,Sat,Sun').replace(/[{}"']/g, '').split(',').map((x: string) => x.trim()),
        started_at: acc.pinning_started_at || null,
        batch: 1,
      };
      const r = await fetch('/api/schedules', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
      const d = await r.json();
      if (!r.ok) { alert(d.error || 'Failed'); return; }
      showFeedbackBanner('Schedule created from current account schedule.', 'success');
      await loadSchedules();
    });
    document.getElementById('btn-cancel-sched')?.addEventListener('click', () => (document.getElementById('schedule-modal') as any)?.close?.());
    ['f-sched-interval', 'f-sched-start', 'f-sched-end'].forEach((iv) => document.getElementById(iv)?.addEventListener('input', updateSchedCadence));
    document.getElementById('schedule-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const id = (document.getElementById('f-sched-id') as HTMLInputElement).value;
      const fcToken = (document.getElementById('f-fc-token') as HTMLInputElement).value.trim();
      const body = {
        account_id: accountId,
        label: (document.getElementById('f-sched-label') as HTMLInputElement).value,
        webhook_id: (document.getElementById('f-channel') as HTMLSelectElement).value || null,
        timezone: (document.getElementById('f-sched-tz') as HTMLInputElement).value,
        batch: Number((document.getElementById('f-sched-batch') as HTMLInputElement).value),
        window_start: (document.getElementById('f-sched-start') as HTMLInputElement).value,
        window_end: (document.getElementById('f-sched-end') as HTMLInputElement).value,
        interval_minutes: Number((document.getElementById('f-sched-interval') as HTMLInputElement).value),
        random_delay_minutes: Number((document.getElementById('f-sched-delay') as HTMLInputElement).value),
        active_days: ((document.getElementById('f-sched-days') as HTMLInputElement).value).split(',').map((x: string) => x.trim()).filter(Boolean),
        started_at: (document.getElementById('f-sched-started') as HTMLInputElement).value || null,
        ...(fcToken.length > 0 ? { fastcron_token: fcToken } : {}),
      };
      const r = id
        ? await fetch('/api/schedules/' + id, { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) })
        : await fetch('/api/schedules', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
      const d = await r.json();
      if (!r.ok) { alert(d.error || 'Failed'); return; }
      (document.getElementById('schedule-modal') as any)?.close?.();
      await loadSchedules();
    });
    document.getElementById('account-schedules-rows')?.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      const act = t.getAttribute('data-sact'); const sid = t.getAttribute('data-sid');
      if (act && sid) scheduleAction(sid, act);
    });
  }

  init();
</script>
