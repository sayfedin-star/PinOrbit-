---
import Layout from '../../layouts/Layout.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import KPIStatCard from '../../components/ui/KPIStatCard.astro';
---

<Layout title="Manage Account Details" description="Detailed operational, scheduling, and activity control center for Pinterest account.">
  <!-- Back Link & Breadcrumb -->
  <div class="mb-4 flex items-center justify-between">
    <a href="/accounts" class="inline-flex items-center gap-1.5 text-xs font-semibold text-muted-foreground hover:text-foreground transition-all">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
      <span>&larr; Back to Accounts</span>
    </a>
    <span class="text-xs text-muted-foreground font-mono">Account ID: <span id="display-account-id">---</span></span>
  </div>

  <!-- Global Feedback Banner -->
  <div id="account-feedback-banner" class="hidden mb-4 rounded-xl border border-emerald-500/30 bg-emerald-500/10 p-3.5 text-xs text-emerald-600 dark:text-emerald-400 flex items-center justify-between shadow-sm">
    <div class="flex items-center gap-2.5">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>
      </svg>
      <span id="account-feedback-text">Account updated successfully.</span>
    </div>
    <button id="close-account-feedback" class="font-bold opacity-70 hover:opacity-100">&times;</button>
  </div>

  <!-- Header Control Card -->
  <div class="mb-6 rounded-2xl border border-border bg-card p-6 shadow-sm">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
      <!-- Dynamic: account name, status, ID -->
      <div id="account-header-info" class="animate-pulse flex items-center gap-3.5">
        <div class="h-12 w-12 rounded-2xl bg-muted flex-shrink-0"></div>
        <div class="space-y-2">
          <div class="h-6 w-40 rounded-lg bg-muted"></div>
          <div class="h-4 w-56 rounded-lg bg-muted"></div>
        </div>
      </div>
      <!-- Static: action buttons always in DOM -->
      <div id="account-header-actions" class="flex flex-wrap items-center gap-2.5">
        <button
          id="btn-open-create-board-modal"
          class="inline-flex items-center gap-1.5 rounded-xl border border-border bg-background px-3.5 py-2 text-xs font-semibold text-foreground hover:bg-muted transition-all shadow-sm"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          <span>Create Board</span>
        </button>
        <button
          id="btn-refresh-boards"
          class="inline-flex items-center gap-1 rounded-xl border border-border bg-background px-3 py-2 text-xs font-semibold text-foreground hover:bg-muted transition-all shadow-sm"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
          <span>Refresh List</span>
        </button>
        <a
          id="btn-import-posts"
          href="/imports"
          class="inline-flex items-center gap-1.5 rounded-xl bg-emerald-600 px-3.5 py-2 text-xs font-semibold text-white shadow hover:bg-emerald-700 transition-all"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
          <span>+ Import Posts</span>
        </a>
        <button
          id="btn-edit-limit"
          class="inline-flex items-center gap-1.5 rounded-xl border border-border bg-background px-3.5 py-2 text-xs font-semibold text-foreground hover:bg-muted transition-all"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
          <span id="btn-edit-limit-label">Limit: --/day</span>
        </button>
        <button
          id="btn-toggle-active"
          class="inline-flex items-center gap-1.5 rounded-xl border border-border bg-background px-3.5 py-2 text-xs font-semibold text-foreground hover:opacity-80 transition-all"
        >
          <span id="btn-toggle-active-label">Activate</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Section 1: Overview KPI Cards (8 Grid Items) -->
  <div class="mb-8 space-y-3">
    <h3 class="text-sm font-bold text-foreground tracking-wide uppercase">Operational Overview & Metrics</h3>
    <div id="kpis-grid-container" class="grid grid-cols-2 gap-3 sm:grid-cols-4 lg:grid-cols-8">
      <div class="rounded-xl border border-border bg-card p-4 text-center animate-pulse"><div class="h-6 w-12 bg-muted mx-auto rounded"></div></div>
      <div class="rounded-xl border border-border bg-card p-4 text-center animate-pulse"><div class="h-6 w-12 bg-muted mx-auto rounded"></div></div>
      <div class="rounded-xl border border-border bg-card p-4 text-center animate-pulse"><div class="h-6 w-12 bg-muted mx-auto rounded"></div></div>
      <div class="rounded-xl border border-border bg-card p-4 text-center animate-pulse"><div class="h-6 w-12 bg-muted mx-auto rounded"></div></div>
      <div class="rounded-xl border border-border bg-card p-4 text-center animate-pulse"><div class="h-6 w-12 bg-muted mx-auto rounded"></div></div>
      <div class="rounded-xl border border-border bg-card p-4 text-center animate-pulse"><div class="h-6 w-12 bg-muted mx-auto rounded"></div></div>
      <div class="rounded-xl border border-border bg-card p-4 text-center animate-pulse"><div class="h-6 w-12 bg-muted mx-auto rounded"></div></div>
      <div class="rounded-xl border border-border bg-card p-4 text-center animate-pulse"><div class="h-6 w-12 bg-muted mx-auto rounded"></div></div>
    </div>
  </div>

  <!-- Webhook Orchestration Summary -->
  <div class="mb-8 rounded-2xl border border-border bg-card p-5 shadow-sm space-y-4 flex flex-col justify-between">
    <div class="space-y-4">
      <div class="flex items-center justify-between border-b border-border pb-3">
        <div class="flex items-center gap-2">
          <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-primary/10 text-primary">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
          </div>
          <div>
            <h3 class="text-sm font-bold text-foreground">Webhook Orchestration Summary</h3>
            <p class="text-xs text-muted-foreground">Channel capacities & fallback priority routing</p>
          </div>
        </div>
        <button
          id="open-webhooks-modal-btn"
          class="inline-flex items-center gap-1 rounded-lg border border-primary/30 bg-primary/10 px-2.5 py-1.5 text-xs font-semibold text-primary hover:bg-primary hover:text-primary-foreground transition-all"
        >
          <span>Manage Webhooks &rarr;</span>
        </button>
      </div>

      <div id="webhook-summary-container" class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <div class="p-3 rounded-xl border border-border bg-background space-y-1">
          <span class="text-[11px] font-medium text-muted-foreground">Channels Status</span>
          <p id="wh-sum-channels" class="text-xs font-bold text-foreground">Loading...</p>
        </div>
        <div class="p-3 rounded-xl border border-border bg-background space-y-1">
          <span class="text-[11px] font-medium text-muted-foreground">Primary Webhook</span>
          <p id="wh-sum-primary" class="text-xs font-bold text-foreground">Loading...</p>
        </div>
        <div class="col-span-1 sm:col-span-2 p-3 rounded-xl border border-border bg-background space-y-1">
          <div class="flex items-center justify-between text-[11px] font-medium text-muted-foreground">
            <span>Combined Active Remaining Capacity</span>
            <span id="wh-sum-capacity-count" class="font-bold text-foreground">---</span>
          </div>
          <div class="h-2 w-full rounded-full bg-muted overflow-hidden">
            <div id="wh-sum-capacity-bar" class="h-full rounded-full bg-primary transition-all duration-300" style="width: 0%"></div>
          </div>
        </div>
      </div>
    </div>

    <div class="pt-3 border-t border-border flex items-center justify-between">
      <span class="text-[11px] text-muted-foreground font-medium">Server-to-Server Health</span>
      <button id="btn-test-webhook-ping" class="inline-flex items-center gap-1 rounded-lg border border-border bg-background px-2.5 py-1 text-xs font-semibold text-foreground hover:bg-muted transition-all">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 text-emerald-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
        <span>⚡ Test Webhook Ping</span>
      </button>
    </div>
  </div>

  <!-- Section: Posting Schedules & Automation -->
  <div class="mb-8 rounded-2xl border border-border bg-card p-5 shadow-sm space-y-4">
    <div class="flex flex-wrap items-center justify-between border-b border-border pb-3 gap-3">
      <div class="flex items-center gap-2">
        <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-pink-500/10 text-pink-500">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
        </div>
        <div>
          <div class="flex items-center gap-2">
            <h3 class="text-sm font-bold text-foreground">Posting Schedules & Automation</h3>
            <span id="sched-live-status" class="inline-flex items-center gap-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/30 px-2.5 py-0.5 text-[11px] font-bold text-emerald-600 dark:text-emerald-400">
              <span class="h-1.5 w-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
              <span>Window Active</span>
            </span>
            <span id="sched-next-countdown" class="inline-flex items-center gap-1 rounded-full bg-primary/10 border border-primary/20 px-2.5 py-0.5 text-[11px] font-semibold text-primary">
              Next Pin: ~2 mins
            </span>
          </div>
          <p class="text-xs text-muted-foreground">Manage posting schedules for this account</p>
        </div>
      </div>
      <div class="flex flex-wrap items-center gap-2">
        <button id="btn-add-schedule" class="inline-flex items-center gap-1 rounded-lg border border-border bg-background px-2.5 py-1.5 text-xs font-semibold text-foreground hover:bg-muted transition-all">+ Add Posting Schedule</button>
        <button id="btn-convert-legacy" class="inline-flex items-center gap-1 rounded-lg border border-primary/30 bg-primary/10 px-2.5 py-1.5 text-xs font-semibold text-primary hover:bg-primary/20 transition-all">Convert current schedule</button>
        <button id="btn-sync-missing" class="inline-flex items-center gap-1 rounded-lg border border-border bg-background px-2.5 py-1.5 text-xs font-semibold text-foreground hover:bg-muted transition-all">Sync Missing</button>
        <button id="btn-refresh-schedules" class="inline-flex items-center gap-1 rounded-lg border border-border bg-background px-2.5 py-1.5 text-xs font-semibold text-foreground hover:bg-muted transition-all">Refresh</button>
      </div>
    </div>

    <div id="sched-pace-analyzer-box" class="p-3.5 rounded-xl border border-primary/20 bg-primary/5 space-y-1">
      <div class="flex items-center justify-between text-xs">
        <span class="font-bold text-primary flex items-center gap-1.5">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
          <span>Cadence & Daily Limit Pacing Analyzer</span>
        </span>
        <span id="sched-pace-val" class="font-bold text-foreground">Calculating pacing...</span>
      </div>
      <p id="sched-pace-desc" class="text-[11px] text-muted-foreground">Pacing is optimized to distribute posts evenly across your configured posting window.</p>
    </div>

    <table class="w-full text-xs border">
      <thead>
        <tr class="text-left border-b">
          <th class="p-2">Label</th>
          <th class="p-2">Channel</th>
          <th class="p-2">Window/TZ</th>
          <th class="p-2">Interval/Delay</th>
          <th class="p-2">Days</th>
          <th class="p-2">Status</th>
          <th class="p-2">Actions</th>
        </tr>
      </thead>
      <tbody id="account-schedules-rows"></tbody>
    </table>
  </div>

  <!-- MODAL: Add/Edit Schedule -->
  <dialog id="schedule-modal" class="rounded p-0 w-[480px] max-w-full">
    <form id="schedule-form" class="p-4 space-y-3 text-sm">
      <h2 id="schedule-modal-title" class="text-lg font-bold">Add Posting Schedule</h2>
      <input type="hidden" id="f-sched-id" />
      <label class="block">Label<input id="f-sched-label" class="border rounded w-full p-2" /></label>
      <label class="block">
        FastCron API Token (Write-Only Override)
        <input id="f-fc-token" type="password" class="border rounded w-full p-2" placeholder="Leave empty for default" autocomplete="off" />
      </label>
      <div id="fc-token-status" class="text-xs text-muted-foreground"></div>
      <label class="block">Channel<select id="f-channel" class="border rounded w-full p-2"></select></label>
      <div class="grid grid-cols-2 gap-2">
        <label class="block">Timezone<input id="f-sched-tz" class="border rounded w-full p-2" value="UTC" /></label>
        <label class="block">Batch<input id="f-sched-batch" type="number" min="1" max="10" class="border rounded w-full p-2" value="1" /></label>
        <label class="block">Window start<input id="f-sched-start" type="time" class="border rounded w-full p-2" value="09:00" /></label>
        <label class="block">Window end<input id="f-sched-end" type="time" class="border rounded w-full p-2" value="21:00" /></label>
        <label class="block">Interval (min)<input id="f-sched-interval" type="number" min="1" max="1440" class="border rounded w-full p-2" value="36" /></label>
        <label class="block">Random delay (min)<input id="f-sched-delay" type="number" min="0" max="60" class="border rounded w-full p-2" value="0" /></label>
      </div>
      <label class="block">Active days (comma separated)<input id="f-sched-days" class="border rounded w-full p-2" value="Mon,Tue,Wed,Thu,Fri,Sat,Sun" /></label>
      <label class="block">Pinning started (optional)<input id="f-sched-started" type="date" class="border rounded w-full p-2" /></label>
      <p id="sched-cadence" class="text-pink-600 text-xs"></p>
      <div class="flex justify-end gap-2">
        <button type="button" id="btn-cancel-sched" class="px-3 py-1 border rounded">Cancel</button>
        <button type="submit" class="px-3 py-1 rounded bg-pink-600 text-white">Save</button>
      </div>
    </form>
  </dialog>

  <!-- Section 4: Recent Account Pins Queue -->
  <div class="mb-8 space-y-3">
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-2">
        <h3 class="text-sm font-bold text-foreground tracking-wide uppercase">Recent Account Pins Queue</h3>
        <span id="pin-queue-count-badge" class="rounded-full bg-primary/10 px-2 py-0.5 text-[11px] font-semibold text-primary">0</span>
      </div>
      <a id="view-all-pins-link" href="/accounts/pins?id=acc-1" class="text-xs font-semibold text-primary hover:underline flex items-center gap-1">
        <span>View all pins</span>
        <span>&rarr;</span>
      </a>
    </div>

    <!-- Compact Inline Filter Bar -->
    <div class="rounded-xl border border-border bg-card p-3 shadow-sm">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-2.5 text-xs">
        <div class="flex flex-wrap items-center gap-2 flex-1">
          <!-- Search Input -->
          <div class="relative flex-1 min-w-[160px] max-w-xs">
            <svg xmlns="http://www.w3.org/2000/svg" class="absolute left-2.5 top-1/2 h-3.5 w-3.5 -translate-y-1/2 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <input
              id="pin-search-input"
              type="text"
              placeholder="Search pin title..."
              class="w-full rounded-lg border border-border bg-background py-1.5 pl-8 pr-2 text-xs text-foreground placeholder:text-muted-foreground focus:border-primary focus:outline-none"
            />
          </div>

          <!-- Status Dropdown -->
          <select id="pin-status-select" class="rounded-lg border border-border bg-background py-1.5 px-2.5 text-xs text-foreground focus:border-primary focus:outline-none">
            <option value="all">All Statuses</option>
            <option value="pending">Pending</option>
            <option value="retrying">Retrying</option>
            <option value="posted">Posted</option>
            <option value="failed">Failed</option>
            <option value="processing">Processing</option>
          </select>

          <!-- Board Dropdown -->
          <select id="pin-board-select" class="rounded-lg border border-border bg-background py-1.5 px-2.5 text-xs text-foreground focus:border-primary focus:outline-none max-w-[160px]">
            <option value="all">All Boards</option>
          </select>

          <!-- Date Range -->
          <div class="flex items-center gap-1">
            <input id="pin-date-from" type="date" title="From date" class="rounded-lg border border-border bg-background py-1.5 px-2 text-xs text-foreground focus:border-primary focus:outline-none" />
            <span class="text-muted-foreground text-[10px]">-</span>
            <input id="pin-date-to" type="date" title="To date" class="rounded-lg border border-border bg-background py-1.5 px-2 text-xs text-foreground focus:border-primary focus:outline-none" />
          </div>

          <!-- Clear Filters -->
          <button id="pin-clear-filters-btn" class="hidden rounded-lg border border-border bg-muted/50 px-2.5 py-1.5 text-xs font-medium text-muted-foreground hover:bg-muted hover:text-foreground transition-all">
            Clear filters
          </button>
        </div>

        <!-- Showing Count -->
        <div id="pin-result-count" class="text-xs text-muted-foreground font-medium whitespace-nowrap">
          Showing 0 pins
        </div>
      </div>
    </div>

    <div id="account-pins-container">
      <div class="overflow-hidden rounded-xl border border-border bg-card p-6 text-center text-xs text-muted-foreground animate-pulse">
        Loading account pins history...
      </div>
    </div>
  </div>

  <!-- Section 5: Recent Account Execution Logs -->
  <div class="mb-8 space-y-3">
    <div class="flex items-center justify-between">
      <h3 class="text-sm font-bold text-foreground tracking-wide uppercase">Recent Execution Logs & Errors</h3>
      <a href="/logs" class="text-xs font-semibold text-primary hover:underline">View all system logs &rarr;</a>
    </div>

    <div id="account-logs-container">
      <div class="overflow-hidden rounded-xl border border-border bg-card p-6 text-center text-xs text-muted-foreground animate-pulse">
        Loading account activity logs...
      </div>
    </div>
  </div>



  <!-- MODAL: Edit Daily Limit -->
  <div id="edit-limit-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60 backdrop-blur-sm p-4" aria-modal="true" role="dialog">
    <div id="edit-limit-backdrop" class="fixed inset-0"></div>
    <div class="relative w-full max-w-md rounded-2xl border border-border bg-card p-6 shadow-2xl space-y-4 z-10">
      <div class="flex items-center justify-between border-b border-border pb-3">
        <h3 class="text-base font-bold text-foreground">Edit Account Daily Limit</h3>
        <button id="close-limit-btn" class="rounded-lg p-1 text-muted-foreground hover:bg-muted hover:text-foreground">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>

      <form id="limit-form" class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-muted-foreground mb-1">Max Pins Per Day</label>
          <input id="limit-input-num" type="number" min="1" required class="w-full rounded-xl border border-border bg-background py-2 px-3 text-xs text-foreground focus:border-primary focus:outline-none" />
        </div>

        <div class="flex items-center justify-end gap-3 border-t border-border pt-4">
          <button type="button" id="cancel-limit-btn" class="rounded-xl border border-border px-4 py-2 text-xs font-medium text-muted-foreground hover:bg-muted hover:text-foreground">
            Cancel
          </button>
          <button type="submit" class="rounded-xl bg-primary px-4 py-2 text-xs font-semibold text-primary-foreground shadow hover:bg-primary/90">
            Save Limit
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- MODAL: Multi-Webhook Orchestration -->
  <div id="webhooks-manage-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60 backdrop-blur-sm p-4" aria-modal="true" role="dialog">
    <div id="webhooks-manage-backdrop" class="fixed inset-0"></div>
    <div class="relative w-full max-w-3xl rounded-2xl border border-border bg-card p-6 shadow-2xl space-y-5 z-10 max-h-[90vh] flex flex-col">
      <!-- Modal Header -->
      <div class="flex items-center justify-between border-b border-border pb-4 flex-shrink-0">
        <div>
          <h3 class="text-base font-bold text-foreground">Multi-Webhook Orchestration</h3>
          <p id="manage-webhooks-subtitle" class="text-xs text-muted-foreground mt-0.5">Managing webhooks for account...</p>
        </div>
        <div class="flex items-center gap-2">
          <button
            id="open-add-webhook-btn"
            class="inline-flex items-center gap-1.5 rounded-xl bg-primary px-3 py-1.5 text-xs font-semibold text-primary-foreground shadow hover:bg-primary/90 transition-all"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            <span>+ Add Webhook</span>
          </button>
          <button id="close-webhooks-modal" class="rounded-lg p-1 text-muted-foreground hover:bg-muted hover:text-foreground">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          </button>
        </div>
      </div>

      <div id="webhooks-modal-error" class="hidden rounded-xl border border-rose-500/30 bg-rose-500/10 p-3 text-xs text-rose-500 flex-shrink-0"></div>
      <div id="webhooks-modal-success" class="hidden rounded-xl border border-emerald-500/30 bg-emerald-500/10 p-3 text-xs text-emerald-600 dark:text-emerald-400 flex-shrink-0"></div>

      <!-- Webhook List Container -->
      <div id="webhooks-list-container" class="flex-1 overflow-y-auto space-y-3 pr-1">
        <div class="p-8 text-center text-xs text-muted-foreground animate-pulse">
          Loading account webhooks...
        </div>
      </div>

      <!-- In-Modal Add/Edit Form (Hidden by default) -->
      <div id="webhook-form-container" class="hidden rounded-xl border border-border bg-muted/40 p-4 space-y-4 flex-shrink-0">
        <h4 id="webhook-form-title" class="text-xs font-bold text-foreground uppercase tracking-wider">Add New Webhook Channel</h4>
        <input type="hidden" id="form-webhook-id" />

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="space-y-1">
            <label for="form-hook-label" class="block text-[11px] font-semibold text-foreground">Channel Label *</label>
            <input
              id="form-hook-label"
              type="text"
              required
              placeholder="e.g. Channel B - Make #2"
              class="w-full rounded-lg border border-border bg-background py-1.5 px-3 text-xs text-foreground placeholder:text-muted-foreground focus:border-primary focus:outline-none"
            />
          </div>

          <div class="space-y-1">
            <label for="form-hook-url" class="block text-[11px] font-semibold text-foreground">Make.com Webhook URL *</label>
            <input
              id="form-hook-url"
              type="url"
              required
              placeholder="https://hook.make.com/abc456channel2"
              class="w-full rounded-lg border border-border bg-background py-1.5 px-3 text-xs text-foreground placeholder:text-muted-foreground focus:border-primary focus:outline-none"
            />
          </div>

          <div class="space-y-1">
            <label for="form-hook-capacity" class="block text-[11px] font-semibold text-foreground">Monthly Capacity *</label>
            <input
              id="form-hook-capacity"
              type="number"
              min="1"
              value="500"
              required
              class="w-full rounded-lg border border-border bg-background py-1.5 px-3 text-xs text-foreground focus:border-primary focus:outline-none"
            />
          </div>

          <div class="space-y-1">
            <label for="form-hook-priority" class="block text-[11px] font-semibold text-foreground">Routing Priority (1 = Highest) *</label>
            <input
              id="form-hook-priority"
              type="number"
              min="1"
              value="1"
              required
              class="w-full rounded-lg border border-border bg-background py-1.5 px-3 text-xs text-foreground focus:border-primary focus:outline-none"
            />
          </div>
        </div>

        <div class="flex items-center gap-6 pt-1">
          <label class="flex items-center gap-2 cursor-pointer text-xs font-medium text-foreground">
            <input id="form-hook-active" type="checkbox" checked class="h-4 w-4 rounded border-border text-primary" />
            <span>Active</span>
          </label>
          <label class="flex items-center gap-2 cursor-pointer text-xs font-medium text-foreground">
            <input id="form-hook-primary" type="checkbox" class="h-4 w-4 rounded border-border text-primary" />
            <span>Set as Primary Webhook</span>
          </label>
        </div>

        <div class="flex items-center justify-end gap-2 pt-2 border-t border-border">
          <button
            type="button"
            id="cancel-webhook-form"
            class="rounded-lg border border-border px-3 py-1.5 text-xs font-medium text-muted-foreground hover:bg-muted hover:text-foreground"
          >
            Cancel
          </button>
          <button
            type="button"
            id="submit-webhook-form"
            class="rounded-lg bg-primary px-3 py-1.5 text-xs font-semibold text-primary-foreground shadow hover:bg-primary/90"
          >
            Save Webhook
          </button>
        </div>
      </div>

      <div class="flex items-center justify-end border-t border-border pt-3 flex-shrink-0">
        <button
          type="button"
          id="dismiss-webhooks-modal"
          class="rounded-xl border border-border px-4 py-2 text-xs font-semibold text-foreground hover:bg-muted"
        >
          Done
        </button>
      </div>
    </div>
  </div>

  <!-- MODAL: Create Pinterest Board -->
  <div id="create-board-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60 backdrop-blur-sm p-4" aria-modal="true" role="dialog">
    <div class="relative w-full max-w-md rounded-2xl border border-border bg-card shadow-2xl z-10 overflow-hidden">
      <!-- Header -->
      <div class="flex items-center justify-between px-6 py-4 border-b border-border">
        <div class="flex items-center gap-3">
          <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-primary/10 text-primary">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
          </div>
          <div>
            <h3 class="text-sm font-bold text-foreground">Create Pinterest Board</h3>
            <p class="text-[11px] text-muted-foreground">Add a new board and link it to this account</p>
          </div>
        </div>
        <button id="close-create-board-modal" class="rounded-lg p-1.5 text-muted-foreground hover:bg-muted hover:text-foreground transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>

      <!-- Body -->
      <form id="create-board-form" class="px-6 py-5 space-y-4">
        <!-- Board Name -->
        <div class="space-y-1.5">
          <label for="new-board-name-input" class="block text-xs font-semibold text-foreground">Pinterest Board Name <span class="text-primary">*</span></label>
          <input
            id="new-board-name-input"
            type="text"
            required
            autocomplete="off"
            placeholder="e.g. Quick Dinner Recipes"
            class="w-full rounded-xl border border-border bg-background py-2.5 px-3.5 text-sm text-foreground placeholder:text-muted-foreground focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20 transition"
          />
        </div>

        <!-- Webhook Channel -->
        <div class="space-y-1.5">
          <label for="new-board-webhook-select" class="block text-xs font-semibold text-foreground">Webhook Channel <span class="text-primary">*</span></label>
          <!-- Loading skeleton shown while fetching -->
          <div id="create-board-webhook-loading" class="hidden w-full rounded-xl border border-border bg-muted/40 py-2.5 px-3.5 text-xs text-muted-foreground animate-pulse">
            Loading webhook channels...
          </div>
          <select
            id="new-board-webhook-select"
            class="w-full rounded-xl border border-border bg-background py-2.5 px-3.5 text-xs font-medium text-foreground focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20 transition"
          >
            <option value="" disabled selected>Select a channel...</option>
          </select>
        </div>

        <!-- Feedback banners -->
        <div id="create-board-error" class="hidden rounded-xl bg-rose-500/10 border border-rose-500/30 px-3.5 py-3 text-xs text-rose-600 dark:text-rose-400 flex items-start gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 flex-shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          <span id="create-board-error-text"></span>
        </div>
        <div id="create-board-success" class="hidden rounded-xl bg-emerald-500/10 border border-emerald-500/30 px-3.5 py-3 text-xs text-emerald-600 dark:text-emerald-400 flex items-start gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 flex-shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          <span id="create-board-success-text"></span>
        </div>
        <div id="create-board-reused" class="hidden rounded-xl bg-amber-500/10 border border-amber-500/30 px-3.5 py-3 text-xs text-amber-600 dark:text-amber-400 flex items-start gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 flex-shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
          <span id="create-board-reused-text"></span>
        </div>

        <!-- Footer -->
        <div class="flex items-center justify-end gap-2 pt-2 border-t border-border">
          <button
            type="button"
            id="cancel-create-board-btn"
            class="rounded-xl border border-border px-4 py-2 text-xs font-semibold text-muted-foreground hover:bg-muted hover:text-foreground transition-colors"
          >
            Cancel
          </button>
          <button
            type="submit"
            id="submit-create-board-btn"
            class="inline-flex items-center gap-2 rounded-xl bg-primary px-4 py-2 text-xs font-semibold text-primary-foreground hover:bg-primary/90 shadow transition-colors disabled:opacity-60 disabled:cursor-not-allowed"
          >
            <svg id="create-board-spinner" class="hidden h-3.5 w-3.5 animate-spin" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/></svg>
            <span id="create-board-btn-label">Create Board</span>
          </button>
        </div>
      </form>
    </div>
  </div>
</Layout>

<script>
  import { requireAuth } from '../../lib/auth';
  import {
    getAccountDetails,
    getAccountPinStats,
    getAccountPins,
    getAccountBoards,
    getAccountRecentLogs,
    getAccountWebhookSummary,
    getAccountWebhooks,
    createAccountWebhook,
    updateAccountWebhook,
    toggleAccountWebhookActive,
    setPrimaryWebhook,
    updateAccountSchedule,
    updateAccountScheduling,
    updateAccountDailyLimit,
    toggleAccountActive,
    createBoardViaWebhook,
    rescheduleAccountPendingPins,
  } from '../../lib/supabase';
  import { renderStatusBadge, formatDate, formatTime, renderEmptyStateHTML, escapeHtml } from '../../lib/ui-helpers';
  import type { Account, AccountPinStats, Pin, Log, AccountWebhook, Board } from '../../lib/types';

  let currentAccount: Account | null = null;
  let currentStats: AccountPinStats | null = null;
  let accountId: string = '';
  let activeAccountWebhooks: AccountWebhook[] = [];
  let accountBoards: Board[] = [];

  // ── Shared Helpers ──────────────────────────────────────────────────────────

  /** Parse Postgres TEXT[] or JS string[] into a clean JS string array */
  function parseActiveDays(raw: string | string[] | null | undefined): string[] {
    const all = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];
    if (!raw) return all;
    if (Array.isArray(raw)) return raw;
    return (raw as string).replace(/[{}"']/g, '').split(',').map((d) => d.trim()).filter(Boolean);
  }

  /** Compute posting window duration in minutes (handles overnight wrap-around) */
  function calcWindowMins(start: string, end: string): number {
    const [sH, sM] = (start || '09:00').slice(0, 5).split(':').map(Number);
    const [eH, eM] = (end   || '21:00').slice(0, 5).split(':').map(Number);
    let mins = (eH * 60 + eM) - (sH * 60 + sM);
    if (mins <= 0) mins += 1440;
    return mins;
  }

  // Filter State
  let filterStatus = 'all';
  let filterBoard = 'all';
  let filterSearch = '';
  let filterDateFrom = '';
  let filterDateTo = '';
  let searchDebounceTimer: any = null;

  async function init() {
    const isAuth = await requireAuth();
    if (!isAuth) return;

    // Extract Account ID from URL query string or path
    const urlParams = new URLSearchParams(window.location.search);
    const queryId = urlParams.get('id');
    let pathId = '';
    const matches = window.location.pathname.match(/\/accounts\/([^/]+)/);
    if (matches && matches[1] && matches[1] !== 'pins' && matches[1] !== 'details') {
      pathId = matches[1];
    }

    accountId = queryId || pathId || 'acc-1';

    const displayElem = document.getElementById('display-account-id');
    if (displayElem) displayElem.textContent = accountId || '---';

    if (!accountId) return;

    // Update "View all pins" link to dedicated route
    const viewAllLink = document.getElementById('view-all-pins-link') as HTMLAnchorElement;
    if (viewAllLink && accountId) {
      viewAllLink.href = `/accounts/pins?id=${accountId}`;
    }

    // Read initial filters from URL params
    filterStatus = urlParams.get('status') || 'all';
    filterBoard = urlParams.get('board') || 'all';
    filterSearch = urlParams.get('q') || '';
    filterDateFrom = urlParams.get('from') || '';
    filterDateTo = urlParams.get('to') || '';

    // Initialize UI inputs from state
    initFilterInputs();
    setupFilterListeners();
    setupModalListeners();

    await loadAllData();
  }

  function initFilterInputs() {
    const statusSelect = document.getElementById('pin-status-select') as HTMLSelectElement;
    const searchInput = document.getElementById('pin-search-input') as HTMLInputElement;
    const dateFromInput = document.getElementById('pin-date-from') as HTMLInputElement;
    const dateToInput = document.getElementById('pin-date-to') as HTMLInputElement;

    if (statusSelect) statusSelect.value = filterStatus;
    if (searchInput) searchInput.value = filterSearch;
    if (dateFromInput) dateFromInput.value = filterDateFrom;
    if (dateToInput) dateToInput.value = filterDateTo;
  }

  function setupFilterListeners() {
    const statusSelect = document.getElementById('pin-status-select');
    const boardSelect = document.getElementById('pin-board-select');
    const searchInput = document.getElementById('pin-search-input');
    const dateFromInput = document.getElementById('pin-date-from');
    const dateToInput = document.getElementById('pin-date-to');
    const clearBtn = document.getElementById('pin-clear-filters-btn');

    statusSelect?.addEventListener('change', (e) => {
      filterStatus = (e.target as HTMLSelectElement).value;
      onFilterChange();
    });

    boardSelect?.addEventListener('change', (e) => {
      filterBoard = (e.target as HTMLSelectElement).value;
      onFilterChange();
    });

    searchInput?.addEventListener('input', (e) => {
      filterSearch = (e.target as HTMLInputElement).value;
      clearTimeout(searchDebounceTimer);
      searchDebounceTimer = setTimeout(() => {
        onFilterChange();
      }, 300);
    });

    dateFromInput?.addEventListener('change', (e) => {
      filterDateFrom = (e.target as HTMLInputElement).value;
      onFilterChange();
    });

    dateToInput?.addEventListener('change', (e) => {
      filterDateTo = (e.target as HTMLInputElement).value;
      onFilterChange();
    });

    clearBtn?.addEventListener('click', () => {
      filterStatus = 'all';
      filterBoard = 'all';
      filterSearch = '';
      filterDateFrom = '';
      filterDateTo = '';
      initFilterInputs();
      const boardSel = document.getElementById('pin-board-select') as HTMLSelectElement;
      if (boardSel) boardSel.value = 'all';
      onFilterChange();
    });
  }

  function syncFilterStateToURL() {
    const url = new URL(window.location.href);
    if (filterStatus && filterStatus !== 'all') url.searchParams.set('status', filterStatus);
    else url.searchParams.delete('status');

    if (filterBoard && filterBoard !== 'all') url.searchParams.set('board', filterBoard);
    else url.searchParams.delete('board');

    if (filterSearch && filterSearch.trim() !== '') url.searchParams.set('q', filterSearch.trim());
    else url.searchParams.delete('q');

    if (filterDateFrom) url.searchParams.set('from', filterDateFrom);
    else url.searchParams.delete('from');

    if (filterDateTo) url.searchParams.set('to', filterDateTo);
    else url.searchParams.delete('to');

    window.history.replaceState({}, '', url.toString());

    // Toggle clear filters button visibility
    const clearBtn = document.getElementById('pin-clear-filters-btn');
    const isFiltered = filterStatus !== 'all' || filterBoard !== 'all' || filterSearch !== '' || filterDateFrom !== '' || filterDateTo !== '';
    if (clearBtn) {
      if (isFiltered) clearBtn.classList.remove('hidden');
      else clearBtn.classList.add('hidden');
    }
  }

  async function onFilterChange() {
    syncFilterStateToURL();
    await loadRecentPins();
  }

  async function loadAllData() {
    try {
      const [acc, stats, boards, logs, whSummary] = await Promise.all([
        getAccountDetails(accountId),
        getAccountPinStats(accountId),
        getAccountBoards(accountId),
        getAccountRecentLogs(accountId, 10),
        getAccountWebhookSummary(accountId),
      ]);

      const whs = await getAccountWebhooks(accountId);
      activeAccountWebhooks = (whs || []).filter((w: any) => w.is_active);
      setupSchedulesListeners();
      await loadSchedules();

      if (!acc) {
        document.getElementById('account-header-info')!.innerHTML = renderEmptyStateHTML(
          'Account Not Found',
          `Could not locate Pinterest account matching ID "${escapeHtml(accountId)}".`,
          'alert-circle'
        );
        return;
      }

      // Fresh DB data wins; preserve local-only fields that DB may not return
      currentAccount = {
        ...(currentAccount || {}),
        ...acc,
      };
      currentStats = stats;
      accountBoards = boards;

      populateBoardDropdown(boards);
      renderHeader(currentAccount);
      renderKPIs(stats, currentAccount);
      renderScheduling(currentAccount);
      renderWebhookSummary(whSummary);
      renderRecentLogs(logs);

      // Auto-reschedule pending pins to pre-computed pacing slots
      await rescheduleAccountPendingPins(accountId);

      await loadRecentPins();
    } catch (err) {
      console.error('Error loading account details:', err);
    }
  }

  function populateBoardDropdown(boards: Board[]) {
    const boardSelect = document.getElementById('pin-board-select') as HTMLSelectElement;
    if (!boardSelect) return;

    boardSelect.innerHTML = `<option value="all">All Boards</option>` +
      boards.map((b) => `<option value="${escapeHtml(b.board_name)}">${escapeHtml(b.board_name)}</option>`).join('');

    if (filterBoard) {
      boardSelect.value = filterBoard;
    }
  }

  async function loadRecentPins() {
    const res = await getAccountPins({
      accountId,
      status: filterStatus,
      boardId: filterBoard,
      search: filterSearch,
      dateFrom: filterDateFrom,
      dateTo: filterDateTo,
      page: 1,
      pageSize: 10,
      sortBy: 'created_at',
      sortDir: 'desc',
    });

    renderRecentPins(res.pins, res.totalCount);
  }

  function renderPinStatusBadgeWithRetry(pin: Pin) {
    if (pin.status === 'posted') {
      return `<span class="inline-flex items-center rounded-full bg-emerald-500/10 border border-emerald-500/20 px-2 py-0.5 text-[11px] font-semibold text-emerald-600 dark:text-emerald-400">Posted</span>`;
    }
    if (pin.status === 'processing') {
      return `<span class="inline-flex items-center rounded-full bg-blue-500/10 border border-blue-500/20 px-2 py-0.5 text-[11px] font-semibold text-blue-500">Processing</span>`;
    }
    if (pin.status === 'pending' && (pin.retry_count || 0) > 0) {
      let retryCountdownText = '';
      if (pin.next_retry_at) {
        const diffMs = new Date(pin.next_retry_at).getTime() - Date.now();
        if (diffMs > 0) {
          const mins = Math.max(1, Math.round(diffMs / 60000));
          retryCountdownText = ` (${mins}m)`;
        }
      }
      return `<span class="inline-flex items-center gap-1 rounded-full bg-amber-500/10 border border-amber-500/30 px-2 py-0.5 text-[11px] font-semibold text-amber-600 dark:text-amber-400" title="${escapeHtml(pin.last_failure_reason || 'Retrying soon')}">
        <span>Retrying${retryCountdownText}</span>
      </span>`;
    }
    if (pin.status === 'pending') {
      return `<span class="inline-flex items-center rounded-full bg-amber-500/10 border border-amber-500/20 px-2 py-0.5 text-[11px] font-semibold text-amber-600 dark:text-amber-400">Pending</span>`;
    }
    if (pin.status === 'failed') {
      return `<span class="inline-flex items-center rounded-full bg-rose-500/10 border border-rose-500/20 px-2 py-0.5 text-[11px] font-semibold text-rose-500 cursor-help" title="${escapeHtml(pin.last_failure_reason || 'Execution failed')}">Failed</span>`;
    }
    return renderStatusBadge(pin.status);
  }

  function renderKPIs(stats: AccountPinStats, acc: Account) {
    const container = document.getElementById('kpis-grid-container');
    if (!container) return;

    container.innerHTML = `
      <div class="rounded-xl border border-border bg-card p-3 text-center space-y-1">
        <span class="text-[11px] font-semibold text-muted-foreground">Total Posts</span>
        <p class="text-xl font-bold text-foreground">${stats.total}</p>
      </div>
      <div class="rounded-xl border border-amber-500/20 bg-amber-500/5 p-3 text-center space-y-1">
        <span class="text-[11px] font-semibold text-amber-600 dark:text-amber-400">Pending</span>
        <p class="text-xl font-bold text-amber-600 dark:text-amber-400">${stats.pending}</p>
      </div>
      <div class="rounded-xl border border-amber-500/30 bg-amber-500/10 p-3 text-center space-y-1">
        <span class="text-[11px] font-semibold text-amber-600 dark:text-amber-400">Retrying</span>
        <p class="text-xl font-bold text-amber-600 dark:text-amber-400">${stats.retrying || 0}</p>
      </div>
      <div class="rounded-xl border border-emerald-500/20 bg-emerald-500/5 p-3 text-center space-y-1">
        <span class="text-[11px] font-semibold text-emerald-600 dark:text-emerald-400">Posted</span>
        <p class="text-xl font-bold text-emerald-600 dark:text-emerald-400">${stats.posted}</p>
      </div>
      <div class="rounded-xl border border-rose-500/20 bg-rose-500/5 p-3 text-center space-y-1">
