---
import Layout from '../../layouts/Layout.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import KPIStatCard from '../../components/ui/KPIStatCard.astro';
import { getAccounts } from '../../lib/supabase';

export async function getStaticPaths() {
  const accounts = await getAccounts();
  const fallbackIds = ['acc-1', 'acc-2', 'acc-3'];
  const fetchedIds = (accounts || []).map((a) => a.id);
  const allIds = Array.from(new Set([...fallbackIds, ...fetchedIds]));

  return allIds.map((id) => ({
    params: { id },
  }));
}

const { id } = Astro.params;
---

<Layout title="Manage Account Details" description="Detailed operational, scheduling, and activity control center for Pinterest account.">
  <!-- Back Link & Breadcrumb -->
  <div class="mb-4 flex items-center justify-between">
    <a href="/accounts" class="inline-flex items-center gap-1.5 text-xs font-semibold text-muted-foreground hover:text-foreground transition-all">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
      <span>&larr; Back to Accounts</span>
    </a>
    <span class="text-xs text-muted-foreground font-mono">Account ID: <span id="display-account-id">${id}</span></span>
  </div>

  <!-- Global Feedback Banner -->
  <div id="account-feedback-banner" class="hidden mb-4 rounded-xl border border-emerald-500/30 bg-emerald-500/10 p-3.5 text-xs text-emerald-600 dark:text-emerald-400 flex items-center justify-between shadow-sm">
    <div class="flex items-center gap-2.5">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>
      </svg>
      <span id="account-feedback-text">Account updated successfully.</span>
    </div>
    <button id="close-account-feedback" class="font-bold opacity-70 hover:opacity-100">&times;</button>
  </div>

  <!-- Header Control Card -->
  <div id="account-header-container" class="mb-6 rounded-2xl border border-border bg-card p-6 shadow-sm">
    <div class="animate-pulse flex flex-col md:flex-row md:items-center md:justify-between gap-4">
      <div class="h-8 w-48 rounded-lg bg-muted"></div>
      <div class="h-9 w-64 rounded-lg bg-muted"></div>
    </div>
  </div>

  <!-- Section 1: Overview KPI Cards (8 Grid Items) -->
  <div class="mb-8 space-y-3">
    <h3 class="text-sm font-bold text-foreground tracking-wide uppercase">Operational Overview & Metrics</h3>
    <div id="kpis-grid-container" class="grid grid-cols-2 gap-3 sm:grid-cols-4 lg:grid-cols-8">
      <div class="rounded-xl border border-border bg-card p-4 text-center animate-pulse"><div class="h-6 w-12 bg-muted mx-auto rounded"></div></div>
      <div class="rounded-xl border border-border bg-card p-4 text-center animate-pulse"><div class="h-6 w-12 bg-muted mx-auto rounded"></div></div>
      <div class="rounded-xl border border-border bg-card p-4 text-center animate-pulse"><div class="h-6 w-12 bg-muted mx-auto rounded"></div></div>
      <div class="rounded-xl border border-border bg-card p-4 text-center animate-pulse"><div class="h-6 w-12 bg-muted mx-auto rounded"></div></div>
      <div class="rounded-xl border border-border bg-card p-4 text-center animate-pulse"><div class="h-6 w-12 bg-muted mx-auto rounded"></div></div>
      <div class="rounded-xl border border-border bg-card p-4 text-center animate-pulse"><div class="h-6 w-12 bg-muted mx-auto rounded"></div></div>
      <div class="rounded-xl border border-border bg-card p-4 text-center animate-pulse"><div class="h-6 w-12 bg-muted mx-auto rounded"></div></div>
      <div class="rounded-xl border border-border bg-card p-4 text-center animate-pulse"><div class="h-6 w-12 bg-muted mx-auto rounded"></div></div>
    </div>
  </div>

  <!-- Grid: Scheduling Info & Webhook Summary -->
  <div class="mb-8 grid grid-cols-1 gap-6 lg:grid-cols-2">
    <!-- Section 2: Scheduling Information -->
    <div class="rounded-2xl border border-border bg-card p-5 shadow-sm space-y-4">
      <div class="flex items-center justify-between border-b border-border pb-3">
        <div class="flex items-center gap-2">
          <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-amber-500/10 text-amber-500">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          </div>
          <div>
            <h3 class="text-sm font-bold text-foreground">Posting Schedule & Timezone</h3>
            <p class="text-xs text-muted-foreground">Automated publishing window configuration</p>
          </div>
        </div>
        <button
          id="open-scheduling-modal-btn"
          class="inline-flex items-center gap-1 rounded-lg border border-border bg-background px-2.5 py-1.5 text-xs font-semibold text-foreground hover:bg-muted transition-all"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
          <span>Edit Schedule</span>
        </button>
      </div>

      <div id="scheduling-info-container" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
        <div class="p-3 rounded-xl border border-border bg-background space-y-1">
          <span class="text-[11px] font-medium text-muted-foreground">Pinning Started At</span>
          <p id="sched-started-at" class="text-xs font-bold text-foreground">Loading...</p>
        </div>
        <div class="p-3 rounded-xl border border-border bg-background space-y-1">
          <span class="text-[11px] font-medium text-muted-foreground">Posting Window</span>
          <p id="sched-posting-window" class="text-xs font-bold text-foreground">Loading...</p>
        </div>
        <div class="p-3 rounded-xl border border-border bg-background space-y-1">
          <span class="text-[11px] font-medium text-muted-foreground">Posting Interval</span>
          <p id="sched-posting-interval" class="text-xs font-bold text-primary">Loading...</p>
        </div>
        <div class="p-3 rounded-xl border border-border bg-background space-y-1">
          <span class="text-[11px] font-medium text-muted-foreground">Random Delay</span>
          <p id="sched-random-delay" class="text-xs font-bold text-foreground">0 mins</p>
        </div>
        <div class="p-3 rounded-xl border border-border bg-background space-y-1">
          <span class="text-[11px] font-medium text-muted-foreground">Timezone</span>
          <p id="sched-timezone" class="text-xs font-bold text-foreground">Loading...</p>
        </div>
        <div class="p-3 rounded-xl border border-border bg-background space-y-1 sm:col-span-2 lg:col-span-1">
          <span class="text-[11px] font-medium text-muted-foreground">Last Published At</span>
          <p id="sched-last-published" class="text-xs font-bold text-emerald-500">Loading...</p>
        </div>
      </div>
    </div>

    <!-- Section 3: Webhook Summary -->
    <div class="rounded-2xl border border-border bg-card p-5 shadow-sm space-y-4">
      <div class="flex items-center justify-between border-b border-border pb-3">
        <div class="flex items-center gap-2">
          <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-primary/10 text-primary">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
          </div>
          <div>
            <h3 class="text-sm font-bold text-foreground">Webhook Orchestration Summary</h3>
            <p class="text-xs text-muted-foreground">Channel capacities & fallback priority routing</p>
          </div>
        </div>
        <button
          id="open-webhooks-modal-btn"
          class="inline-flex items-center gap-1 rounded-lg border border-primary/30 bg-primary/10 px-2.5 py-1.5 text-xs font-semibold text-primary hover:bg-primary hover:text-primary-foreground transition-all"
        >
          <span>Manage Webhooks &rarr;</span>
        </button>
      </div>

      <div id="webhook-summary-container" class="grid grid-cols-2 gap-3">
        <div class="p-3 rounded-xl border border-border bg-background space-y-1">
          <span class="text-[11px] font-medium text-muted-foreground">Channels Status</span>
          <p id="wh-sum-channels" class="text-xs font-bold text-foreground">Loading...</p>
        </div>
        <div class="p-3 rounded-xl border border-border bg-background space-y-1">
          <span class="text-[11px] font-medium text-muted-foreground">Primary Webhook</span>
          <p id="wh-sum-primary" class="text-xs font-bold text-foreground">Loading...</p>
        </div>
        <div class="col-span-2 p-3 rounded-xl border border-border bg-background space-y-1">
          <div class="flex items-center justify-between text-[11px] font-medium text-muted-foreground">
            <span>Combined Active Remaining Capacity</span>
            <span id="wh-sum-capacity-count" class="font-bold text-foreground">---</span>
          </div>
          <div class="h-2 w-full rounded-full bg-muted overflow-hidden">
            <div id="wh-sum-capacity-bar" class="h-full rounded-full bg-primary transition-all duration-300" style="width: 0%"></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Section 4: Recent Account Pins Queue -->
  <div class="mb-8 space-y-3">
    <div class="flex items-center justify-between">
      <h3 class="text-sm font-bold text-foreground tracking-wide uppercase">Recent Account Pins Queue</h3>
      <a href="/pins" class="text-xs font-semibold text-primary hover:underline">View all pins &rarr;</a>
    </div>

    <div id="account-pins-container">
      <div class="overflow-hidden rounded-xl border border-border bg-card p-6 text-center text-xs text-muted-foreground animate-pulse">
        Loading account pins history...
      </div>
    </div>
  </div>

  <!-- Section 5: Recent Account Execution Logs -->
  <div class="mb-8 space-y-3">
    <div class="flex items-center justify-between">
      <h3 class="text-sm font-bold text-foreground tracking-wide uppercase">Recent Execution Logs & Errors</h3>
      <a href="/logs" class="text-xs font-semibold text-primary hover:underline">View all system logs &rarr;</a>
    </div>

    <div id="account-logs-container">
      <div class="overflow-hidden rounded-xl border border-border bg-card p-6 text-center text-xs text-muted-foreground animate-pulse">
        Loading account activity logs...
      </div>
    </div>
  </div>

  <!-- MODAL: Edit Scheduling Information -->
  <div id="edit-scheduling-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60 backdrop-blur-sm p-4" aria-modal="true" role="dialog">
    <div id="edit-sched-backdrop" class="fixed inset-0"></div>
    <div class="relative w-full max-w-md rounded-2xl border border-border bg-card p-6 shadow-2xl space-y-4 z-10 max-h-[90vh] overflow-y-auto">
      <div class="flex items-center justify-between border-b border-border pb-3">
        <h3 class="text-base font-bold text-foreground">Edit Posting Schedule</h3>
        <button id="close-sched-modal" class="rounded-lg p-1 text-muted-foreground hover:bg-muted hover:text-foreground">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>

      <div id="sched-modal-error" class="hidden rounded-xl border border-rose-500/30 bg-rose-500/10 p-3 text-xs text-rose-500"></div>

      <form id="sched-form" class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-muted-foreground mb-1">Timezone</label>
          <select id="sched-input-timezone" class="w-full rounded-xl border border-border bg-background py-2 px-3 text-xs text-foreground focus:border-primary focus:outline-none">
            <option value="UTC">UTC (Coordinated Universal Time)</option>
            <option value="America/New_York">America/New_York (EST/EDT)</option>
            <option value="America/Chicago">America/Chicago (CST/CDT)</option>
            <option value="America/Denver">America/Denver (MST/MDT)</option>
            <option value="America/Los_Angeles">America/Los_Angeles (PST/PDT)</option>
            <option value="Europe/London">Europe/London (GMT/BST)</option>
            <option value="Europe/Paris">Europe/Paris (CET/CEST)</option>
            <option value="Asia/Tokyo">Asia/Tokyo (JST)</option>
            <option value="Australia/Sydney">Australia/Sydney (AEST/AEDT)</option>
          </select>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-muted-foreground mb-1">Window Start</label>
            <input id="sched-input-start" type="time" class="w-full rounded-xl border border-border bg-background py-2 px-3 text-xs text-foreground focus:border-primary focus:outline-none" />
          </div>
          <div>
            <label class="block text-xs font-medium text-muted-foreground mb-1">Window End</label>
            <input id="sched-input-end" type="time" class="w-full rounded-xl border border-border bg-background py-2 px-3 text-xs text-foreground focus:border-primary focus:outline-none" />
          </div>
        </div>

        <div>
          <label class="block text-xs font-medium text-muted-foreground mb-1">Posting Frequency / Interval</label>
          <select id="sched-input-interval-preset" class="w-full rounded-xl border border-border bg-background py-2 px-3 text-xs text-foreground focus:border-primary focus:outline-none">
            <option value="5">Every 5 Minutes (5 mins)</option>
            <option value="10">Every 10 Minutes (10 mins)</option>
            <option value="15">Every 15 Minutes (15 mins)</option>
            <option value="30">Every 30 Minutes (30 mins)</option>
            <option value="45">Every 45 Minutes (45 mins)</option>
            <option value="60">Every 1 Hour (60 mins)</option>
            <option value="120">Every 2 Hours (120 mins)</option>
            <option value="180">Every 3 Hours (180 mins)</option>
            <option value="240">Every 4 Hours (240 mins)</option>
            <option value="360">Every 6 Hours (360 mins)</option>
            <option value="720">Every 12 Hours (720 mins)</option>
            <option value="1440">Every 24 Hours (1440 mins)</option>
            <option value="custom">Custom Minutes...</option>
          </select>
        </div>

        <div id="sched-custom-interval-container" class="hidden">
          <label class="block text-xs font-medium text-muted-foreground mb-1">Custom Minutes Between Posts</label>
          <input id="sched-input-custom-interval" type="number" min="1" placeholder="e.g. 25" class="w-full rounded-xl border border-border bg-background py-2 px-3 text-xs text-foreground focus:border-primary focus:outline-none" />
        </div>

        <div>
          <label for="sched-input-random-delay" class="block text-xs font-semibold text-foreground mb-1">Random delay (minutes)</label>
          <input id="sched-input-random-delay" type="number" min="0" value="0" placeholder="0" class="w-full rounded-xl border border-border bg-background py-2 px-3 text-xs text-foreground focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary" />
          <p class="text-[11px] text-muted-foreground mt-1">Adds a random delay (0 to X minutes) to your posting interval for human-like scheduling variation.</p>
        </div>

        <div>
          <label class="block text-xs font-medium text-muted-foreground mb-1">Pinning Started Date</label>
          <input id="sched-input-started-at" type="date" class="w-full rounded-xl border border-border bg-background py-2 px-3 text-xs text-foreground focus:border-primary focus:outline-none" />
        </div>

        <div class="flex items-center justify-end gap-3 border-t border-border pt-4">
          <button type="button" id="cancel-sched-modal" class="rounded-xl border border-border px-4 py-2 text-xs font-medium text-muted-foreground hover:bg-muted hover:text-foreground">
            Cancel
          </button>
          <button type="submit" id="save-sched-btn" class="rounded-xl bg-primary px-4 py-2 text-xs font-semibold text-primary-foreground shadow hover:bg-primary/90">
            Save Schedule
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- MODAL: Edit Daily Limit -->
  <div id="edit-limit-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60 backdrop-blur-sm p-4" aria-modal="true" role="dialog">
    <div id="edit-limit-backdrop" class="fixed inset-0"></div>
    <div class="relative w-full max-w-md rounded-2xl border border-border bg-card p-6 shadow-2xl space-y-4 z-10">
      <div class="flex items-center justify-between border-b border-border pb-3">
        <h3 class="text-base font-bold text-foreground">Edit Account Daily Limit</h3>
        <button id="close-limit-btn" class="rounded-lg p-1 text-muted-foreground hover:bg-muted hover:text-foreground">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>

      <form id="limit-form" class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-muted-foreground mb-1">Max Pins Per Day</label>
          <input id="limit-input-num" type="number" min="1" required class="w-full rounded-xl border border-border bg-background py-2 px-3 text-xs text-foreground focus:border-primary focus:outline-none" />
        </div>

        <div class="flex items-center justify-end gap-3 border-t border-border pt-4">
          <button type="button" id="cancel-limit-btn" class="rounded-xl border border-border px-4 py-2 text-xs font-medium text-muted-foreground hover:bg-muted hover:text-foreground">
            Cancel
          </button>
          <button type="submit" class="rounded-xl bg-primary px-4 py-2 text-xs font-semibold text-primary-foreground shadow hover:bg-primary/90">
            Save Limit
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- MODAL: Multi-Webhook Orchestration -->
  <div id="webhooks-manage-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60 backdrop-blur-sm p-4" aria-modal="true" role="dialog">
    <div id="webhooks-manage-backdrop" class="fixed inset-0"></div>
    <div class="relative w-full max-w-3xl rounded-2xl border border-border bg-card p-6 shadow-2xl space-y-5 z-10 max-h-[90vh] flex flex-col">
      <!-- Modal Header -->
      <div class="flex items-center justify-between border-b border-border pb-4 flex-shrink-0">
        <div>
          <h3 class="text-base font-bold text-foreground">Multi-Webhook Orchestration</h3>
          <p id="manage-webhooks-subtitle" class="text-xs text-muted-foreground mt-0.5">Managing webhooks for account...</p>
        </div>
        <div class="flex items-center gap-2">
          <button
            id="open-add-webhook-btn"
            class="inline-flex items-center gap-1.5 rounded-xl bg-primary px-3 py-1.5 text-xs font-semibold text-primary-foreground shadow hover:bg-primary/90 transition-all"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            <span>+ Add Webhook</span>
          </button>
          <button id="close-webhooks-modal" class="rounded-lg p-1 text-muted-foreground hover:bg-muted hover:text-foreground">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          </button>
        </div>
      </div>

      <div id="webhooks-modal-error" class="hidden rounded-xl border border-rose-500/30 bg-rose-500/10 p-3 text-xs text-rose-500 flex-shrink-0"></div>
      <div id="webhooks-modal-success" class="hidden rounded-xl border border-emerald-500/30 bg-emerald-500/10 p-3 text-xs text-emerald-600 dark:text-emerald-400 flex-shrink-0"></div>

      <!-- Webhook List Container -->
      <div id="webhooks-list-container" class="flex-1 overflow-y-auto space-y-3 pr-1">
        <div class="p-8 text-center text-xs text-muted-foreground animate-pulse">
          Loading account webhooks...
        </div>
      </div>

      <!-- In-Modal Add/Edit Form (Hidden by default) -->
      <div id="webhook-form-container" class="hidden rounded-xl border border-border bg-muted/40 p-4 space-y-4 flex-shrink-0">
        <h4 id="webhook-form-title" class="text-xs font-bold text-foreground uppercase tracking-wider">Add New Webhook Channel</h4>
        <input type="hidden" id="form-webhook-id" />

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="space-y-1">
            <label for="form-hook-label" class="block text-[11px] font-semibold text-foreground">Channel Label *</label>
            <input
              id="form-hook-label"
              type="text"
              required
              placeholder="e.g. Channel B - Make #2"
              class="w-full rounded-lg border border-border bg-background py-1.5 px-3 text-xs text-foreground placeholder:text-muted-foreground focus:border-primary focus:outline-none"
            />
          </div>

          <div class="space-y-1">
            <label for="form-hook-url" class="block text-[11px] font-semibold text-foreground">Make.com Webhook URL *</label>
            <input
              id="form-hook-url"
              type="url"
              required
              placeholder="https://hook.make.com/abc456channel2"
              class="w-full rounded-lg border border-border bg-background py-1.5 px-3 text-xs text-foreground placeholder:text-muted-foreground focus:border-primary focus:outline-none"
            />
          </div>

          <div class="space-y-1">
            <label for="form-hook-capacity" class="block text-[11px] font-semibold text-foreground">Monthly Capacity *</label>
            <input
              id="form-hook-capacity"
              type="number"
              min="1"
              value="500"
              required
              class="w-full rounded-lg border border-border bg-background py-1.5 px-3 text-xs text-foreground focus:border-primary focus:outline-none"
            />
          </div>

          <div class="space-y-1">
            <label for="form-hook-priority" class="block text-[11px] font-semibold text-foreground">Routing Priority (1 = Highest) *</label>
            <input
              id="form-hook-priority"
              type="number"
              min="1"
              value="1"
              required
              class="w-full rounded-lg border border-border bg-background py-1.5 px-3 text-xs text-foreground focus:border-primary focus:outline-none"
            />
          </div>
        </div>

        <div class="flex items-center gap-6 pt-1">
          <label class="flex items-center gap-2 cursor-pointer text-xs font-medium text-foreground">
            <input id="form-hook-active" type="checkbox" checked class="h-4 w-4 rounded border-border text-primary" />
            <span>Active</span>
          </label>
          <label class="flex items-center gap-2 cursor-pointer text-xs font-medium text-foreground">
            <input id="form-hook-primary" type="checkbox" class="h-4 w-4 rounded border-border text-primary" />
            <span>Set as Primary Webhook</span>
          </label>
        </div>

        <div class="flex items-center justify-end gap-2 pt-2 border-t border-border">
          <button
            type="button"
            id="cancel-webhook-form"
            class="rounded-lg border border-border px-3 py-1.5 text-xs font-medium text-muted-foreground hover:bg-muted hover:text-foreground"
          >
            Cancel
          </button>
          <button
            type="button"
            id="submit-webhook-form"
            class="rounded-lg bg-primary px-3 py-1.5 text-xs font-semibold text-primary-foreground shadow hover:bg-primary/90"
          >
            Save Webhook
          </button>
        </div>
      </div>

      <div class="flex items-center justify-end border-t border-border pt-3 flex-shrink-0">
        <button
          type="button"
          id="dismiss-webhooks-modal"
          class="rounded-xl border border-border px-4 py-2 text-xs font-semibold text-foreground hover:bg-muted"
        >
          Done
        </button>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { requireAuth } from '../../lib/auth';
  import {
    getAccountDetails,
    getAccountPinStats,
    getAccountRecentPins,
    getAccountRecentLogs,
    getAccountWebhookSummary,
    getAccountWebhooks,
    createAccountWebhook,
    updateAccountWebhook,
    toggleAccountWebhookActive,
    setPrimaryWebhook,
    updateAccountScheduling,
    updateAccountDailyLimit,
    toggleAccountActive,
  } from '../../lib/supabase';
  import { renderStatusBadge, formatDate, formatTime, renderEmptyStateHTML, escapeHtml } from '../../lib/ui-helpers';
  import type { Account, AccountPinStats, Pin, Log, AccountWebhook } from '../../lib/types';

  let currentAccount: Account | null = null;
  let currentStats: AccountPinStats | null = null;
  let accountId: string = '';
  let activeAccountWebhooks: AccountWebhook[] = [];

  async function init() {
    const isAuth = await requireAuth();
    if (!isAuth) return;

    // Extract Account ID from URL (path or query string)
    const urlParams = new URLSearchParams(window.location.search);
    const queryId = urlParams.get('id');
    const parts = window.location.pathname.split('/accounts/');
    let pathId = '';
    if (parts.length > 1) {
      pathId = parts[1].split('/')[0].split('?')[0];
    }

    accountId = queryId || (pathId && pathId !== '[id]' && pathId !== 'details' ? pathId : '');

    if (!accountId) {
      const elem = document.getElementById('display-account-id');
      accountId = elem ? elem.textContent || '' : '';
    }

    if (!accountId) return;

    setupModalListeners();
    await loadAllData();
  }

  async function loadAllData() {
    try {
      const [acc, stats, pins, logs, whSummary] = await Promise.all([
        getAccountDetails(accountId),
        getAccountPinStats(accountId),
        getAccountRecentPins(accountId, 10),
        getAccountRecentLogs(accountId, 10),
        getAccountWebhookSummary(accountId),
      ]);

      if (!acc) {
        document.getElementById('account-header-container')!.innerHTML = renderEmptyStateHTML(
          'Account Not Found',
          `Could not locate Pinterest account matching ID "${escapeHtml(accountId)}".`,
          'alert-circle'
        );
        return;
      }

      currentAccount = acc;
      currentStats = stats;

      renderHeader(acc);
      renderKPIs(stats, acc);
      renderScheduling(acc);
      renderWebhookSummary(whSummary);
      renderRecentPins(pins);
      renderRecentLogs(logs);
    } catch (err) {
      console.error('Error loading account details:', err);
    }
  }

  function renderHeader(acc: Account) {
    const headerContainer = document.getElementById('account-header-container');
    if (!headerContainer) return;

    const initials = (acc.account_name || 'AC').slice(0, 2).toUpperCase();

    headerContainer.innerHTML = `
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div class="flex items-center gap-3.5">
          <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-primary/10 text-primary font-bold text-base shadow-sm">
            ${escapeHtml(initials)}
          </div>
          <div>
            <div class="flex items-center gap-2.5">
              <h1 class="text-xl font-bold text-foreground">${escapeHtml(acc.account_name)}</h1>
              ${renderStatusBadge(acc.is_active)}
            </div>
            <p class="text-xs text-muted-foreground mt-0.5">
              Registered ${formatDate(acc.created_at)} • ${acc.boards_count || 0} linked boards
            </p>
          </div>
        </div>

        <div class="flex flex-wrap items-center gap-2.5">
          <a
            href="/imports?account=${acc.id}"
            class="inline-flex items-center gap-1.5 rounded-xl bg-emerald-600 px-3.5 py-2 text-xs font-semibold text-white shadow hover:bg-emerald-700 transition-all"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
            <span>+ Import Posts</span>
          </a>

          <button
            id="btn-edit-limit"
            class="inline-flex items-center gap-1.5 rounded-xl border border-border bg-background px-3.5 py-2 text-xs font-semibold text-foreground hover:bg-muted transition-all"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
            <span>Limit: ${acc.max_pins_per_day}/day</span>
          </button>

          <button
            id="btn-toggle-active"
            class="inline-flex items-center gap-1.5 rounded-xl border ${acc.is_active ? 'border-amber-500/30 bg-amber-500/10 text-amber-600 dark:text-amber-400' : 'border-emerald-500/30 bg-emerald-500/10 text-emerald-600 dark:text-emerald-400'} px-3.5 py-2 text-xs font-semibold hover:opacity-80 transition-all"
          >
            <span>${acc.is_active ? 'Deactivate' : 'Activate'}</span>
          </button>
        </div>
      </div>
    `;

    document.getElementById('btn-edit-limit')?.addEventListener('click', openLimitModal);
    document.getElementById('btn-toggle-active')?.addEventListener('click', handleToggleActive);
  }

  function renderKPIs(stats: AccountPinStats, acc: Account) {
    const container = document.getElementById('kpis-grid-container');
    if (!container) return;

    container.innerHTML = `
      <div class="rounded-xl border border-border bg-card p-3 text-center space-y-1">
        <span class="text-[11px] font-semibold text-muted-foreground">Total Posts</span>
        <p class="text-xl font-bold text-foreground">${stats.total}</p>
      </div>
      <div class="rounded-xl border border-amber-500/20 bg-amber-500/5 p-3 text-center space-y-1">
        <span class="text-[11px] font-semibold text-amber-600 dark:text-amber-400">Pending</span>
        <p class="text-xl font-bold text-amber-600 dark:text-amber-400">${stats.pending}</p>
      </div>
      <div class="rounded-xl border border-emerald-500/20 bg-emerald-500/5 p-3 text-center space-y-1">
        <span class="text-[11px] font-semibold text-emerald-600 dark:text-emerald-400">Posted</span>
        <p class="text-xl font-bold text-emerald-600 dark:text-emerald-400">${stats.posted}</p>
      </div>
      <div class="rounded-xl border border-rose-500/20 bg-rose-500/5 p-3 text-center space-y-1">
        <span class="text-[11px] font-semibold text-rose-500">Failed</span>
        <p class="text-xl font-bold text-rose-500">${stats.failed}</p>
      </div>
      <div class="rounded-xl border border-primary/20 bg-primary/5 p-3 text-center space-y-1">
        <span class="text-[11px] font-semibold text-primary">Remaining</span>
        <p class="text-xl font-bold text-primary">${stats.remainingToday}</p>
      </div>
      <div class="rounded-xl border border-border bg-card p-3 text-center space-y-1">
        <span class="text-[11px] font-semibold text-muted-foreground">Daily Limit</span>
        <p class="text-xl font-bold text-foreground">${acc.max_pins_per_day}</p>
      </div>
      <div class="rounded-xl border border-border bg-card p-3 text-center space-y-1">
        <span class="text-[11px] font-semibold text-muted-foreground">Boards</span>
        <p class="text-xl font-bold text-foreground">${acc.boards_count || 0}</p>
      </div>
      <div class="rounded-xl border border-border bg-card p-3 text-center space-y-1">
        <span class="text-[11px] font-semibold text-muted-foreground">Webhooks</span>
        <p class="text-xl font-bold text-foreground">${acc.active_webhooks_count || 0}</p>
      </div>
    `;
  }

  function renderScheduling(acc: Account) {
    const startedElem = document.getElementById('sched-started-at');
    const windowElem = document.getElementById('sched-posting-window');
    const intervalElem = document.getElementById('sched-posting-interval');
    const delayElem = document.getElementById('sched-random-delay');
    const tzElem = document.getElementById('sched-timezone');
    const lastPubElem = document.getElementById('sched-last-published');

    if (startedElem) {
      startedElem.textContent = acc.pinning_started_at ? formatDate(acc.pinning_started_at) : 'Not configured';
    }
    if (windowElem) {
      const start = acc.posting_window_start || '09:00';
      const end = acc.posting_window_end || '21:00';
      windowElem.textContent = `${start} — ${end}`;
    }
    if (intervalElem) {
      const mins = acc.posting_interval_minutes || 30;
      intervalElem.textContent = mins >= 60 ? `Every ${mins / 60} ${mins === 60 ? 'hour' : 'hours'}` : `Every ${mins} mins`;
    }
    if (delayElem) {
      const delay = acc.random_delay_minutes || 0;
      delayElem.textContent = `${delay} mins`;
    }
    if (tzElem) {
      tzElem.textContent = acc.timezone || 'UTC';
    }
    if (lastPubElem) {
      lastPubElem.textContent = acc.last_published_at ? formatDate(acc.last_published_at) : 'No published pins yet';
    }
  }

  function renderWebhookSummary(sum: any) {
    const channelsElem = document.getElementById('wh-sum-channels');
    const primaryElem = document.getElementById('wh-sum-primary');
    const countElem = document.getElementById('wh-sum-capacity-count');
    const barElem = document.getElementById('wh-sum-capacity-bar');

    if (channelsElem) {
      channelsElem.textContent = `${sum.activeWebhooks} Active of ${sum.totalWebhooks} Total`;
    }
    if (primaryElem) {
      primaryElem.textContent = sum.primaryWebhookLabel || 'None';
    }
    if (countElem) {
      countElem.textContent = `${sum.totalRemainingCapacity} pins remaining`;
    }
    if (barElem) {
      const pct = Math.min(100, Math.round((sum.totalRemainingCapacity / 1500) * 100));
      barElem.style.width = `${pct}%`;
    }

    document.getElementById('open-webhooks-modal-btn')?.addEventListener('click', () => {
      window.location.href = '/accounts';
    });
  }

  function renderRecentPins(pins: Pin[]) {
    const container = document.getElementById('account-pins-container');
    if (!container) return;

    if (!pins || pins.length === 0) {
      container.innerHTML = renderEmptyStateHTML(
        'No Pins Found for Account',
        'Import scheduled posts to populate this account queue.',
        'inbox'
      );
      return;
    }

    const rowsHtml = pins
      .map(
        (pin) => `
        <tr class="transition-colors hover:bg-muted/40 text-xs">
          <td class="px-5 py-3 font-medium text-foreground">
            <div class="flex items-center gap-3">
              <img src="${escapeHtml(pin.image_url)}" alt="" class="h-9 w-9 rounded-lg object-cover border border-border bg-muted flex-shrink-0" onerror="this.src='https://images.unsplash.com/photo-1495521821757-a1efb6729352?auto=format&fit=crop&w=150&q=80'" />
              <span class="max-w-xs truncate" title="${escapeHtml(pin.title)}">${escapeHtml(pin.title)}</span>
            </div>
          </td>
          <td class="px-5 py-3 text-muted-foreground">${escapeHtml(pin.board_name || 'No board')}</td>
          <td class="px-5 py-3">${renderStatusBadge(pin.status)}</td>
          <td class="px-5 py-3 text-muted-foreground whitespace-nowrap">${pin.scheduled_for ? formatDate(pin.scheduled_for) : 'Immediate'}</td>
          <td class="px-5 py-3 text-muted-foreground whitespace-nowrap">${pin.posted_at ? formatDate(pin.posted_at) : formatDate(pin.created_at)}</td>
        </tr>
      `
      )
      .join('');

    container.innerHTML = `
      <div class="overflow-hidden rounded-xl border border-border bg-card shadow-sm">
        <div class="overflow-x-auto">
          <table class="w-full text-left">
            <thead class="border-b border-border bg-muted/50 text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">
              <tr>
                <th class="px-5 py-3">Pin Title</th>
                <th class="px-5 py-3">Target Board</th>
                <th class="px-5 py-3">Status</th>
                <th class="px-5 py-3">Scheduled For</th>
                <th class="px-5 py-3">Posted / Created</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-border">
              ${rowsHtml}
            </tbody>
          </table>
        </div>
      </div>
    `;
  }

  function renderRecentLogs(logs: Log[]) {
    const container = document.getElementById('account-logs-container');
    if (!container) return;

    if (!logs || logs.length === 0) {
      container.innerHTML = renderEmptyStateHTML(
        'No Logs Recorded',
        'Automation execution attempts will record webhook logs here.',
        'alert-circle'
      );
      return;
    }

    const rowsHtml = logs
      .map(
        (log) => `
        <tr class="transition-colors hover:bg-muted/40 text-xs">
          <td class="px-5 py-3">${renderStatusBadge(log.status)}</td>
          <td class="px-5 py-3 font-medium text-foreground max-w-md truncate" title="${escapeHtml(log.message || '')}">${escapeHtml(log.message || 'Execution completed.')}</td>
          <td class="px-5 py-3 text-muted-foreground font-mono text-[11px]">${log.webhook_label ? escapeHtml(log.webhook_label) : 'System Hook'}</td>
          <td class="px-5 py-3 text-muted-foreground whitespace-nowrap">${formatDate(log.created_at)}</td>
        </tr>
      `
      )
      .join('');

    container.innerHTML = `
      <div class="overflow-hidden rounded-xl border border-border bg-card shadow-sm">
        <div class="overflow-x-auto">
          <table class="w-full text-left">
            <thead class="border-b border-border bg-muted/50 text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">
              <tr>
                <th class="px-5 py-3">State</th>
                <th class="px-5 py-3">Message</th>
                <th class="px-5 py-3">Webhook Channel</th>
                <th class="px-5 py-3">Timestamp</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-border">
              ${rowsHtml}
            </tbody>
          </table>
        </div>
      </div>
    `;
  }

  function showFeedbackBanner(message: string, type: 'success' | 'error' = 'success') {
    const banner = document.getElementById('account-feedback-banner');
    const text = document.getElementById('account-feedback-text');
    if (!banner || !text) return;

    text.textContent = message;
    if (type === 'error') {
      banner.className = 'mb-4 rounded-xl border border-rose-500/30 bg-rose-500/10 p-3.5 text-xs text-rose-500 flex items-center justify-between shadow-sm';
    } else {
      banner.className = 'mb-4 rounded-xl border border-emerald-500/30 bg-emerald-500/10 p-3.5 text-xs text-emerald-600 dark:text-emerald-400 flex items-center justify-between shadow-sm';
    }
    banner.classList.remove('hidden');

    setTimeout(() => {
      banner.classList.add('hidden');
    }, 5000);
  }

  document.getElementById('close-account-feedback')?.addEventListener('click', () => {
    document.getElementById('account-feedback-banner')?.classList.add('hidden');
  });

  // Unified Single Source of Truth UI State Sync
  function refreshAccountUI(updatedPayload?: Partial<Account>) {
    if (updatedPayload && currentAccount) {
      Object.assign(currentAccount, updatedPayload);
    }

    if (currentAccount) {
      renderHeader(currentAccount);
      if (currentStats) {
        renderKPIs(currentStats, currentAccount);
      }
      renderScheduling(currentAccount);
    }
  }

  async function handleToggleActive() {
    if (!currentAccount) return;
    try {
      const newStatus = !currentAccount.is_active;
      const res = await toggleAccountActive(currentAccount.id, newStatus);
      if (res.data || res.success) {
        const updated = res.data || { ...currentAccount, is_active: newStatus };
        refreshAccountUI(updated);
        showFeedbackBanner(`Account status updated to ${newStatus ? 'Active' : 'Inactive'}.`, 'success');
        // Authoritative background sync
        loadAllData();
      } else if (res.error) {
        showFeedbackBanner(res.error, 'error');
      }
    } catch (err: any) {
      showFeedbackBanner(err.message || 'Failed to toggle account status', 'error');
    }
  }

  function openLimitModal() {
    if (!currentAccount) return;
    const modal = document.getElementById('edit-limit-modal');
    const input = document.getElementById('limit-input-num') as HTMLInputElement;
    if (input) input.value = String(currentAccount.max_pins_per_day);
    modal?.classList.remove('hidden');
    modal?.classList.add('flex');
  }

  function openSchedulingModal() {
    if (!currentAccount) return;
    const modal = document.getElementById('edit-scheduling-modal');
    const tz = document.getElementById('sched-input-timezone') as HTMLSelectElement;
    const start = document.getElementById('sched-input-start') as HTMLInputElement;
    const end = document.getElementById('sched-input-end') as HTMLInputElement;
    const intervalPreset = document.getElementById('sched-input-interval-preset') as HTMLSelectElement;
    const customContainer = document.getElementById('sched-custom-interval-container');
    const customInput = document.getElementById('sched-input-custom-interval') as HTMLInputElement;
    const delayInput = document.getElementById('sched-input-random-delay') as HTMLInputElement;
    const started = document.getElementById('sched-input-started-at') as HTMLInputElement;

    if (tz) tz.value = currentAccount.timezone || 'UTC';
    if (start) start.value = currentAccount.posting_window_start || '09:00';
    if (end) end.value = currentAccount.posting_window_end || '21:00';
    if (delayInput) delayInput.value = String(currentAccount.random_delay_minutes || 0);
    if (started) started.value = currentAccount.pinning_started_at ? currentAccount.pinning_started_at.slice(0, 10) : '';

    const mins = currentAccount.posting_interval_minutes || 30;
    const standardPresets = ['5', '10', '15', '30', '45', '60', '120', '180', '240', '360', '720', '1440'];
    if (standardPresets.includes(String(mins))) {
      if (intervalPreset) intervalPreset.value = String(mins);
      if (customContainer) customContainer.classList.add('hidden');
    } else {
      if (intervalPreset) intervalPreset.value = 'custom';
      if (customContainer) customContainer.classList.remove('hidden');
      if (customInput) customInput.value = String(mins);
    }

    modal?.classList.remove('hidden');
    modal?.classList.add('flex');
  }

  function setupModalListeners() {
    // Scheduling modal
    document.getElementById('open-scheduling-modal-btn')?.addEventListener('click', openSchedulingModal);
    document.getElementById('close-sched-modal')?.addEventListener('click', closeSchedModal);
    document.getElementById('cancel-sched-modal')?.addEventListener('click', closeSchedModal);
    document.getElementById('edit-sched-backdrop')?.addEventListener('click', closeSchedModal);

    const intervalPresetSelect = document.getElementById('sched-input-interval-preset') as HTMLSelectElement;
    intervalPresetSelect?.addEventListener('change', (e) => {
      const val = (e.target as HTMLSelectElement).value;
      const customContainer = document.getElementById('sched-custom-interval-container');
      if (val === 'custom') {
        customContainer?.classList.remove('hidden');
      } else {
        customContainer?.classList.add('hidden');
      }
    });

    document.getElementById('sched-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!currentAccount) return;

      const tz = (document.getElementById('sched-input-timezone') as HTMLSelectElement).value;
      const start = (document.getElementById('sched-input-start') as HTMLInputElement).value;
      const end = (document.getElementById('sched-input-end') as HTMLInputElement).value;
      const startedAt = (document.getElementById('sched-input-started-at') as HTMLInputElement).value;
      const delayVal = parseInt((document.getElementById('sched-input-random-delay') as HTMLInputElement).value, 10);
      const randomDelayMins = !isNaN(delayVal) && delayVal >= 0 ? delayVal : 0;

      const presetVal = (document.getElementById('sched-input-interval-preset') as HTMLSelectElement).value;
      let intervalMins = 30;
      if (presetVal === 'custom') {
        const customVal = parseInt((document.getElementById('sched-input-custom-interval') as HTMLInputElement).value, 10);
        intervalMins = !isNaN(customVal) && customVal >= 1 ? customVal : 30;
      } else {
        intervalMins = parseInt(presetVal, 10) || 30;
      }

      const errorBox = document.getElementById('sched-modal-error');
      if (errorBox) errorBox.classList.add('hidden');

      const res = await updateAccountScheduling(currentAccount.id, {
        timezone: tz,
        posting_window_start: start || null,
        posting_window_end: end || null,
        posting_interval_minutes: intervalMins,
        random_delay_minutes: randomDelayMins,
        pinning_started_at: startedAt ? new Date(startedAt).toISOString() : null,
      });

      if (res.data || res.success) {
        const updated = res.data ? { ...currentAccount, ...res.data } : {
          ...currentAccount,
          timezone: tz,
          posting_window_start: start || null,
          posting_window_end: end || null,
          posting_interval_minutes: intervalMins,
          random_delay_minutes: randomDelayMins,
          pinning_started_at: startedAt ? new Date(startedAt).toISOString() : null,
        };
        refreshAccountUI(updated);
        closeSchedModal();
        showFeedbackBanner('Posting schedule updated successfully.', 'success');
        // Authoritative background sync
        loadAllData();
      } else if (res.error) {
        if (errorBox) {
          errorBox.textContent = res.error;
          errorBox.classList.remove('hidden');
        }
      }
    });

    // Limit modal
    document.getElementById('close-limit-modal')?.addEventListener('click', closeLimitModal);
    document.getElementById('cancel-limit-btn')?.addEventListener('click', closeLimitModal);
    document.getElementById('edit-limit-backdrop')?.addEventListener('click', closeLimitModal);

    document.getElementById('limit-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!currentAccount) return;
      const val = parseInt((document.getElementById('limit-input-num') as HTMLInputElement).value, 10);
      if (isNaN(val) || val < 1) return;

      const res = await updateAccountDailyLimit(currentAccount.id, val);
      if (res.data || res.success) {
        const updated = res.data || { ...currentAccount, max_pins_per_day: val };
        refreshAccountUI(updated);
        closeLimitModal();
        showFeedbackBanner(`Account daily limit updated to ${val} pins/day.`, 'success');
        // Authoritative background sync
        loadAllData();
      } else if (res.error) {
        alert('Failed to update daily limit: ' + res.error);
      }
    });

    // Webhook manager modal listeners
    document.getElementById('open-webhooks-modal-btn')?.addEventListener('click', openManageWebhooksModal);
    document.getElementById('close-webhooks-modal')?.addEventListener('click', closeWebhooksModal);
    document.getElementById('dismiss-webhooks-modal')?.addEventListener('click', closeWebhooksModal);
    document.getElementById('webhooks-manage-backdrop')?.addEventListener('click', closeWebhooksModal);
    document.getElementById('open-add-webhook-btn')?.addEventListener('click', () => showWebhookForm());
    document.getElementById('cancel-webhook-form')?.addEventListener('click', hideWebhookForm);

    document.getElementById('submit-webhook-form')?.addEventListener('click', async () => {
      if (!currentAccount) return;
      hideWebhooksModalFeedback();

      const webhookId = (document.getElementById('form-webhook-id') as HTMLInputElement).value;
      const label = (document.getElementById('form-hook-label') as HTMLInputElement).value.trim();
      const url = (document.getElementById('form-hook-url') as HTMLInputElement).value.trim();
      const cap = parseInt((document.getElementById('form-hook-capacity') as HTMLInputElement).value, 10);
      const prio = parseInt((document.getElementById('form-hook-priority') as HTMLInputElement).value, 10);
      const active = (document.getElementById('form-hook-active') as HTMLInputElement).checked;
      const primary = (document.getElementById('form-hook-primary') as HTMLInputElement).checked;

      if (!label) {
        showWebhooksModalError('Label is required.');
        return;
      }
      if (!url || !url.startsWith('http')) {
        showWebhooksModalError('Valid HTTP/HTTPS Webhook URL is required.');
        return;
      }
      if (isNaN(cap) || cap < 1) {
        showWebhooksModalError('Monthly capacity must be a positive integer (minimum 1).');
        return;
      }
      if (isNaN(prio) || prio < 1) {
        showWebhooksModalError('Priority must be a positive integer (minimum 1).');
        return;
      }

      // Check duplicates for this account
      const labelDup = activeAccountWebhooks.some(
        (w) => w.id !== webhookId && w.label.toLowerCase() === label.toLowerCase()
      );
      if (labelDup) {
        showWebhooksModalError(`A webhook labeled "${label}" already exists for this account.`);
        return;
      }

      const urlDup = activeAccountWebhooks.some(
        (w) => w.id !== webhookId && w.webhook_url.toLowerCase() === url.toLowerCase()
      );
      if (urlDup) {
        showWebhooksModalError('This webhook URL is already registered for this account.');
        return;
      }

      if (webhookId) {
        // Edit existing
        const { error } = await updateAccountWebhook(webhookId, {
          label,
          webhook_url: url,
          monthly_capacity: cap,
          priority: prio,
          is_active: active,
          is_primary: primary,
        });
        if (error) showWebhooksModalError(error);
        else {
          showWebhooksModalSuccess('Webhook channel updated successfully.');
          hideWebhookForm();
          await refreshWebhooksList();
          await loadAllData();
        }
      } else {
        // Create new
        const { error } = await createAccountWebhook({
          account_id: currentAccount.id,
          label,
          webhook_url: url,
          monthly_capacity: cap,
          priority: prio,
          is_active: active,
          is_primary: primary,
        });
        if (error) showWebhooksModalError(error);
        else {
          showWebhooksModalSuccess('New webhook channel added successfully.');
          hideWebhookForm();
          await refreshWebhooksList();
          await loadAllData();
        }
      }
    });
  }

  function hideWebhookForm() {
    const formContainer = document.getElementById('webhook-form-container');
    if (formContainer) formContainer.classList.add('hidden');
  }

  function hideWebhooksModalFeedback() {
    const err = document.getElementById('webhooks-modal-error');
    const succ = document.getElementById('webhooks-modal-success');
    if (err) err.classList.add('hidden');
    if (succ) succ.classList.add('hidden');
  }

  function showWebhooksModalError(msg: string) {
    const err = document.getElementById('webhooks-modal-error');
    if (err) {
      err.textContent = msg;
      err.classList.remove('hidden');
    }
  }

  function showWebhooksModalSuccess(msg: string) {
    const succ = document.getElementById('webhooks-modal-success');
    if (succ) {
      succ.textContent = msg;
      succ.classList.remove('hidden');
    }
  }

  async function openManageWebhooksModal() {
    if (!currentAccount) return;
    const modal = document.getElementById('webhooks-manage-modal');
    const subtitle = document.getElementById('manage-webhooks-subtitle');
    if (subtitle) subtitle.textContent = `Managing Webhooks for: ${currentAccount.account_name}`;

    hideWebhookForm();
    hideWebhooksModalFeedback();

    modal?.classList.remove('hidden');
    modal?.classList.add('flex');

    await refreshWebhooksList();
  }

  function closeWebhooksModal() {
    const modal = document.getElementById('webhooks-manage-modal');
    modal?.classList.add('hidden');
    modal?.classList.remove('flex');
    hideWebhookForm();
  }

  async function refreshWebhooksList() {
    if (!currentAccount) return;
    const container = document.getElementById('webhooks-list-container');
    if (!container) return;

    container.innerHTML = '<div class="p-8 text-center text-xs text-muted-foreground animate-pulse">Loading account webhooks...</div>';

    activeAccountWebhooks = await getAccountWebhooks(currentAccount.id);

    if (!activeAccountWebhooks || activeAccountWebhooks.length === 0) {
      container.innerHTML = renderEmptyStateHTML(
        'No Webhooks Configured',
        'Click "+ Add Webhook" above to create your first Make.com outbound channel.',
        'inbox'
      );
      return;
    }

    renderWebhookCards();
  }

  function renderWebhookCards() {
    const container = document.getElementById('webhooks-list-container');
    if (!container) return;

    const cardsHtml = activeAccountWebhooks
      .map((hook) => {
        const masked = hook.webhook_url.length > 25
          ? hook.webhook_url.slice(0, 22) + '••••' + hook.webhook_url.slice(-4)
          : hook.webhook_url;
        const remCap = Math.max(0, (hook.monthly_capacity ?? 500) - (hook.monthly_usage ?? 0));
        const capPct = Math.min(100, Math.round((remCap / (hook.monthly_capacity || 500)) * 100));

        return `
          <div class="rounded-xl border border-border bg-card p-4 space-y-3 shadow-sm transition-all hover:border-primary/30">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-2">
                <span class="font-bold text-sm text-foreground">${escapeHtml(hook.label)}</span>
                ${
                  hook.is_primary
                    ? `<span class="rounded-full bg-primary/10 text-primary border border-primary/20 px-2 py-0.5 text-[10px] font-bold">PRIMARY</span>`
                    : ''
                }
                <span class="rounded-md bg-muted px-2 py-0.5 text-[10px] font-semibold text-muted-foreground">Priority ${hook.priority}</span>
              </div>
              <div class="flex items-center gap-2">
                ${renderStatusBadge(hook.is_active)}
              </div>
            </div>

            <div class="font-mono text-xs text-muted-foreground bg-muted/50 rounded-lg px-2.5 py-1.5 truncate" title="Masked Endpoint">
              ${escapeHtml(masked)}
            </div>

            <div class="space-y-1">
              <div class="flex items-center justify-between text-xs">
                <span class="text-muted-foreground font-medium">Monthly Capacity:</span>
                <span class="font-semibold text-foreground">${remCap} / ${hook.monthly_capacity} pins remaining</span>
              </div>
              <div class="h-2 w-full rounded-full bg-muted overflow-hidden">
                <div
                  class="h-full rounded-full transition-all duration-300 ${remCap > 50 ? 'bg-emerald-500' : remCap > 0 ? 'bg-amber-500' : 'bg-rose-500'}"
                  style="width: ${capPct}%"
                ></div>
              </div>
            </div>

            ${
              hook.last_failure_reason
                ? `<div class="rounded-lg bg-rose-500/10 border border-rose-500/20 p-2 text-[11px] text-rose-500 flex items-start gap-1.5">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 flex-shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                    <span>Failure Reason: ${escapeHtml(hook.last_failure_reason)}</span>
                  </div>`
                : ''
            }

            <div class="flex items-center justify-between border-t border-border pt-2.5 text-xs">
              <span class="text-[11px] text-muted-foreground">
                ${hook.last_used_at ? 'Last used: ' + formatDate(hook.last_used_at) : 'Never used'}
              </span>
              <div class="flex items-center gap-2">
                ${
                  !hook.is_primary
                    ? `<button
                        data-webhook-action="set-primary"
                        data-id="${hook.id}"
                        class="text-xs text-primary font-semibold hover:underline"
                      >Set Primary</button>`
                    : ''
                }
                <button
                  data-webhook-action="toggle-active"
                  data-id="${hook.id}"
                  data-active="${hook.is_active}"
                  class="text-xs text-muted-foreground hover:text-foreground font-medium"
                >${hook.is_active ? 'Deactivate' : 'Activate'}</button>
                <button
                  data-webhook-action="edit"
                  data-id="${hook.id}"
                  class="rounded border border-border px-2 py-0.5 text-xs text-foreground hover:bg-muted font-medium"
                >Edit</button>
              </div>
            </div>
          </div>
        `;
      })
      .join('');

    container.innerHTML = cardsHtml;
    bindWebhookCardListeners();
  }

  function bindWebhookCardListeners() {
    document.querySelectorAll('[data-webhook-action="set-primary"]').forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        const id = (e.currentTarget as HTMLElement).getAttribute('data-id') || '';
        if (!currentAccount) return;
        const { error } = await setPrimaryWebhook(id, currentAccount.id);
        if (error) showWebhooksModalError(error);
        else {
          showWebhooksModalSuccess('Primary webhook updated successfully.');
          await refreshWebhooksList();
          await loadAllData();
        }
      });
    });

    document.querySelectorAll('[data-webhook-action="toggle-active"]').forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        const id = (e.currentTarget as HTMLElement).getAttribute('data-id') || '';
        const isActive = (e.currentTarget as HTMLElement).getAttribute('data-active') === 'true';
        const { error } = await toggleAccountWebhookActive(id, !isActive);
        if (error) showWebhooksModalError(error);
        else {
          showWebhooksModalSuccess(`Webhook ${!isActive ? 'activated' : 'deactivated'}.`);
          await refreshWebhooksList();
          await loadAllData();
        }
      });
    });

    document.querySelectorAll('[data-webhook-action="edit"]').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const id = (e.currentTarget as HTMLElement).getAttribute('data-id') || '';
        const target = activeAccountWebhooks.find((w) => w.id === id);
        if (target) showWebhookForm(target);
      });
    });
  }

  function showWebhookForm(target?: AccountWebhook) {
    const formContainer = document.getElementById('webhook-form-container');
    const formTitle = document.getElementById('webhook-form-title');
    const idInput = document.getElementById('form-webhook-id') as HTMLInputElement;
    const labelInput = document.getElementById('form-hook-label') as HTMLInputElement;
    const urlInput = document.getElementById('form-hook-url') as HTMLInputElement;
    const capInput = document.getElementById('form-hook-capacity') as HTMLInputElement;
    const prioInput = document.getElementById('form-hook-priority') as HTMLInputElement;
    const activeCheck = document.getElementById('form-hook-active') as HTMLInputElement;
    const primaryCheck = document.getElementById('form-hook-primary') as HTMLInputElement;

    hideWebhooksModalFeedback();

    if (target) {
      if (formTitle) formTitle.textContent = 'Edit Webhook Channel';
      idInput.value = target.id;
      labelInput.value = target.label;
      urlInput.value = target.webhook_url;
      capInput.value = String(target.monthly_capacity);
      prioInput.value = String(target.priority);
      activeCheck.checked = target.is_active;
      primaryCheck.checked = target.is_primary;
    } else {
      if (formTitle) formTitle.textContent = 'Add New Webhook Channel';
      idInput.value = '';
      labelInput.value = '';
      urlInput.value = '';
      capInput.value = '500';
      prioInput.value = '1';
      activeCheck.checked = true;
      primaryCheck.checked = activeAccountWebhooks.length === 0;
    }

    formContainer?.classList.remove('hidden');
  }

  function closeSchedModal() {
    const modal = document.getElementById('edit-scheduling-modal');
    modal?.classList.add('hidden');
    modal?.classList.remove('flex');
  }

  function closeLimitModal() {
    const modal = document.getElementById('edit-limit-modal');
    modal?.classList.add('hidden');
    modal?.classList.remove('flex');
  }

  init();
</script>
