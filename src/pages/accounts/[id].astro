---
import Layout from '../../layouts/Layout.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import KPIStatCard from '../../components/ui/KPIStatCard.astro';
import { getAccounts } from '../../lib/supabase';

export async function getStaticPaths() {
  const accounts = await getAccounts();
  const fallbackIds = ['acc-1', 'acc-2', 'acc-3'];
  const fetchedIds = (accounts || []).map((a) => a.id);
  const allIds = Array.from(new Set([...fallbackIds, ...fetchedIds]));

  return allIds.map((id) => ({
    params: { id },
  }));
}

const { id } = Astro.params;
---

<Layout title="Manage Account Details" description="Detailed operational, scheduling, and activity control center for Pinterest account.">
  <!-- Back Link & Breadcrumb -->
  <div class="mb-4 flex items-center justify-between">
    <a href="/accounts" class="inline-flex items-center gap-1.5 text-xs font-semibold text-muted-foreground hover:text-foreground transition-all">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
      <span>&larr; Back to Accounts</span>
    </a>
    <span class="text-xs text-muted-foreground font-mono">Account ID: <span id="display-account-id">{id}</span></span>
  </div>

  <!-- Global Feedback Banner -->
  <div id="account-feedback-banner" class="hidden mb-4 rounded-xl border border-emerald-500/30 bg-emerald-500/10 p-3.5 text-xs text-emerald-600 dark:text-emerald-400 flex items-center justify-between shadow-sm">
    <div class="flex items-center gap-2.5">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>
      </svg>
      <span id="account-feedback-text">Account updated successfully.</span>
    </div>
    <button id="close-account-feedback" class="font-bold opacity-70 hover:opacity-100">&times;</button>
  </div>

  <!-- Header Control Card -->
  <div id="account-header-container" class="mb-6 rounded-2xl border border-border bg-card p-6 shadow-sm">
    <div class="animate-pulse flex flex-col md:flex-row md:items-center md:justify-between gap-4">
      <div class="h-8 w-48 rounded-lg bg-muted"></div>
      <div class="h-9 w-64 rounded-lg bg-muted"></div>
    </div>
  </div>

  <!-- Section 1: Overview KPI Cards (8 Grid Items) -->
  <div class="mb-8 space-y-3">
    <h3 class="text-sm font-bold text-foreground tracking-wide uppercase">Operational Overview & Metrics</h3>
    <div id="kpis-grid-container" class="grid grid-cols-2 gap-3 sm:grid-cols-4 lg:grid-cols-8">
      <div class="rounded-xl border border-border bg-card p-4 text-center animate-pulse"><div class="h-6 w-12 bg-muted mx-auto rounded"></div></div>
      <div class="rounded-xl border border-border bg-card p-4 text-center animate-pulse"><div class="h-6 w-12 bg-muted mx-auto rounded"></div></div>
      <div class="rounded-xl border border-border bg-card p-4 text-center animate-pulse"><div class="h-6 w-12 bg-muted mx-auto rounded"></div></div>
      <div class="rounded-xl border border-border bg-card p-4 text-center animate-pulse"><div class="h-6 w-12 bg-muted mx-auto rounded"></div></div>
      <div class="rounded-xl border border-border bg-card p-4 text-center animate-pulse"><div class="h-6 w-12 bg-muted mx-auto rounded"></div></div>
      <div class="rounded-xl border border-border bg-card p-4 text-center animate-pulse"><div class="h-6 w-12 bg-muted mx-auto rounded"></div></div>
      <div class="rounded-xl border border-border bg-card p-4 text-center animate-pulse"><div class="h-6 w-12 bg-muted mx-auto rounded"></div></div>
      <div class="rounded-xl border border-border bg-card p-4 text-center animate-pulse"><div class="h-6 w-12 bg-muted mx-auto rounded"></div></div>
    </div>
  </div>

  <!-- Webhook Routing Summary -->
  <div class="mb-8 rounded-2xl border border-border bg-card p-5 shadow-sm space-y-4">
    <div class="flex items-center justify-between border-b border-border pb-3">
      <div class="flex items-center gap-2">
        <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-primary/10 text-primary">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
        </div>
        <div>
          <h3 class="text-sm font-bold text-foreground">Webhook Routing Summary</h3>
          <p class="text-xs text-muted-foreground">Multi-webhook load distribution</p>
        </div>
      </div>
    </div>

    <div id="webhook-summary-container" class="grid grid-cols-1 sm:grid-cols-2 gap-3">
      <div class="p-3 rounded-xl border border-border bg-background space-y-1">
        <span class="text-[11px] font-medium text-muted-foreground">Configured Channels</span>
        <p id="wh-sum-channels" class="text-xs font-bold text-foreground">Loading...</p>
      </div>
      <div class="p-3 rounded-xl border border-border bg-background space-y-1">
        <span class="text-[11px] font-medium text-muted-foreground">Primary Webhook</span>
        <p id="wh-sum-primary" class="text-xs font-bold text-foreground">Loading...</p>
      </div>
      <div class="col-span-1 sm:col-span-2 p-3 rounded-xl border border-border bg-background space-y-1">
        <div class="flex items-center justify-between text-[11px] font-medium text-muted-foreground">
          <span>Combined Active Remaining Capacity</span>
          <span id="wh-sum-capacity-count" class="font-bold text-foreground">---</span>
        </div>
        <div class="h-2 w-full rounded-full bg-muted overflow-hidden">
          <div id="wh-sum-capacity-bar" class="h-full rounded-full bg-primary transition-all duration-300" style="width: 0%"></div>
        </div>
      </div>
    </div>
  </div>

  <!-- Section: Posting Schedules & Automation -->
  <div class="mb-8 rounded-2xl border border-border bg-card p-5 shadow-sm space-y-4">
    <div class="flex flex-wrap items-center justify-between border-b border-border pb-3 gap-3">
      <div class="flex items-center gap-2">
        <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-pink-500/10 text-pink-500">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
        </div>
        <div>
          <div class="flex items-center gap-2">
            <h3 class="text-sm font-bold text-foreground">Posting Schedules & Automation</h3>
            <span id="sched-live-status" class="inline-flex items-center gap-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/30 px-2.5 py-0.5 text-[11px] font-bold text-emerald-600 dark:text-emerald-400">
              <span class="h-1.5 w-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
              <span>Window Active</span>
            </span>
            <span id="sched-next-countdown" class="inline-flex items-center gap-1 rounded-full bg-primary/10 border border-primary/20 px-2.5 py-0.5 text-[11px] font-semibold text-primary">
              Next Pin: ~2 mins
            </span>
          </div>
          <p class="text-xs text-muted-foreground">Manage multi-schedule posting engine for this account</p>
        </div>
      </div>
      <div class="flex flex-wrap items-center gap-2">
        <button id="btn-add-schedule" class="inline-flex items-center gap-1 rounded-lg border border-border bg-background px-2.5 py-1.5 text-xs font-semibold text-foreground hover:bg-muted transition-all">+ Add Posting Schedule</button>
        <button id="btn-sync-missing" class="inline-flex items-center gap-1 rounded-lg border border-border bg-background px-2.5 py-1.5 text-xs font-semibold text-foreground hover:bg-muted transition-all">Sync Missing</button>
        <button id="btn-refresh-schedules" class="inline-flex items-center gap-1 rounded-lg border border-border bg-background px-2.5 py-1.5 text-xs font-semibold text-foreground hover:bg-muted transition-all">Refresh</button>
      </div>
    </div>

    <div id="sched-pace-analyzer-box" class="p-3.5 rounded-xl border border-primary/20 bg-primary/5 space-y-1">
      <div class="flex items-center justify-between text-xs">
        <span class="font-bold text-primary flex items-center gap-1.5">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
          <span>Cadence & Daily Limit Pacing Analyzer</span>
        </span>
        <span id="sched-pace-val" class="font-bold text-foreground">Calculating pacing...</span>
      </div>
      <p id="sched-pace-desc" class="text-[11px] text-muted-foreground">Pacing is optimized to distribute posts evenly across your configured posting window.</p>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-xs">
        <thead>
          <tr class="text-left border-b border-border text-muted-foreground">
            <th class="p-2.5 font-semibold">Schedule & Status</th>
            <th class="p-2.5 font-semibold">Channel</th>
            <th class="p-2.5 font-semibold">Window & Frequency</th>
            <th class="p-2.5 font-semibold">FastCron Token</th>
            <th class="p-2.5 font-semibold text-right">Actions</th>
          </tr>
        </thead>
        <tbody id="account-schedules-rows"></tbody>
      </table>
    </div>
  </div>

  <!-- FastCron API Tokens Registry Card -->
  <div class="mb-8 rounded-2xl border border-border bg-card p-5 shadow-sm space-y-4">
    <div class="flex flex-wrap items-center justify-between border-b border-border pb-3 gap-3">
      <div class="flex items-center gap-2">
        <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-amber-500/10 text-amber-500">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        </div>
        <div>
          <h3 class="text-sm font-bold text-foreground">FastCron API Tokens</h3>
          <p class="text-xs text-muted-foreground">Workspace token registry for multi-token scheduling</p>
        </div>
      </div>
      <button id="btn-add-token" class="inline-flex items-center gap-1 rounded-lg border border-border bg-background px-2.5 py-1.5 text-xs font-semibold text-foreground hover:bg-muted transition-all">
        + Add Token
      </button>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-xs">
        <thead>
          <tr class="text-left border-b border-border text-muted-foreground">
            <th class="p-2.5 font-semibold">Name</th>
            <th class="p-2.5 font-semibold">Masked Token</th>
            <th class="p-2.5 font-semibold">Default</th>
            <th class="p-2.5 font-semibold text-right">Actions</th>
          </tr>
        </thead>
        <tbody id="tokens-table-rows"></tbody>
      </table>
    </div>
  </div>

  <!-- MODAL: Add/Edit Schedule -->
  <dialog id="schedule-modal" class="rounded-2xl border border-border bg-card p-6 shadow-2xl w-[540px] max-w-full backdrop:bg-black/60 backdrop:backdrop-blur-sm max-h-[90vh] overflow-y-auto">
    <form id="schedule-form" class="space-y-4 text-xs">
      <div class="flex items-center justify-between border-b border-border pb-3">
        <h3 id="schedule-modal-title" class="text-base font-bold text-foreground">Add Posting Schedule</h3>
        <button type="button" id="btn-close-sched-modal" class="rounded-lg p-1 text-muted-foreground hover:bg-muted hover:text-foreground">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>

      <input type="hidden" id="f-sched-id" />

      <div>
        <label class="block font-medium text-muted-foreground mb-1">Schedule Label</label>
        <input id="f-sched-label" type="text" placeholder="e.g. Main Daytime Schedule" class="w-full rounded-xl border border-border bg-background py-2 px-3 text-xs text-foreground focus:border-primary focus:outline-none" required />
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <div>
          <label class="block font-medium text-muted-foreground mb-1">Webhook Channel</label>
          <select id="f-channel" class="w-full rounded-xl border border-border bg-background py-2 px-3 text-xs text-foreground focus:border-primary focus:outline-none"></select>
        </div>
        <div>
          <label class="block font-medium text-muted-foreground mb-1">FastCron API Token</label>
          <select id="f-sched-token-select" class="w-full rounded-xl border border-border bg-background py-2 px-3 text-xs text-foreground focus:border-primary focus:outline-none">
            <option value="">Default (Workspace / Env)</option>
            <option value="custom">Custom Token...</option>
          </select>
        </div>
      </div>

      <div id="f-sched-custom-token-box" class="hidden p-3 rounded-xl border border-border bg-muted/40 space-y-1">
        <label class="block font-medium text-muted-foreground mb-1">Custom FastCron Token (Write-Only Override)</label>
        <input id="f-fc-token" type="password" placeholder="Enter custom FastCron API token" class="w-full rounded-xl border border-border bg-background py-2 px-3 text-xs text-foreground focus:border-primary focus:outline-none font-mono" autocomplete="off" />
        <div id="fc-token-status" class="text-[11px] text-muted-foreground"></div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <div>
          <label class="block font-medium text-muted-foreground mb-1">Timezone</label>
          <select id="f-sched-tz" class="w-full rounded-xl border border-border bg-background py-2 px-3 text-xs text-foreground focus:border-primary focus:outline-none">
            <option value="UTC">UTC</option>
            <option value="America/New_York">America/New_York (EST/EDT)</option>
            <option value="America/Chicago">America/Chicago (CST/CDT)</option>
            <option value="America/Denver">America/Denver (MST/MDT)</option>
            <option value="America/Los_Angeles">America/Los_Angeles (PST/PDT)</option>
            <option value="Europe/London">Europe/London (GMT/BST)</option>
            <option value="Europe/Paris">Europe/Paris (CET/CEST)</option>
            <option value="Asia/Tokyo">Asia/Tokyo (JST)</option>
            <option value="Australia/Sydney">Australia/Sydney (AEST/AEDT)</option>
          </select>
        </div>
        <div>
          <label class="block font-medium text-muted-foreground mb-1">Batch Size (Pins claimed / run)</label>
          <input id="f-sched-batch" type="number" min="1" max="10" value="1" class="w-full rounded-xl border border-border bg-background py-2 px-3 text-xs text-foreground focus:border-primary focus:outline-none" />
        </div>
      </div>

      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block font-medium text-muted-foreground mb-1">Window Start Time</label>
          <input id="f-sched-start" type="time" value="09:00" class="w-full rounded-xl border border-border bg-background py-2 px-3 text-xs text-foreground focus:border-primary focus:outline-none" />
        </div>
        <div>
          <label class="block font-medium text-muted-foreground mb-1">Window End Time</label>
          <input id="f-sched-end" type="time" value="21:00" class="w-full rounded-xl border border-border bg-background py-2 px-3 text-xs text-foreground focus:border-primary focus:outline-none" />
        </div>
      </div>

      <div>
        <label class="block font-medium text-muted-foreground mb-1">Posting Frequency / Interval</label>
        <select id="f-sched-interval-preset" class="w-full rounded-xl border border-border bg-background py-2 px-3 text-xs text-foreground focus:border-primary focus:outline-none">
          <option value="5">Every 5 Minutes (5 mins)</option>
          <option value="10">Every 10 Minutes (10 mins)</option>
          <option value="15">Every 15 Minutes (15 mins)</option>
          <option value="30">Every 30 Minutes (30 mins)</option>
          <option value="36">Every 36 Minutes (36 mins)</option>
          <option value="45">Every 45 Minutes (45 mins)</option>
          <option value="60">Every 1 Hour (60 mins)</option>
          <option value="120">Every 2 Hours (120 mins)</option>
          <option value="180">Every 3 Hours (180 mins)</option>
          <option value="240">Every 4 Hours (240 mins)</option>
          <option value="360">Every 6 Hours (360 mins)</option>
          <option value="720">Every 12 Hours (720 mins)</option>
          <option value="1440">Every 24 Hours (1440 mins)</option>
          <option value="custom">Custom Minutes...</option>
        </select>
      </div>

      <div id="f-sched-custom-interval-container" class="hidden">
        <label class="block font-medium text-muted-foreground mb-1">Custom Minutes Between Posts</label>
        <input id="f-sched-interval" type="number" min="1" max="1440" value="36" class="w-full rounded-xl border border-border bg-background py-2 px-3 text-xs text-foreground focus:border-primary focus:outline-none" />
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <div>
          <label class="block font-medium text-muted-foreground mb-1">Random Delay (minutes)</label>
          <input id="f-sched-delay" type="number" min="0" max="60" value="0" class="w-full rounded-xl border border-border bg-background py-2 px-3 text-xs text-foreground focus:border-primary focus:outline-none" />
        </div>
        <div>
          <label class="block font-medium text-muted-foreground mb-1">Pinning Started Date (optional)</label>
          <input id="f-sched-started" type="date" class="w-full rounded-xl border border-border bg-background py-2 px-3 text-xs text-foreground focus:border-primary focus:outline-none" />
        </div>
      </div>

      <div>
        <label class="block font-semibold text-foreground mb-1.5">Weekly Active Days</label>
        <div class="flex flex-wrap items-center gap-1.5" id="f-sched-days-group">
          <label class="inline-flex items-center gap-1 rounded-lg border border-border bg-background px-2.5 py-1 text-xs font-semibold text-foreground cursor-pointer hover:bg-muted">
            <input type="checkbox" value="Mon" class="f-sched-day-chk h-3.5 w-3.5 text-primary rounded" checked />
            <span>Mon</span>
          </label>
          <label class="inline-flex items-center gap-1 rounded-lg border border-border bg-background px-2.5 py-1 text-xs font-semibold text-foreground cursor-pointer hover:bg-muted">
            <input type="checkbox" value="Tue" class="f-sched-day-chk h-3.5 w-3.5 text-primary rounded" checked />
            <span>Tue</span>
          </label>
          <label class="inline-flex items-center gap-1 rounded-lg border border-border bg-background px-2.5 py-1 text-xs font-semibold text-foreground cursor-pointer hover:bg-muted">
            <input type="checkbox" value="Wed" class="f-sched-day-chk h-3.5 w-3.5 text-primary rounded" checked />
            <span>Wed</span>
          </label>
          <label class="inline-flex items-center gap-1 rounded-lg border border-border bg-background px-2.5 py-1 text-xs font-semibold text-foreground cursor-pointer hover:bg-muted">
            <input type="checkbox" value="Thu" class="f-sched-day-chk h-3.5 w-3.5 text-primary rounded" checked />
            <span>Thu</span>
          </label>
          <label class="inline-flex items-center gap-1 rounded-lg border border-border bg-background px-2.5 py-1 text-xs font-semibold text-foreground cursor-pointer hover:bg-muted">
            <input type="checkbox" value="Fri" class="f-sched-day-chk h-3.5 w-3.5 text-primary rounded" checked />
            <span>Fri</span>
          </label>
          <label class="inline-flex items-center gap-1 rounded-lg border border-border bg-background px-2.5 py-1 text-xs font-semibold text-foreground cursor-pointer hover:bg-muted">
            <input type="checkbox" value="Sat" class="f-sched-day-chk h-3.5 w-3.5 text-primary rounded" checked />
            <span>Sat</span>
          </label>
          <label class="inline-flex items-center gap-1 rounded-lg border border-border bg-background px-2.5 py-1 text-xs font-semibold text-foreground cursor-pointer hover:bg-muted">
            <input type="checkbox" value="Sun" class="f-sched-day-chk h-3.5 w-3.5 text-primary rounded" checked />
            <span>Sun</span>
          </label>
        </div>
      </div>

      <!-- Cadence Estimator Box -->
      <div id="sched-cadence-box" class="p-3 rounded-xl border border-primary/20 bg-primary/5 space-y-1">
        <div class="font-bold text-primary flex items-center gap-1">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
          <span>Pacing & FastCron Cadence Analyzer</span>
        </div>
        <p id="sched-cadence-text" class="text-[11px] text-muted-foreground">Calculating pacing...</p>
        <p id="sched-cadence-effective" class="text-[11px] font-semibold text-foreground">FastCron expression: every 36 minutes • Window & active days enforced server-side</p>
      </div>

      <!-- Edit Modal Integration Box (Admin only) -->
      <div id="sched-integration-box" class="hidden p-3.5 rounded-xl border border-border bg-muted/40 space-y-2.5">
        <div class="flex items-center justify-between">
          <span class="font-bold text-xs text-foreground flex items-center gap-1.5">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
            <span>Direct Cron & Webhook Integration</span>
          </span>
          <span class="text-[10px] text-muted-foreground font-mono">Admin Only</span>
        </div>

        <div>
          <label class="block text-[11px] font-medium text-muted-foreground mb-1">Schedule ID</label>
          <div class="flex items-center gap-1.5">
            <input id="sched-int-id" type="text" readonly class="w-full rounded-lg border border-border bg-background py-1 px-2 text-[11px] font-mono text-foreground select-all" />
            <button type="button" id="btn-copy-sched-id" class="rounded-lg border border-border bg-background px-2.5 py-1 text-[11px] font-medium hover:bg-muted">Copy</button>
          </div>
        </div>

        <div>
          <label class="block text-[11px] font-medium text-muted-foreground mb-1">Dispatch Token (dispatch_token)</label>
          <div class="flex items-center gap-1.5">
            <input id="sched-int-token" type="password" readonly class="w-full rounded-lg border border-border bg-background py-1 px-2 text-[11px] font-mono text-foreground select-all" />
            <button type="button" id="btn-toggle-reveal-token" class="rounded-lg border border-border bg-background px-2 py-1 text-[11px] font-medium hover:bg-muted">Reveal</button>
            <button type="button" id="btn-copy-sched-token" class="rounded-lg border border-border bg-background px-2.5 py-1 text-[11px] font-medium hover:bg-muted">Copy</button>
          </div>
        </div>

        <div>
          <label class="block text-[11px] font-medium text-muted-foreground mb-1">Provider-Agnostic Webhook URL (GET)</label>
          <div class="flex items-center gap-1.5">
            <input id="sched-int-url" type="text" readonly class="w-full rounded-lg border border-border bg-background py-1 px-2 text-[11px] font-mono text-foreground select-all" />
            <button type="button" id="btn-copy-sched-url" class="rounded-lg border border-border bg-background px-2.5 py-1 text-[11px] font-medium hover:bg-muted">Copy</button>
          </div>
        </div>
        <p class="text-[10px] text-muted-foreground italic">Provider-agnostic: works with any cron service or external trigger if FastCron is down.</p>
      </div>

      <div class="flex justify-end gap-2 border-t border-border pt-4">
        <button type="button" id="btn-cancel-sched" class="rounded-xl border border-border px-3.5 py-2 text-xs font-semibold text-muted-foreground hover:bg-muted hover:text-foreground">Cancel</button>
        <button type="submit" class="rounded-xl bg-primary px-3.5 py-2 text-xs font-semibold text-primary-foreground shadow hover:bg-primary/90">Save Schedule</button>
      </div>
    </form>
  </dialog>

  <!-- MODAL: Add FastCron Token -->
  <dialog id="token-modal" class="rounded-2xl border border-border bg-card p-6 shadow-2xl w-[420px] max-w-full backdrop:bg-black/60 backdrop:backdrop-blur-sm">
    <form id="token-form" class="space-y-4 text-xs">
      <div class="flex items-center justify-between border-b border-border pb-3">
        <h3 class="text-base font-bold text-foreground">Add FastCron API Token</h3>
        <button type="button" id="btn-close-token-modal" class="rounded-lg p-1 text-muted-foreground hover:bg-muted hover:text-foreground">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>

      <div id="token-modal-error" class="hidden rounded-xl border border-rose-500/30 bg-rose-500/10 p-3 text-xs text-rose-500"></div>

      <div>
        <label class="block font-medium text-muted-foreground mb-1">Token Name / Identifier</label>
        <input id="f-token-name" type="text" placeholder="e.g. Workspace FastCron" class="w-full rounded-xl border border-border bg-background py-2 px-3 text-xs text-foreground focus:border-primary focus:outline-none" required />
      </div>

      <div>
        <label class="block font-medium text-muted-foreground mb-1">FastCron API Token</label>
        <input id="f-token-val" type="password" placeholder="Enter FastCron API token" class="w-full rounded-xl border border-border bg-background py-2 px-3 text-xs text-foreground focus:border-primary focus:outline-none font-mono" required />
        <p class="text-[11px] text-muted-foreground mt-1">Encrypted before saving to database.</p>
      </div>

      <label class="flex items-center gap-2 font-medium text-foreground cursor-pointer">
        <input id="f-token-default" type="checkbox" class="h-4 w-4 rounded border-border text-primary" />
        <span>Set as default workspace token</span>
      </label>

      <div class="flex items-center justify-end gap-2 border-t border-border pt-4">
        <button type="button" id="btn-cancel-token" class="rounded-xl border border-border px-3.5 py-2 font-semibold text-muted-foreground hover:bg-muted hover:text-foreground">Cancel</button>
        <button type="submit" class="rounded-xl bg-primary px-3.5 py-2 font-semibold text-primary-foreground shadow hover:bg-primary/90">Save Token</button>
      </div>
    </form>
  </dialog>

  <!-- JSON Data Island -->
  <script id="schedules-data" type="application/json"></script>

  <!-- Section 4: Recent Account Pins Queue -->
  <div class="mb-8 space-y-3">
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-2">
        <h3 class="text-sm font-bold text-foreground tracking-wide uppercase">Recent Account Pins Queue</h3>
        <span id="pin-queue-count-badge" class="rounded-full bg-primary/10 px-2 py-0.5 text-[11px] font-semibold text-primary">0</span>
      </div>
      <a id="view-all-pins-link" href={`/accounts/pins?id=${id}`} class="text-xs font-semibold text-primary hover:underline flex items-center gap-1">
        <span>View all pins</span>
        <span>&rarr;</span>
      </a>
    </div>

    <!-- Compact Inline Filter Bar -->
    <div class="rounded-xl border border-border bg-card p-3 shadow-sm">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-2.5 text-xs">
        <div class="flex flex-wrap items-center gap-2 flex-1">
          <!-- Search Input -->
          <div class="relative flex-1 min-w-[160px] max-w-xs">
            <svg xmlns="http://www.w3.org/2000/svg" class="absolute left-2.5 top-1/2 h-3.5 w-3.5 -translate-y-1/2 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <input
              id="pin-search-input"
              type="text"
              placeholder="Search pin title..."
              class="w-full rounded-lg border border-border bg-background py-1.5 pl-8 pr-2 text-xs text-foreground placeholder:text-muted-foreground focus:border-primary focus:outline-none"
            />
          </div>

          <!-- Status Dropdown -->
          <select id="pin-status-select" class="rounded-lg border border-border bg-background py-1.5 px-2.5 text-xs text-foreground focus:border-primary focus:outline-none">
            <option value="all">All Statuses</option>
            <option value="pending">Pending</option>
            <option value="retrying">Retrying</option>
            <option value="posted">Posted</option>
            <option value="failed">Failed</option>
            <option value="processing">Processing</option>
          </select>

          <!-- Board Dropdown -->
          <select id="pin-board-select" class="rounded-lg border border-border bg-background py-1.5 px-2.5 text-xs text-foreground focus:border-primary focus:outline-none max-w-[160px]">
            <option value="all">All Boards</option>
          </select>

          <!-- Date Range -->
          <div class="flex items-center gap-1">
            <input id="pin-date-from" type="date" title="From date" class="rounded-lg border border-border bg-background py-1.5 px-2 text-xs text-foreground focus:border-primary focus:outline-none" />
            <span class="text-muted-foreground text-[10px]">-</span>
            <input id="pin-date-to" type="date" title="To date" class="rounded-lg border border-border bg-background py-1.5 px-2 text-xs text-foreground focus:border-primary focus:outline-none" />
          </div>

          <!-- Clear Filters -->
          <button id="pin-clear-filters-btn" class="hidden rounded-lg border border-border bg-muted/50 px-2.5 py-1.5 text-xs font-medium text-muted-foreground hover:bg-muted hover:text-foreground transition-all">
            Clear filters
          </button>
        </div>

        <!-- Showing Count -->
        <div id="pin-result-count" class="text-xs text-muted-foreground font-medium whitespace-nowrap">
          Showing 0 pins
        </div>
      </div>
    </div>

    <div id="account-pins-container">
      <div class="overflow-hidden rounded-xl border border-border bg-card p-6 text-center text-xs text-muted-foreground animate-pulse">
        Loading account pins history...
      </div>
    </div>
  </div>

  <!-- Section 5: Recent Account Execution Logs -->
  <div class="mb-8 space-y-3">
    <div class="flex items-center justify-between">
      <h3 class="text-sm font-bold text-foreground tracking-wide uppercase">Recent Execution Logs & Errors</h3>
      <a href="/logs" class="text-xs font-semibold text-primary hover:underline">View all system logs &rarr;</a>
    </div>

    <div id="account-logs-container">
      <div class="overflow-hidden rounded-xl border border-border bg-card p-6 text-center text-xs text-muted-foreground animate-pulse">
        Loading account activity logs...
      </div>
    </div>
  </div>



  <!-- MODAL: Edit Daily Limit -->
  <div id="edit-limit-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60 backdrop-blur-sm p-4" aria-modal="true" role="dialog">
    <div id="edit-limit-backdrop" class="fixed inset-0"></div>
    <div class="relative w-full max-w-sm rounded-2xl border border-border bg-card p-6 shadow-2xl space-y-4 z-10">
      <div class="flex items-center justify-between border-b border-border pb-3">
        <h3 class="text-base font-bold text-foreground">Edit Daily Limit</h3>
        <button id="close-limit-modal" class="rounded-lg p-1 text-muted-foreground hover:bg-muted hover:text-foreground">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>

      <div id="limit-modal-error" class="hidden rounded-xl border border-rose-500/30 bg-rose-500/10 p-3 text-xs text-rose-500"></div>

      <form id="limit-form" class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-muted-foreground mb-1">Max Pins Per Day (1–500)</label>
          <input id="limit-input-num" type="number" min="1" max="500" required class="w-full rounded-xl border border-border bg-background py-2 px-3 text-xs text-foreground focus:border-primary focus:outline-none" />
        </div>

        <div class="flex items-center justify-end gap-3 border-t border-border pt-4">
          <button type="button" id="cancel-limit-modal" class="rounded-xl border border-border px-4 py-2 text-xs font-medium text-muted-foreground hover:bg-muted hover:text-foreground">
            Cancel
          </button>
          <button type="submit" id="save-limit-btn" class="rounded-xl bg-primary px-4 py-2 text-xs font-semibold text-primary-foreground shadow hover:bg-primary/90">
            Save Limit
          </button>
        </div>
      </form>
    </div>
  </div>
</Layout>

<script>
  import { requireAuth } from '../../lib/auth';
  import {
    getAccountDetails,
    getAccountPinStats,
    getAccountPins,
    getAccountBoards,
    getAccountRecentLogs,
    getAccountWebhookSummary,
    getAccountWebhooks,
    createAccountWebhook,
    updateAccountWebhook,
    toggleAccountWebhookActive,
    setPrimaryWebhook,
    updateAccountSchedule,
    updateAccountScheduling,
    updateAccountDailyLimit,
    toggleAccountActive,
    createBoardViaWebhook,
  } from '../../lib/supabase';
  import { renderStatusBadge, formatDate, formatTime, renderEmptyStateHTML, escapeHtml } from '../../lib/ui-helpers';
  import type { Account, AccountPinStats, Pin, Log, AccountWebhook, Board } from '../../lib/types';

  let currentAccount: Account | null = null;
  let currentStats: AccountPinStats | null = null;
  let accountId: string = '';
  let activeAccountWebhooks: AccountWebhook[] = [];
  let accountBoards: Board[] = [];

  // Filter State
  let filterStatus = 'all';
  let filterBoard = 'all';
  let filterSearch = '';
  let filterDateFrom = '';
  let filterDateTo = '';
  let searchDebounceTimer: any = null;

  async function init() {
    const isAuth = await requireAuth();
    if (!isAuth) return;

    // Extract Account ID from URL query string or path
    const urlParams = new URLSearchParams(window.location.search);
    const queryId = urlParams.get('id');
    let pathId = '';
    const matches = window.location.pathname.match(/\/accounts\/([^/]+)/);
    if (matches && matches[1] && matches[1] !== 'pins' && matches[1] !== 'details') {
      pathId = matches[1];
    }

    accountId = queryId || pathId || 'acc-1';

    const displayElem = document.getElementById('display-account-id');
    if (displayElem) displayElem.textContent = accountId || '---';

    if (!accountId) return;

    // Update "View all pins" link to dedicated route
    const viewAllLink = document.getElementById('view-all-pins-link') as HTMLAnchorElement;
    if (viewAllLink && accountId) {
      viewAllLink.href = `/accounts/pins?id=${accountId}`;
    }

    // Read initial filters from URL params
    filterStatus = urlParams.get('status') || 'all';
    filterBoard = urlParams.get('board') || 'all';
    filterSearch = urlParams.get('q') || '';
    filterDateFrom = urlParams.get('from') || '';
    filterDateTo = urlParams.get('to') || '';

    // Initialize UI inputs from state
    initFilterInputs();
    setupFilterListeners();
    setupModalListeners();

    await loadAllData();
  }

  function initFilterInputs() {
    const statusSelect = document.getElementById('pin-status-select') as HTMLSelectElement;
    const searchInput = document.getElementById('pin-search-input') as HTMLInputElement;
    const dateFromInput = document.getElementById('pin-date-from') as HTMLInputElement;
    const dateToInput = document.getElementById('pin-date-to') as HTMLInputElement;

    if (statusSelect) statusSelect.value = filterStatus;
    if (searchInput) searchInput.value = filterSearch;
    if (dateFromInput) dateFromInput.value = filterDateFrom;
    if (dateToInput) dateToInput.value = filterDateTo;
  }

  function setupFilterListeners() {
    const statusSelect = document.getElementById('pin-status-select');
    const boardSelect = document.getElementById('pin-board-select');
    const searchInput = document.getElementById('pin-search-input');
    const dateFromInput = document.getElementById('pin-date-from');
    const dateToInput = document.getElementById('pin-date-to');
    const clearBtn = document.getElementById('pin-clear-filters-btn');

    statusSelect?.addEventListener('change', (e) => {
      filterStatus = (e.target as HTMLSelectElement).value;
      onFilterChange();
    });

    boardSelect?.addEventListener('change', (e) => {
      filterBoard = (e.target as HTMLSelectElement).value;
      onFilterChange();
    });

    searchInput?.addEventListener('input', (e) => {
      filterSearch = (e.target as HTMLInputElement).value;
      clearTimeout(searchDebounceTimer);
      searchDebounceTimer = setTimeout(() => {
        onFilterChange();
      }, 300);
    });

    dateFromInput?.addEventListener('change', (e) => {
      filterDateFrom = (e.target as HTMLInputElement).value;
      onFilterChange();
    });

    dateToInput?.addEventListener('change', (e) => {
      filterDateTo = (e.target as HTMLInputElement).value;
      onFilterChange();
    });

    clearBtn?.addEventListener('click', () => {
      filterStatus = 'all';
      filterBoard = 'all';
      filterSearch = '';
      filterDateFrom = '';
      filterDateTo = '';
      initFilterInputs();
      const boardSel = document.getElementById('pin-board-select') as HTMLSelectElement;
      if (boardSel) boardSel.value = 'all';
      onFilterChange();
    });
  }

  function syncFilterStateToURL() {
    const url = new URL(window.location.href);
    if (filterStatus && filterStatus !== 'all') url.searchParams.set('status', filterStatus);
    else url.searchParams.delete('status');

    if (filterBoard && filterBoard !== 'all') url.searchParams.set('board', filterBoard);
    else url.searchParams.delete('board');

    if (filterSearch && filterSearch.trim() !== '') url.searchParams.set('q', filterSearch.trim());
    else url.searchParams.delete('q');

    if (filterDateFrom) url.searchParams.set('from', filterDateFrom);
    else url.searchParams.delete('from');

    if (filterDateTo) url.searchParams.set('to', filterDateTo);
    else url.searchParams.delete('to');

    window.history.replaceState({}, '', url.toString());

    // Toggle clear filters button visibility
    const clearBtn = document.getElementById('pin-clear-filters-btn');
    const isFiltered = filterStatus !== 'all' || filterBoard !== 'all' || filterSearch !== '' || filterDateFrom !== '' || filterDateTo !== '';
    if (clearBtn) {
      if (isFiltered) clearBtn.classList.remove('hidden');
      else clearBtn.classList.add('hidden');
    }
  }

  async function onFilterChange() {
    syncFilterStateToURL();
    await loadRecentPins();
  }

  async function loadAllData() {
    try {
      const [acc, stats, boards, logs, whSummary] = await Promise.all([
        getAccountDetails(accountId),
        getAccountPinStats(accountId),
        getAccountBoards(accountId),
        getAccountRecentLogs(accountId, 10),
        getAccountWebhookSummary(accountId),
      ]);

      const whs = await getAccountWebhooks(accountId);
      activeAccountWebhooks = (whs || []).filter((w: any) => w.is_active);
      setupSchedulesListeners();
      await loadTokens();
      await loadSchedules();

      if (!acc) {
        document.getElementById('account-header-container')!.innerHTML = renderEmptyStateHTML(
          'Account Not Found',
          `Could not locate Pinterest account matching ID "${escapeHtml(accountId)}".`,
          'alert-circle'
        );
        return;
      }

      // Fresh DB data wins; preserve local-only fields that DB may not return
      currentAccount = {
        ...(currentAccount || {}),
        ...acc,
      };
      currentStats = stats;
      accountBoards = boards;

      populateBoardDropdown(boards);
      renderHeader(currentAccount);
      renderKPIs(stats, currentAccount);
      renderScheduling(currentAccount);
      renderWebhookSummary(whSummary);
      renderRecentLogs(logs);

      await loadRecentPins();
    } catch (err) {
      console.error('Error loading account details:', err);
    }
  }

  function populateBoardDropdown(boards: Board[]) {
    const boardSelect = document.getElementById('pin-board-select') as HTMLSelectElement;
    if (!boardSelect) return;

    boardSelect.innerHTML = `<option value="all">All Boards</option>` +
      boards.map((b) => `<option value="${escapeHtml(b.board_name)}">${escapeHtml(b.board_name)}</option>`).join('');

    if (filterBoard) {
      boardSelect.value = filterBoard;
    }
  }

  async function loadRecentPins() {
    const res = await getAccountPins({
      accountId,
      status: filterStatus,
      boardId: filterBoard,
      search: filterSearch,
      dateFrom: filterDateFrom,
      dateTo: filterDateTo,
      page: 1,
      pageSize: 10,
      sortBy: 'created_at',
      sortDir: 'desc',
    });

    renderRecentPins(res.pins, res.totalCount);
  }

  function renderPinStatusBadgeWithRetry(pin: Pin) {
    if (pin.status === 'posted') {
      return `<span class="inline-flex items-center rounded-full bg-emerald-500/10 border border-emerald-500/20 px-2 py-0.5 text-[11px] font-semibold text-emerald-600 dark:text-emerald-400">Posted</span>`;
    }
    if (pin.status === 'processing') {
      return `<span class="inline-flex items-center rounded-full bg-blue-500/10 border border-blue-500/20 px-2 py-0.5 text-[11px] font-semibold text-blue-500">Processing</span>`;
    }
    if (pin.status === 'pending' && (pin.retry_count || 0) > 0) {
      let retryCountdownText = '';
      if (pin.next_retry_at) {
        const diffMs = new Date(pin.next_retry_at).getTime() - Date.now();
        if (diffMs > 0) {
          const mins = Math.max(1, Math.round(diffMs / 60000));
          retryCountdownText = ` (${mins}m)`;
        }
      }
      return `<span class="inline-flex items-center gap-1 rounded-full bg-amber-500/10 border border-amber-500/30 px-2 py-0.5 text-[11px] font-semibold text-amber-600 dark:text-amber-400" title="${escapeHtml(pin.last_failure_reason || 'Retrying soon')}">
        <span>Retrying${retryCountdownText}</span>
      </span>`;
    }
    if (pin.status === 'pending') {
      return `<span class="inline-flex items-center rounded-full bg-amber-500/10 border border-amber-500/20 px-2 py-0.5 text-[11px] font-semibold text-amber-600 dark:text-amber-400">Pending</span>`;
    }
    if (pin.status === 'failed') {
      return `<span class="inline-flex items-center rounded-full bg-rose-500/10 border border-rose-500/20 px-2 py-0.5 text-[11px] font-semibold text-rose-500 cursor-help" title="${escapeHtml(pin.last_failure_reason || 'Execution failed')}">Failed</span>`;
    }
    return renderStatusBadge(pin.status);
  }

  function renderKPIs(stats: AccountPinStats, acc: Account) {
    const container = document.getElementById('kpis-grid-container');
    if (!container) return;

    container.innerHTML = `
      <div class="rounded-xl border border-border bg-card p-3 text-center space-y-1">
        <span class="text-[11px] font-semibold text-muted-foreground">Total Posts</span>
        <p class="text-xl font-bold text-foreground">${stats.total}</p>
      </div>
      <div class="rounded-xl border border-amber-500/20 bg-amber-500/5 p-3 text-center space-y-1">
        <span class="text-[11px] font-semibold text-amber-600 dark:text-amber-400">Pending</span>
        <p class="text-xl font-bold text-amber-600 dark:text-amber-400">${stats.pending}</p>
      </div>
      <div class="rounded-xl border border-amber-500/30 bg-amber-500/10 p-3 text-center space-y-1">
        <span class="text-[11px] font-semibold text-amber-600 dark:text-amber-400">Retrying</span>
        <p class="text-xl font-bold text-amber-600 dark:text-amber-400">${stats.retrying || 0}</p>
      </div>
      <div class="rounded-xl border border-emerald-500/20 bg-emerald-500/5 p-3 text-center space-y-1">
        <span class="text-[11px] font-semibold text-emerald-600 dark:text-emerald-400">Posted</span>
        <p class="text-xl font-bold text-emerald-600 dark:text-emerald-400">${stats.posted}</p>
      </div>
      <div class="rounded-xl border border-rose-500/20 bg-rose-500/5 p-3 text-center space-y-1">
        <span class="text-[11px] font-semibold text-rose-500">Failed</span>
        <p class="text-xl font-bold text-rose-500">${stats.failed}</p>
      </div>
      <div class="rounded-xl border ${stats.remainingToday > 0 ? 'border-primary/20 bg-primary/5' : 'border-amber-500/20 bg-amber-500/5'} p-3 text-center space-y-1">
        <span class="text-[11px] font-semibold ${stats.remainingToday > 0 ? 'text-primary' : 'text-amber-600 dark:text-amber-400'}">Remaining Today</span>
        <p class="text-xl font-bold ${stats.remainingToday > 0 ? 'text-primary' : 'text-amber-600 dark:text-amber-400'}">${stats.remainingToday}</p>
        <span class="text-[10px] text-muted-foreground block truncate">${stats.remainingToday} of ${acc.max_pins_per_day} left today</span>
      </div>
      <div class="rounded-xl border border-border bg-card p-3 text-center space-y-1">
        <span class="text-[11px] font-semibold text-muted-foreground">Daily Limit</span>
        <p class="text-xl font-bold text-foreground">${acc.max_pins_per_day}</p>
      </div>
      <div class="rounded-xl border border-border bg-card p-3 text-center space-y-1">
        <span class="text-[11px] font-semibold text-muted-foreground">Boards</span>
        <p class="text-xl font-bold text-foreground">${acc.boards_count || 0}</p>
      </div>
    `;
  }

  function renderHeader(acc: Account) {
    const headerContainer = document.getElementById('account-header-container');
    if (!headerContainer) return;

    const initials = (acc.account_name || 'AC').slice(0, 2).toUpperCase();

    headerContainer.innerHTML = `
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div class="flex items-center gap-3.5">
          <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-primary/10 text-primary font-bold text-base shadow-sm flex-shrink-0">
            ${escapeHtml(initials)}
          </div>
          <div>
            <div class="flex items-center gap-2.5">
              <h1 class="text-xl font-bold text-foreground">${escapeHtml(acc.account_name)}</h1>
              ${renderStatusBadge(acc.is_active)}
            </div>
