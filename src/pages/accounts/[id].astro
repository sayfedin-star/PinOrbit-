  function showFeedbackBanner(message: string, type: 'success' | 'error' = 'success') {
    const banner = document.getElementById('account-feedback-banner');
    const text = document.getElementById('account-feedback-text');
    if (!banner || !text) return;

    text.textContent = message;
    if (type === 'error') {
      banner.className = 'mb-4 rounded-xl border border-rose-500/30 bg-rose-500/10 p-3.5 text-xs text-rose-500 flex items-center justify-between shadow-sm';
    } else {
      banner.className = 'mb-4 rounded-xl border border-emerald-500/30 bg-emerald-500/10 p-3.5 text-xs text-emerald-600 dark:text-emerald-400 flex items-center justify-between shadow-sm';
    }
    banner.classList.remove('hidden');

    setTimeout(() => {
      banner.classList.add('hidden');
    }, 5000);
  }

  document.getElementById('close-account-feedback')?.addEventListener('click', () => {
    document.getElementById('account-feedback-banner')?.classList.add('hidden');
  });

  // Unified Single Source of Truth UI State Sync
  function refreshAccountUI(updatedPayload?: Partial<Account>) {
    if (updatedPayload && currentAccount) {
      Object.assign(currentAccount, updatedPayload);
    }

    if (currentAccount) {
      renderHeader(currentAccount);
      if (currentStats) {
        renderKPIs(currentStats, currentAccount);
      }
      renderScheduling(currentAccount);
    }
  }

  async function handleToggleActive() {
    if (!currentAccount) return;
    try {
      const newStatus = !currentAccount.is_active;
      const res = await toggleAccountActive(currentAccount.id, newStatus);
      if (res.data || res.success) {
        const updated = res.data || { ...currentAccount, is_active: newStatus };
        refreshAccountUI(updated);
        showFeedbackBanner(`Account status updated to ${newStatus ? 'Active' : 'Inactive'}.`, 'success');
        loadAllData();
      } else if (res.error) {
        showFeedbackBanner(res.error, 'error');
      }
    } catch (err: any) {
      showFeedbackBanner(err.message || 'Failed to toggle account status', 'error');
    }
  }

  function openLimitModal() {
    if (!currentAccount) return;
    const modal = document.getElementById('edit-limit-modal');
    const input = document.getElementById('limit-input-num') as HTMLInputElement;
    if (input) input.value = String(currentAccount.max_pins_per_day);
    modal?.classList.remove('hidden');
    modal?.classList.add('flex');
  }

  function closeLimitModal() {
    document.getElementById('edit-limit-modal')?.classList.add('hidden');
  }

  function setupModalListeners() {
    // Global Event Delegation for dynamic header & card buttons
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement | null;
      if (!target) return;

      const createBoardBtn = target.closest('#btn-open-create-board-modal');
      if (createBoardBtn) {
        e.preventDefault();
        window.location.href = '/boards';
        return;
      }

      const webhooksBtn = target.closest('#open-webhooks-modal-btn');
      if (webhooksBtn) {
        e.preventDefault();
        window.location.href = '/accounts';
        return;
      }

      const limitBtn = target.closest('#btn-edit-limit');
      if (limitBtn) {
        e.preventDefault();
        openLimitModal();
        return;
      }
    });

    document.getElementById('close-limit-modal')?.addEventListener('click', closeLimitModal);
    document.getElementById('cancel-limit-modal')?.addEventListener('click', closeLimitModal);
    document.getElementById('edit-limit-backdrop')?.addEventListener('click', closeLimitModal);

    document.getElementById('limit-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!currentAccount) return;

      const numInput = document.getElementById('limit-input-num') as HTMLInputElement;
      const limit = parseInt(numInput.value, 10);

      if (isNaN(limit) || limit < 1 || limit > 500) {
        alert('Daily limit must be between 1 and 500');
        return;
      }

      const res = await updateAccountDailyLimit(currentAccount.id, limit);
      if (res.success || res.data) {
        closeLimitModal();
        showFeedbackBanner(`Daily pin limit set to ${limit} pins/day.`, 'success');
        refreshAccountUI(res.data || { max_pins_per_day: limit });
        loadAllData();
      } else {
        alert(res.error || 'Failed to update limit');
      }
    });
  }

  // ===== FastCron Tokens Registry wiring =====
  let workspaceTokens: any[] = [];

  async function loadTokens() {
    const rowsEl = document.getElementById('tokens-table-rows');
    const tokenSelect = document.getElementById('f-sched-token-select') as HTMLSelectElement | null;
    try {
      const r = await fetch('/api/tokens');
      const d = await r.json();
      workspaceTokens = Array.isArray(d) ? d : [];
    } catch {
      workspaceTokens = [];
    }

    if (rowsEl) {
      rowsEl.innerHTML = workspaceTokens.length === 0
        ? '<tr><td colspan="4" class="p-3 text-center text-muted-foreground">No custom FastCron tokens registered. Using default environment token.</td></tr>'
        : workspaceTokens.map((t: any) =>
            '<tr class="border-b border-border hover:bg-muted/30 transition-colors">' +
            '<td class="p-2.5 font-semibold text-foreground">' + escapeHtml(t.name) + '</td>' +
            '<td class="p-2.5 font-mono text-muted-foreground">' + escapeHtml(t.token_masked || '••••') + '</td>' +
            '<td class="p-2.5">' + (t.is_default ? '<span class="inline-flex items-center rounded-full bg-emerald-500/10 px-2 py-0.5 text-[10px] font-bold text-emerald-500">Default</span>' : '<button type="button" data-token-act="set-default" data-tid="' + t.id + '" class="text-primary hover:underline text-[11px] font-medium">Set Default</button>') + '</td>' +
            '<td class="p-2.5 text-right"><button type="button" data-token-act="delete" data-tid="' + t.id + '" class="text-rose-500 hover:underline text-[11px] font-semibold">Delete</button></td>' +
            '</tr>'
          ).join('');
    }

    if (tokenSelect) {
      const currentVal = tokenSelect.value;
      const defaultToken = workspaceTokens.find((t: any) => t.is_default);
      const defaultOptLabel = defaultToken
        ? `Workspace default (${escapeHtml(defaultToken.name)} • ${escapeHtml(defaultToken.token_masked || '••••')})`
        : 'Env fallback (no stored token)';
      let optsHtml = '<option value="">' + defaultOptLabel + '</option>';
      for (const t of workspaceTokens) {
        optsHtml += '<option value="' + t.id + '">' + escapeHtml(t.name) + ' (' + escapeHtml(t.token_masked || '••••') + ')' + (t.is_default ? ' [Default]' : '') + '</option>';
      }
      optsHtml += '<option value="custom">Custom token…</option>';
      tokenSelect.innerHTML = optsHtml;
      if (currentVal) tokenSelect.value = currentVal;
    }
  }

  async function tokenAction(id: string, act: string) {
    if (act === 'set-default') {
      const r = await fetch('/api/tokens/' + id, { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ is_default: true }) });
      const d = await r.json();
      if (!r.ok) { showFeedbackBanner(d.error || JSON.stringify(d), 'error'); return; }
      showFeedbackBanner('Default FastCron token updated.', 'success');
      await loadTokens();
      await loadSchedules();
    } else if (act === 'delete') {
      if (!confirm('Delete this FastCron token from registry?')) return;
      const r = await fetch('/api/tokens/' + id, { method: 'DELETE' });
      const d = await r.json();
      if (!r.ok) { showFeedbackBanner(d.error || JSON.stringify(d), 'error'); return; }
      showFeedbackBanner('FastCron token deleted.', 'success');
      await loadTokens();
      await loadSchedules();
    }
  }

