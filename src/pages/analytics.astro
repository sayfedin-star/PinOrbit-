---
import Layout from '../layouts/Layout.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import KPIStatCard from '../components/ui/KPIStatCard.astro';
import EmptyState from '../components/ui/EmptyState.astro';

export const prerender = false;
---

<Layout title="Pinterest Analytics" description="Multi-tenant Pinterest performance analytics, ranked top pins, and reach metrics.">
  <!-- Page Header -->
  <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between mb-6">
    <SectionHeader
      title="Pinner Analytics"
      description="Aggregated reach, engagement metrics, and ranked pin performance."
    />

    <!-- Account Selector & Window Toggles -->
    <div class="flex flex-wrap items-center gap-3 self-start sm:self-auto">
      <!-- Account Dropdown -->
      <div class="relative">
        <select
          id="analytics-account-select"
          class="rounded-xl border border-border bg-card px-3.5 py-2 text-xs font-semibold text-foreground shadow-sm focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
        >
          <option value="">Loading accounts...</option>
        </select>
      </div>

      <!-- Time Window Tabs -->
      <div class="inline-flex rounded-xl border border-border bg-card p-1 shadow-sm" id="window-toggles">
        <button
          data-window="7"
          class="window-btn rounded-lg px-3 py-1 text-xs font-semibold text-muted-foreground transition-all hover:text-foreground"
        >
          7D
        </button>
        <button
          data-window="14"
          class="window-btn rounded-lg px-3 py-1 text-xs font-semibold text-muted-foreground transition-all hover:text-foreground"
        >
          14D
        </button>
        <button
          data-window="30"
          class="window-btn active rounded-lg bg-primary px-3 py-1 text-xs font-semibold text-primary-foreground shadow-sm transition-all"
        >
          30D
        </button>
      </div>

      <!-- Refresh Button -->
      <button
        id="refresh-analytics-btn"
        class="inline-flex items-center justify-center rounded-xl border border-border bg-card p-2 text-muted-foreground shadow-sm hover:bg-muted hover:text-foreground transition-all"
        title="Refresh Analytics"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/>
          <path d="M3 3v5h5"/>
          <path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16"/>
          <path d="M16 21h5v-5"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Operational Ingestion Sync Status Bar -->
  <div class="mb-6 rounded-2xl border border-border bg-card p-4 shadow-sm">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
      <div class="flex items-center gap-3">
        <div class="flex h-8 w-8 items-center justify-center rounded-xl bg-primary/10 text-primary">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 2v4"/><path d="M12 18v4"/><path d="m4.93 4.93 2.83 2.83"/><path d="m16.24 16.24 2.83 2.83"/><path d="M2 12h4"/><path d="M18 12h4"/><path d="m4.93 19.07 2.83-2.83"/><path d="m16.24 7.76 2.83-2.83"/>
          </svg>
        </div>
        <div>
          <div class="flex items-center gap-2">
            <h3 class="text-xs font-bold text-foreground">Make.com Proxy Pipeline</h3>
            <span id="sync-status-badge" class="rounded-full bg-emerald-500/10 px-2 py-0.5 text-[10px] font-semibold text-emerald-600 dark:text-emerald-400">
              Operational
            </span>
            <span id="cache-status-badge" class="rounded-full bg-blue-500/10 px-2 py-0.5 text-[10px] font-semibold text-blue-600 dark:text-blue-400">
              Edge Cache: Direct
            </span>
          </div>
          <p id="sync-status-detail" class="text-[11px] text-muted-foreground mt-0.5">
            Ingestion source: Pinterest API v5 (Daily batch sync at 04:00 UTC)
          </p>
        </div>
      </div>

      <div class="flex items-center gap-4 text-xs text-muted-foreground">
        <div>
          <span class="font-medium">Last Ingested:</span>
          <span id="sync-last-time" class="font-semibold text-foreground ml-1">---</span>
        </div>
        <div>
          <span class="font-medium">Data Readiness:</span>
          <span id="sync-data-readiness" class="font-semibold text-emerald-500 ml-1">READY</span>
        </div>
      </div>
    </div>
  </div>

  <!-- 4 Primary KPI Cards -->
  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4 mb-8">
    <div id="kpi-impressions">
      <KPIStatCard
        title="Total Impressions"
        value="---"
        subtitle="Organic pin impressions"
        iconName="activity"
        color="primary"
      />
    </div>
    <div id="kpi-engagements">
      <KPIStatCard
        title="Total Engagements"
        value="---"
        subtitle="0.00% engagement rate"
        iconName="users"
        color="emerald"
      />
    </div>
    <div id="kpi-pin-clicks">
      <KPIStatCard
        title="Pin Clicks"
        value="---"
        subtitle="0.00% pin click rate"
        iconName="clock"
        color="amber"
      />
    </div>
    <div id="kpi-outbound-clicks">
      <KPIStatCard
        title="Outbound & Saves"
        value="---"
        subtitle="0 outbound • 0 saves"
        iconName="check-circle"
        color="slate"
      />
    </div>
  </div>

  <!-- Top Pins Section -->
  <div class="rounded-2xl border border-border bg-card shadow-sm mb-8 overflow-hidden">
    <!-- Header with Sort Tabs -->
    <div class="flex flex-col gap-3 border-b border-border p-5 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h3 class="text-base font-bold text-foreground">Top Performing Pins</h3>
        <p class="text-xs text-muted-foreground">Ranked pin performance across 5 canonical sort metrics</p>
      </div>

      <!-- Sort Modes Switcher Tabs -->
      <div class="inline-flex flex-wrap rounded-xl border border-border bg-background p-1 shadow-sm" id="sort-toggles">
        <button
          data-sort="IMPRESSION"
          class="sort-tab active rounded-lg bg-primary px-3 py-1.5 text-xs font-semibold text-primary-foreground shadow-sm transition-all"
        >
          Impressions
        </button>
        <button
          data-sort="OUTBOUND_CLICK"
          class="sort-tab rounded-lg px-3 py-1.5 text-xs font-semibold text-muted-foreground transition-all hover:text-foreground"
        >
          Outbound Clicks
        </button>
        <button
          data-sort="SAVE"
          class="sort-tab rounded-lg px-3 py-1.5 text-xs font-semibold text-muted-foreground transition-all hover:text-foreground"
        >
          Saves
        </button>
        <button
          data-sort="ENGAGEMENT"
          class="sort-tab rounded-lg px-3 py-1.5 text-xs font-semibold text-muted-foreground transition-all hover:text-foreground"
        >
          Engagements
        </button>
        <button
          data-sort="PIN_CLICK"
          class="sort-tab rounded-lg px-3 py-1.5 text-xs font-semibold text-muted-foreground transition-all hover:text-foreground"
        >
          Pin Clicks
        </button>
      </div>
    </div>

    <!-- Ranked Top Pins Table -->
    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs">
        <thead class="border-b border-border bg-muted/40 text-[11px] font-bold uppercase tracking-wider text-muted-foreground">
          <tr>
            <th class="py-3.5 px-4 w-16 text-center">Rank</th>
            <th class="py-3.5 px-4 min-w-[280px]">Pin Details</th>
            <th class="py-3.5 px-4 text-right">Impressions</th>
            <th class="py-3.5 px-4 text-right">Engagements</th>
            <th class="py-3.5 px-4 text-right">Outbound Clicks</th>
            <th class="py-3.5 px-4 text-right">Saves</th>
            <th class="py-3.5 px-4 text-right">Pin Clicks</th>
            <th class="py-3.5 px-4 text-center">Status</th>
          </tr>
        </thead>
        <tbody id="top-pins-tbody" class="divide-y divide-border">
          <tr>
            <td colspan="8" class="py-12 text-center text-muted-foreground">
              Loading ranked top pins...
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</Layout>

<script>
  let currentWorkspaceId = '';
  let currentConnectionId = '';
  let currentWindowDays = 30;
  let currentSortBy = 'IMPRESSION';
  let accountsList = [];

  // Helper: Format number with commas
  function formatNum(n) {
    if (n === undefined || n === null) return '0';
    return Number(n).toLocaleString();
  }

  // Helper: Format percent
  function formatPct(r) {
    if (r === undefined || r === null) return '0.00%';
    return (Number(r) * 100).toFixed(2) + '%';
  }

  // Initialize Page
  async function initAnalytics() {
    // Read workspace cookie or fallback
    const match = document.cookie.match(/(^|;)\s*pinorbit_workspace_id=([^;]+)/);
    currentWorkspaceId = match ? match[2] : '';

    await fetchAccounts();
    setupEventListeners();
  }

  // Fetch connected accounts for dropdown
  async function fetchAccounts() {
    try {
      const res = await fetch('/api/admin/bootstrap'); // or direct client fetch
    } catch {}

    // Fetch accounts directly
    try {
      const resp = await fetch(`/api/accounts?workspace_id=${currentWorkspaceId}`);
      if (resp.ok) {
        const data = await resp.json();
        accountsList = data.accounts || [];
      }
    } catch {
      accountsList = [];
    }

    const select = document.getElementById('analytics-account-select');
    if (!select) return;

    if (!accountsList || accountsList.length === 0) {
      select.innerHTML = '<option value="">No Pinterest accounts connected</option>';
      renderEmptyState('No Pinterest accounts found in this workspace. Connect an account in Accounts tab.');
      return;
    }

    select.innerHTML = accountsList
      .map(
        (acc) =>
          `<option value="${acc.id}" ${acc.id === currentConnectionId ? 'selected' : ''}>${acc.account_name} ${acc.is_active ? '' : '(Revoked)'}</option>`
      )
      .join('');

    currentConnectionId = accountsList[0].id;
    loadAnalyticsData();
  }

  // Load Overview KPIs and Top Pins
  async function loadAnalyticsData() {
    if (!currentConnectionId) return;

    // Load Overview
    try {
      const ovResp = await fetch(
        `/api/analytics/overview?workspace_id=${encodeURIComponent(currentWorkspaceId)}&connection_id=${encodeURIComponent(currentConnectionId)}&window_days=${currentWindowDays}`
      );
      const cacheStatus = ovResp.headers.get('X-Cache-Status') || 'HIT';
      
      const cacheBadge = document.getElementById('cache-status-badge');
      if (cacheBadge) {
        cacheBadge.textContent = `Edge Cache: ${cacheStatus}`;
        cacheBadge.className = `rounded-full px-2 py-0.5 text-[10px] font-semibold ${
          cacheStatus === 'HIT'
            ? 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400'
            : 'bg-blue-500/10 text-blue-600 dark:text-blue-400'
        }`;
      }

      if (ovResp.ok) {
        const result = await ovResp.json();
        if (result.success && result.data) {
          renderKPIs(result.data);
        }
      }
    } catch (e) {
      console.error('Error fetching overview KPIs:', e);
    }

    // Load Top Pins
    await loadTopPins();
  }

  // Render KPI values
  function renderKPIs(data) {
    // Total Impressions
    const impEl = document.querySelector('#kpi-impressions .text-3xl');
    if (impEl) impEl.textContent = formatNum(data.impressions);

    // Total Engagements
    const engEl = document.querySelector('#kpi-engagements .text-3xl');
    const engSubEl = document.querySelector('#kpi-engagements p');
    if (engEl) engEl.textContent = formatNum(data.engagements);
    if (engSubEl) engSubEl.textContent = `${formatPct(data.engagementRate)} engagement rate`;

    // Pin Clicks
    const clickEl = document.querySelector('#kpi-pin-clicks .text-3xl');
    const clickSubEl = document.querySelector('#kpi-pin-clicks p');
    if (clickEl) clickEl.textContent = formatNum(data.pinClicks);
    if (clickSubEl) clickSubEl.textContent = `${formatPct(data.pinClickRate)} pin click rate`;

    // Outbound & Saves
    const outEl = document.querySelector('#kpi-outbound-clicks .text-3xl');
    const outSubEl = document.querySelector('#kpi-outbound-clicks p');
    if (outEl) outEl.textContent = formatNum((data.outboundClicks || 0) + (data.saves || 0));
    if (outSubEl) outSubEl.textContent = `${formatNum(data.outboundClicks)} outbound • ${formatNum(data.saves)} saves`;

    // Last Ingested Time
    const lastSyncEl = document.getElementById('sync-last-time');
    if (lastSyncEl) {
      lastSyncEl.textContent = data.lastIngestedAt
        ? new Date(data.lastIngestedAt).toLocaleDateString(undefined, {
            month: 'short',
            day: 'numeric',
            hour: '2-digit',
            minute: '2-digit',
          })
        : 'Never';
    }
  }

  // Load Top Pins
  async function loadTopPins() {
    const tbody = document.getElementById('top-pins-tbody');
    if (!tbody) return;

    tbody.innerHTML = `
      <tr>
        <td colspan="8" class="py-12 text-center text-muted-foreground animate-pulse">
          Loading top pins for ${currentSortBy}...
        </td>
      </tr>
    `;

    try {
      const resp = await fetch(
        `/api/analytics/top-pins?workspace_id=${encodeURIComponent(currentWorkspaceId)}&connection_id=${encodeURIComponent(currentConnectionId)}&sort_by=${currentSortBy}&limit=50`
      );

      if (!resp.ok) {
        tbody.innerHTML = `
          <tr>
            <td colspan="8" class="py-8 text-center text-rose-500">
              Failed to load top pins.
            </td>
          </tr>
        `;
        return;
      }

      const result = await resp.json();
      const pins = result.data || [];

      if (pins.length === 0) {
        tbody.innerHTML = `
          <tr>
            <td colspan="8" class="py-12 text-center text-muted-foreground">
              No top pins recorded yet for this sort mode. Daily sync will populate ranked pins.
            </td>
          </tr>
        `;
        return;
      }

      tbody.innerHTML = pins
        .map((pin) => {
          const rank = pin.rank_position;
          const rankBadgeClass =
            rank === 1
              ? 'bg-amber-500/20 text-amber-600 dark:text-amber-400 font-black border-amber-500/30'
              : rank <= 3
              ? 'bg-primary/10 text-primary font-bold'
              : 'bg-muted text-muted-foreground font-semibold';

          return `
            <tr class="hover:bg-muted/30 transition-colors">
              <td class="py-3 px-4 text-center">
                <span class="inline-flex h-6 w-6 items-center justify-center rounded-lg border text-xs ${rankBadgeClass}">
                  ${rank}
                </span>
              </td>
              <td class="py-3 px-4">
                <div class="flex items-center gap-3">
                  ${
                    pin.image_url
                      ? `<img src="${pin.image_url}" alt="Pin thumbnail" class="h-10 w-10 rounded-lg object-cover border border-border flex-shrink-0" />`
                      : `<div class="h-10 w-10 rounded-lg bg-muted flex items-center justify-center text-muted-foreground flex-shrink-0 text-[10px]">No img</div>`
                  }
                  <div class="min-w-0 max-w-xs">
                    <p class="font-semibold text-foreground truncate">${pin.title || 'Untitled Pin'}</p>
                    <p class="text-[11px] text-muted-foreground truncate">ID: ${pin.pin_id}</p>
                    ${
                      pin.destination_url
                        ? `<a href="${pin.destination_url}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-[10px] text-primary hover:underline truncate max-w-full">
                            <span class="truncate">${pin.destination_url}</span>
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                          </a>`
                        : ''
                    }
                  </div>
                </div>
              </td>
              <td class="py-3 px-4 text-right font-bold text-foreground">${formatNum(pin.impressions)}</td>
              <td class="py-3 px-4 text-right font-medium text-foreground">
                ${formatNum(pin.engagement)}
                <span class="block text-[10px] text-muted-foreground">${formatPct(pin.engagement_rate)}</span>
              </td>
              <td class="py-3 px-4 text-right font-medium text-foreground">
                ${formatNum(pin.outbound_clicks)}
                <span class="block text-[10px] text-muted-foreground">${formatPct(pin.outbound_click_rate)}</span>
              </td>
              <td class="py-3 px-4 text-right font-medium text-foreground">
                ${formatNum(pin.saves)}
                <span class="block text-[10px] text-muted-foreground">${formatPct(pin.save_rate)}</span>
              </td>
              <td class="py-3 px-4 text-right font-medium text-foreground">
                ${formatNum(pin.pin_clicks)}
                <span class="block text-[10px] text-muted-foreground">${formatPct(pin.pin_click_rate)}</span>
              </td>
              <td class="py-3 px-4 text-center">
                <span class="inline-flex rounded-full bg-emerald-500/10 px-2 py-0.5 text-[10px] font-semibold text-emerald-600 dark:text-emerald-400">
                  READY
                </span>
              </td>
            </tr>
          `;
        })
        .join('');
    } catch (e) {
      console.error('Error fetching top pins:', e);
    }
  }

  function renderEmptyState(msg) {
    const tbody = document.getElementById('top-pins-tbody');
    if (tbody) {
      tbody.innerHTML = `
        <tr>
          <td colspan="8" class="py-12 text-center text-muted-foreground">
            ${msg}
          </td>
        </tr>
      `;
    }
  }

  // Setup Event Handlers
  function setupEventListeners() {
    // Account select change
    const accSelect = document.getElementById('analytics-account-select');
    if (accSelect) {
      accSelect.addEventListener('change', (e) => {
        currentConnectionId = e.target.value;
        loadAnalyticsData();
      });
    }

    // Window Toggles
    const windowButtons = document.querySelectorAll('.window-btn');
    windowButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        windowButtons.forEach((b) => {
          b.classList.remove('active', 'bg-primary', 'text-primary-foreground', 'shadow-sm');
          b.classList.add('text-muted-foreground');
        });
        btn.classList.add('active', 'bg-primary', 'text-primary-foreground', 'shadow-sm');
        btn.classList.remove('text-muted-foreground');
        currentWindowDays = parseInt(btn.getAttribute('data-window') || '30', 10);
        loadAnalyticsData();
      });
    });

    // Sort Tabs
    const sortTabs = document.querySelectorAll('.sort-tab');
    sortTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        sortTabs.forEach((t) => {
          t.classList.remove('active', 'bg-primary', 'text-primary-foreground', 'shadow-sm');
          t.classList.add('text-muted-foreground');
        });
        tab.classList.add('active', 'bg-primary', 'text-primary-foreground', 'shadow-sm');
        tab.classList.remove('text-muted-foreground');
        currentSortBy = tab.getAttribute('data-sort') || 'IMPRESSION';
        loadTopPins();
      });
    });

    // Refresh button
    const refreshBtn = document.getElementById('refresh-analytics-btn');
    if (refreshBtn) {
      refreshBtn.addEventListener('click', () => {
        loadAnalyticsData();
      });
    }
  }

  document.addEventListener('DOMContentLoaded', initAnalytics);
  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    initAnalytics();
  }
</script>
