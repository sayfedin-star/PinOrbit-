---
import Layout from '../layouts/Layout.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
---

<Layout title="Page Not Found" description="The requested resource could not be found.">
  <div class="flex flex-col items-center justify-center py-16 text-center space-y-4">
    <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-primary/10 text-primary font-bold text-xl">
      404
    </div>
    <h1 class="text-2xl font-bold text-foreground">Page Not Found</h1>
    <p class="text-xs text-muted-foreground max-w-sm">
      The page or account details route you are trying to access does not exist or has been moved.
    </p>

    <div class="flex items-center gap-3 pt-2">
      <a
        href="/dashboard"
        class="inline-flex items-center gap-2 rounded-xl bg-primary px-4 py-2 text-xs font-semibold text-primary-foreground shadow hover:bg-primary/90 transition-all"
      >
        <span>Return to Dashboard</span>
      </a>
      <a
        href="/accounts"
        class="inline-flex items-center gap-2 rounded-xl border border-border bg-card px-4 py-2 text-xs font-semibold text-foreground hover:bg-muted transition-all"
      >
        <span>View Accounts</span>
      </a>
    </div>
  </div>
</Layout>

<script>
  // Client-side fallback check for dynamic route aliases
  function checkFallback() {
    const path = window.location.pathname;
    if (path.startsWith('/accounts/') && path !== '/accounts/' && path !== '/accounts') {
      // Re-route to account details page
      const accountId = path.split('/accounts/')[1]?.split('/')[0]?.split('?')[0];
      if (accountId && accountId !== '[id]') {
        window.location.href = `/accounts/${accountId}`;
      }
    }
  }
  checkFallback();
</script>
