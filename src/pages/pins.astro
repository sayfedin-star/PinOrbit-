---
import Layout from '../layouts/Layout.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
---

<Layout title="Pins Management" description="All recipe pins synced from Google Sheets pending execution or already published.">
  <SectionHeader
    title="Pins Queue & History"
    description="All recipe pins synced from Google Sheets pending execution or already published."
  />

  <!-- Filter & Search Control Bar -->
  <div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <!-- Filter Tabs -->
    <div id="filter-tabs-container" class="inline-flex rounded-lg border border-border bg-card p-1 text-xs font-medium">
      <button
        data-filter="all"
        class="filter-btn rounded-md px-3.5 py-1.5 transition-colors bg-primary text-primary-foreground font-semibold"
      >
        All (...)
      </button>
      <button
        data-filter="pending"
        class="filter-btn rounded-md px-3.5 py-1.5 text-muted-foreground hover:text-foreground transition-colors"
      >
        Pending (...)
      </button>
      <button
        data-filter="posted"
        class="filter-btn rounded-md px-3.5 py-1.5 text-muted-foreground hover:text-foreground transition-colors"
      >
        Posted (...)
      </button>
      <button
        data-filter="failed"
        class="filter-btn rounded-md px-3.5 py-1.5 text-muted-foreground hover:text-foreground transition-colors"
      >
        Failed (...)
      </button>
    </div>

    <!-- Search Input -->
    <div class="relative w-full sm:w-72">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-muted-foreground"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
      </svg>
      <input
        id="pin-search"
        type="text"
        placeholder="Search titles, boards or accounts..."
        aria-label="Search pins by title, board, or account"
        class="w-full rounded-lg border border-border bg-card py-2 pl-9 pr-4 text-xs text-foreground placeholder:text-muted-foreground focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
      />
    </div>
  </div>

  <div id="pins-container">
    <div class="overflow-hidden rounded-xl border border-border bg-card p-12 text-center text-xs text-muted-foreground animate-pulse">
      Loading pins queue...
    </div>
  </div>
</Layout>

<script>
  import { requireAuth } from '../lib/auth';
  import { getPins } from '../lib/supabase';
  import { renderStatusBadge, formatDate, renderEmptyStateHTML, escapeHtml } from '../lib/ui-helpers';
  import type { Pin } from '../lib/types';

  let allPins: Pin[] = [];
  let currentFilter = 'all';
  let currentSearch = '';

  async function init() {
    const isAuth = await requireAuth();
    if (!isAuth) return;
    await loadPins();
  }

  async function loadPins() {
    const container = document.getElementById('pins-container');
    if (!container) return;

    try {
      allPins = await getPins('all');

      if (!allPins || allPins.length === 0) {
        container.innerHTML = renderEmptyStateHTML(
          'No Pins Found',
          'New rows uploaded to Google Sheets will sync into Supabase pins table.',
          'inbox'
        );
        updateFilterCounts(0, 0, 0, 0);
        return;
      }

      // Update Filter button count labels
      const totalCount = allPins.length;
      const pendingCount = allPins.filter((p) => p.status === 'pending').length;
      const postedCount = allPins.filter((p) => p.status === 'posted').length;
      const failedCount = allPins.filter((p) => p.status === 'failed').length;

      updateFilterCounts(totalCount, pendingCount, postedCount, failedCount);

      // Render base table structure
      container.innerHTML = `
        <div class="overflow-hidden rounded-xl border border-border bg-card shadow-sm">
          <div class="overflow-x-auto">
            <table class="w-full text-left text-sm">
              <thead class="border-b border-border bg-muted/50 text-xs font-semibold uppercase tracking-wider text-muted-foreground">
                <tr>
                  <th class="px-6 py-3.5">Pin Title & Details</th>
                  <th class="px-6 py-3.5">Account</th>
                  <th class="px-6 py-3.5">Target Board</th>
                  <th class="px-6 py-3.5">Status</th>
                  <th class="px-6 py-3.5">Created Date</th>
                  <th class="px-6 py-3.5">Posted Date</th>
                </tr>
              </thead>
              <tbody id="pins-table-body" class="divide-y divide-border">
                ${allPins.map((pin) => renderPinRow(pin)).join('')}
                <tr id="no-matching-pins" class="hidden">
                  <td colspan="6" class="p-8 text-center text-xs text-muted-foreground">
                    No pins match your current search query or status filter.
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      `;

      setupEventListeners();
    } catch (err) {
      console.error('Failed to load pins client-side:', err);
      container.innerHTML = renderEmptyStateHTML(
        'Error Loading Pins',
        'Could not fetch pins queue. Please try refreshing.',
        'alert-circle'
      );
    }
  }

  function renderPinRow(pin: Pin): string {
    const titleLower = (pin.title || '').toLowerCase();
    const accountLower = (pin.account_name || '').toLowerCase();
    const boardLower = (pin.board_name || '').toLowerCase();

    return `
      <tr
        class="pin-row transition-colors hover:bg-muted/40"
        data-status="${pin.status}"
        data-title="${escapeHtml(titleLower)}"
        data-account="${escapeHtml(accountLower)}"
        data-board="${escapeHtml(boardLower)}"
      >
        <td class="px-6 py-4">
          <div class="flex items-center gap-3.5">
            <img
              src="${escapeHtml(pin.image_url)}"
              alt="${escapeHtml(pin.title)}"
              class="h-12 w-12 rounded-lg object-cover border border-border bg-muted flex-shrink-0"
              onerror="this.src='https://images.unsplash.com/photo-1495521821757-a1efb6729352?auto=format&fit=crop&w=150&q=80'"
            />
            <div class="max-w-xs sm:max-w-md">
              <p class="font-semibold text-foreground truncate" title="${escapeHtml(pin.title)}">${escapeHtml(pin.title)}</p>
              ${
                pin.link
                  ? `
                <a
                  href="${escapeHtml(pin.link)}"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-xs text-primary hover:underline flex items-center gap-1 mt-0.5"
                >
                  <span class="truncate">${escapeHtml(pin.link)}</span>
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                </a>
              `
                  : ''
              }
            </div>
          </div>
        </td>
        <td class="px-6 py-4 font-medium text-foreground">
          ${escapeHtml(pin.account_name || 'Unassigned')}
        </td>
        <td class="px-6 py-4 text-muted-foreground">
          <span class="rounded bg-muted/60 px-2 py-1 text-xs font-medium">
            ${escapeHtml(pin.board_name || 'Unassigned')}
          </span>
        </td>
        <td class="px-6 py-4">
          ${renderStatusBadge(pin.status)}
        </td>
        <td class="px-6 py-4 text-xs text-muted-foreground whitespace-nowrap">
          ${formatDate(pin.created_at)}
        </td>
        <td class="px-6 py-4 text-xs text-muted-foreground whitespace-nowrap">
          ${pin.posted_at ? formatDate(pin.posted_at) : '-'}
        </td>
      </tr>
    `;
  }

  function updateFilterCounts(total: number, pending: number, posted: number, failed: number) {
    const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
    filterBtns.forEach((btn) => {
      const type = btn.getAttribute('data-filter');
      if (type === 'all') btn.innerText = `All (${total})`;
      if (type === 'pending') btn.innerText = `Pending (${pending})`;
      if (type === 'posted') btn.innerText = `Posted (${posted})`;
      if (type === 'failed') btn.innerText = `Failed (${failed})`;
    });
  }

  function applyFilters() {
    const rows = document.querySelectorAll<HTMLTableRowElement>('.pin-row');
    const noMatchRow = document.getElementById('no-matching-pins');

    let matchCount = 0;
    rows.forEach((row) => {
      const status = row.getAttribute('data-status') || '';
      const title = row.getAttribute('data-title') || '';
      const account = row.getAttribute('data-account') || '';
      const board = row.getAttribute('data-board') || '';

      const matchesStatus = currentFilter === 'all' || status === currentFilter;
      const matchesSearch =
        !currentSearch ||
        title.includes(currentSearch) ||
        account.includes(currentSearch) ||
        board.includes(currentSearch);

      if (matchesStatus && matchesSearch) {
        row.style.display = '';
        matchCount++;
      } else {
        row.style.display = 'none';
      }
    });

    if (noMatchRow) {
      if (matchCount === 0 && rows.length > 0) {
        noMatchRow.classList.remove('hidden');
      } else {
        noMatchRow.classList.add('hidden');
      }
    }
  }

  function setupEventListeners() {
    const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
    const searchInput = document.getElementById('pin-search') as HTMLInputElement | null;

    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        filterBtns.forEach((b) => {
          b.classList.remove('bg-primary', 'text-primary-foreground', 'font-semibold');
          b.classList.add('text-muted-foreground');
        });
        btn.classList.add('bg-primary', 'text-primary-foreground', 'font-semibold');
        btn.classList.remove('text-muted-foreground');

        currentFilter = btn.getAttribute('data-filter') || 'all';
        applyFilters();
      });
    });

    searchInput?.addEventListener('input', (e) => {
      currentSearch = (e.target as HTMLInputElement).value.toLowerCase().trim();
      applyFilters();
    });
  }

  init();
</script>
