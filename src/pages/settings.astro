</Layout>

<script>
  // Sync radio preferences with localStorage theme
  const savedTheme = localStorage.getItem('theme') || 'system';
  const radios = document.querySelectorAll<HTMLInputElement>('input[name="theme-preference"]');
  radios.forEach(r => {
    if (r.value === savedTheme) {
      r.checked = true;
    }
    r.addEventListener('change', () => {
      if (r.checked) {
        if (r.value === 'system') {
          localStorage.removeItem('theme');
          const isSysDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.classList.toggle('dark', isSysDark);
        } else {
          localStorage.setItem('theme', r.value);
          document.documentElement.classList.toggle('dark', r.value === 'dark');
        }
      }
    });
  });

  // Retention & Recovery Form Logic
  const retentionForm = document.getElementById('retention-settings-form') as HTMLFormElement | null;
  const daysInput = document.getElementById('retention-posted-days') as HTMLInputElement | null;
  const timeoutInput = document.getElementById('processing-timeout-minutes') as HTMLInputElement | null;
  const saveBtn = document.getElementById('btn-save-retention') as HTMLButtonElement | null;
  const statusMsg = document.getElementById('retention-status-msg');
  const defaultBadge = document.getElementById('retention-default-badge');

  function checkRetentionDirty() {
    if (!daysInput || !timeoutInput || !saveBtn) return;
    const initialDays = daysInput.getAttribute('data-initial-value') || '30';
    const initialTimeout = timeoutInput.getAttribute('data-initial-value') || '45';

    const isDirty = daysInput.value !== initialDays || timeoutInput.value !== initialTimeout;
    saveBtn.disabled = !isDirty;
  }

  daysInput?.addEventListener('input', checkRetentionDirty);
  timeoutInput?.addEventListener('input', checkRetentionDirty);

  retentionForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!daysInput || !timeoutInput || !saveBtn || !retentionForm) return;

    const days = parseInt(daysInput.value, 10);
    const timeout = parseInt(timeoutInput.value, 10);

    if (isNaN(days) || days < 1 || days > 365) {
      if (statusMsg) {
        statusMsg.className = 'rounded-xl p-3 text-xs font-semibold bg-rose-500/10 text-rose-500 border border-rose-500/20';
        statusMsg.textContent = 'Posted pins retention must be between 1 and 365 days.';
        statusMsg.classList.remove('hidden');
      }
      return;
    }

    if (isNaN(timeout) || timeout < 5 || timeout > 240) {
      if (statusMsg) {
        statusMsg.className = 'rounded-xl p-3 text-xs font-semibold bg-rose-500/10 text-rose-500 border border-rose-500/20';
        statusMsg.textContent = 'Processing orphan timeout must be between 5 and 240 minutes.';
        statusMsg.classList.remove('hidden');
      }
      return;
    }

    const workspaceId = retentionForm.getAttribute('data-workspace-id');
    saveBtn.disabled = true;
    const origText = saveBtn.textContent;
    saveBtn.textContent = 'Saving...';

    if (statusMsg) statusMsg.classList.add('hidden');

    try {
      const res = await fetch('/api/settings/retention', {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          workspace_id: workspaceId,
          retention_posted_days: days,
          processing_timeout_minutes: timeout,
        }),
      });

      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Failed to save settings');

      daysInput.setAttribute('data-initial-value', String(data.retention_posted_days));
      timeoutInput.setAttribute('data-initial-value', String(data.processing_timeout_minutes));
      daysInput.value = String(data.retention_posted_days);
      timeoutInput.value = String(data.processing_timeout_minutes);

      defaultBadge?.classList.add('hidden');

      if (statusMsg) {
        statusMsg.className = 'rounded-xl p-3 text-xs font-semibold bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20';
        statusMsg.textContent = 'Retention & recovery settings saved successfully.';
        statusMsg.classList.remove('hidden');
        setTimeout(() => {
          statusMsg.classList.add('hidden');
        }, 4000);
      }
    } catch (err: any) {
      if (statusMsg) {
        statusMsg.className = 'rounded-xl p-3 text-xs font-semibold bg-rose-500/10 text-rose-500 border border-rose-500/20';
        statusMsg.textContent = err.message || 'Error updating retention settings';
        statusMsg.classList.remove('hidden');
      }
      saveBtn.disabled = false;
    } finally {
      saveBtn.textContent = origText;
      checkRetentionDirty();
    }
  });
</script>
