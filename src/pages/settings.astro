            <input
              type="number"
              id="processing-timeout-minutes"
              name="processing_timeout_minutes"
              min="5"
              max="240"
              value={retentionSettings.processing_timeout_minutes}
              data-initial-value={retentionSettings.processing_timeout_minutes}
              class="w-full rounded-xl border border-border bg-background px-4 py-2.5 text-xs font-semibold text-foreground focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
              required
