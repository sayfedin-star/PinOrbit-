---
import Layout from '../layouts/Layout.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import { getActiveWorkspaceId, getWorkspaces } from '../lib/workspaces';

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect('/login?redirect=/settings');
}

const supabase = Astro.locals.supabase;
const activeWorkspaceId = getActiveWorkspaceId(Astro.cookies);
const allWorkspaces = await getWorkspaces(Astro.cookies, Astro.request, Astro.response?.headers);
const currentWorkspace = allWorkspaces.find(w => w.id === activeWorkspaceId) || allWorkspaces[0];

// Fetch memberships for this workspace
let members: Array<{ id: string; user_id: string; role: string; created_at: string; email?: string }> = [];
let currentRole = 'member';

if (supabase && currentWorkspace) {
  try {
    const { data: memberData } = await supabase
      .from('workspace_memberships')
      .select('id, user_id, role, created_at')
      .eq('workspace_id', currentWorkspace.id);

    if (memberData && memberData.length > 0) {
      members = memberData.map((m: any) => ({
        ...m,
        email: m.user_id === user.id ? user.email : `User (${m.user_id.slice(0, 8)}...)`,
      }));

      const myMem = memberData.find((m: any) => m.user_id === user.id);
      if (myMem) {
        currentRole = myMem.role;
      }
    } else {
      // Fallback display
      members = [
        {
          id: 'mem-self',
          user_id: user.id,
          role: 'owner',
          created_at: currentWorkspace.created_at || new Date().toISOString(),
          email: user.email || 'Admin',
        },
      ];
      currentRole = 'owner';
    }
  } catch (err) {
    console.warn('Error fetching workspace memberships:', err);
    members = [
      {
        id: 'mem-self',
        user_id: user.id,
        role: 'owner',
        created_at: currentWorkspace?.created_at || new Date().toISOString(),
        email: user.email || 'Admin',
      },
    ];
    currentRole = 'owner';
  }
}

// Fetch retention settings for current workspace
let retentionSettings = { retention_posted_days: 30, processing_timeout_minutes: 45, is_default: true };
if (supabase && currentWorkspace) {
  try {
    const { data: retData } = await supabase
      .from('workspace_retention_settings')
      .select('retention_posted_days, processing_timeout_minutes')
      .eq('workspace_id', currentWorkspace.id)
      .maybeSingle();

    if (retData) {
      retentionSettings = {
        retention_posted_days: retData.retention_posted_days ?? 30,
        processing_timeout_minutes: retData.processing_timeout_minutes ?? 45,
        is_default: false,
      };
    }
  } catch (err) {
    console.warn('Error fetching retention settings:', err);
  }
}
---

<Layout title="Workspace Settings" description="Manage workspace details, team memberships, quick links, and system preferences.">
  <div class="space-y-8 max-w-5xl">
    <SectionHeader
      title="Workspace Settings"
      description="Configure workspace profile, member roles, security quick-links, and UI preferences."
    />

    <!-- Card 1: Workspace Profile & Team Members -->
    <div class="rounded-2xl border border-border bg-card p-6 shadow-sm space-y-6">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-border/60 pb-5">
        <div>
          <div class="flex items-center gap-2.5">
            <h3 class="text-base font-bold text-foreground">{currentWorkspace?.name || 'Workspace'}</h3>
            <span class="rounded-full bg-primary/10 border border-primary/20 px-2.5 py-0.5 text-xs font-bold text-primary uppercase tracking-wider">
              {currentRole}
            </span>
          </div>
          <p class="text-xs text-muted-foreground mt-1">
            Workspace ID: <span class="font-mono text-foreground font-semibold">{currentWorkspace?.id || '—'}</span>
          </p>
        </div>
        <div class="flex items-center gap-2 text-xs text-muted-foreground">
          <span>Created:</span>
          <span class="font-mono text-foreground">{currentWorkspace?.created_at ? new Date(currentWorkspace.created_at).toLocaleDateString() : '—'}</span>
        </div>
      </div>

      <!-- Members List -->
      <div class="space-y-3">
        <div class="flex items-center justify-between">
          <h4 class="text-xs font-bold uppercase tracking-wider text-muted-foreground">Workspace Members</h4>
          <span class="text-xs font-semibold text-muted-foreground">{members.length} {members.length === 1 ? 'member' : 'members'}</span>
        </div>

        <div class="overflow-x-auto rounded-xl border border-border bg-muted/20">
          <table class="w-full text-left text-xs">
            <thead class="border-b border-border/60 bg-muted/40 text-[10px] uppercase font-bold text-muted-foreground tracking-wider">
              <tr>
                <th class="py-2.5 px-4">Member</th>
                <th class="py-2.5 px-4 text-center">Role</th>
                <th class="py-2.5 px-4 text-right">Joined</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-border/40 font-medium">
              {members.map((m) => (
                <tr class="hover:bg-muted/30 transition-colors">
                  <td class="py-3 px-4 flex items-center gap-2.5">
                    <div class="h-7 w-7 rounded-full bg-primary/15 border border-primary/30 flex items-center justify-center font-bold text-primary text-xs shrink-0">
                      {m.email ? m.email.slice(0, 2).toUpperCase() : 'U'}
                    </div>
                    <div class="min-w-0">
                      <span class="font-semibold text-foreground block truncate">{m.email}</span>
                      <span class="text-[10px] font-mono text-muted-foreground truncate block">{m.user_id}</span>
                    </div>
                  </td>
                  <td class="py-3 px-4 text-center">
                    <span class={`inline-flex items-center rounded-md px-2 py-0.5 text-[10px] font-bold uppercase ${
                      m.role === 'owner' 
                        ? 'bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20' 
                        : m.role === 'admin'
                        ? 'bg-blue-500/10 text-blue-600 dark:text-blue-400 border border-blue-500/20'
                        : 'bg-muted text-muted-foreground border border-border'
                    }`}>
                      {m.role}
                    </span>
                  </td>
                  <td class="py-3 px-4 text-right font-mono text-muted-foreground text-[11px]">
                    {m.created_at ? new Date(m.created_at).toLocaleDateString() : '—'}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Card 2: Retention & Recovery -->
    <div class="rounded-2xl border border-border bg-card p-6 shadow-sm space-y-6" id="retention-settings-card">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-border/60 pb-5">
        <div class="flex items-start gap-3">
          <div class="h-10 w-10 rounded-xl bg-primary/10 border border-primary/20 text-primary flex items-center justify-center text-lg shrink-0 mt-0.5 shadow-sm">
            🗄️
          </div>
          <div>
            <div class="flex items-center gap-2.5">
              <h3 class="text-base font-bold text-foreground">Retention & Recovery</h3>
              <span id="retention-default-badge" class={`rounded-full bg-amber-500/10 border border-amber-500/20 px-2.5 py-0.5 text-xs font-semibold text-amber-600 dark:text-amber-400 ${retentionSettings.is_default ? '' : 'hidden'}`}>
                Using safe defaults (30 / 45)
              </span>
            </div>
            <p class="text-xs text-muted-foreground mt-1">
              Per-workspace cleanup & self-healing thresholds — see ARCHITECTURE.md decision log
