              name="retention_posted_days"
              min="1"
              max="365"
              value={retentionSettings.retention_posted_days}
              data-initial-value={retentionSettings.retention_posted_days}
              class="w-full rounded-xl border border-border bg-background px-4 py-2.5 text-xs font-semibold text-foreground focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
              required
            />
            <p class="text-[11px] text-muted-foreground">
              Posted pins older than this are purged by cleanup-retention.
            </p>
          </div>

          <div class="space-y-2">
            <label for="processing-timeout-minutes" class="block text-xs font-bold uppercase tracking-wider text-foreground">
              Processing orphan timeout (minutes)
