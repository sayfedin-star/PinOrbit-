      <form id="retention-settings-form" class="space-y-6" data-workspace-id={currentWorkspace?.id}>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="space-y-2">
            <label for="retention-posted-days" class="block text-xs font-bold uppercase tracking-wider text-foreground">
              Posted pins retention (days)
