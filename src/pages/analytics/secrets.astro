---
import Layout from '../../layouts/Layout.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';

export const prerender = false;
---

<Layout title="Ingest Secrets — Pinterest Analytics" description="Manage global and workspace-scoped webhook ingestion secrets for Make.com scenarios.">
  <div class="max-w-4xl mx-auto space-y-8 pb-12">
    <!-- Breadcrumb & Page Header -->
    <div class="space-y-2">
      <nav class="flex items-center gap-2 text-xs font-semibold text-muted-foreground">
        <a href="/analytics" class="hover:text-foreground transition-colors">Analytics</a>
        <span>/</span>
        <span class="text-foreground">Ingest Secrets</span>
      </nav>
      <SectionHeader
        title="Ingest Webhook Secrets"
        description="Secure authentication keys required by Make.com scenarios to dispatch data to PinOrbit ingestion pipelines."
      />
    </div>

    <!-- Active Secret Card -->
    <div class="rounded-2xl border border-border bg-card p-6 shadow-sm space-y-6">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
          <div class="flex items-center gap-3">
            <h3 class="text-base font-bold text-foreground">Active Ingest Secret</h3>
            <span id="secret-source-badge" class="rounded-full bg-primary/10 px-2.5 py-0.5 text-xs font-bold text-primary">
              Loading...
            </span>
          </div>
          <p class="text-xs text-muted-foreground mt-1">
            Pass this token in the <code class="font-mono text-[11px] font-bold text-foreground bg-muted/60 px-1 py-0.5 rounded">x-ingest-secret</code> header for all Make.com scenarios.
          </p>
        </div>

        <div class="flex items-center gap-2">
          <button
            type="button"
            id="open-regenerate-modal-btn"
            class="inline-flex items-center gap-2 rounded-xl bg-destructive/10 border border-destructive/20 px-3.5 py-2 text-xs font-bold text-destructive hover:bg-destructive/20 transition-all shadow-sm"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/>
              <path d="M3 3v5h5"/>
              <path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16"/>
              <path d="M16 21h5v-5"/>
            </svg>
            <span>🔄 Regenerate</span>
          </button>
        </div>
      </div>

      <!-- Secret Display Box -->
      <div class="flex items-center gap-3">
        <div class="relative flex-1">
          <input
            type="text"
            id="secret-display-input"
            readonly
            value="Loading secret..."
            class="w-full rounded-xl border border-border bg-muted/30 px-4 py-3 font-mono text-xs font-bold text-foreground focus:outline-none focus:ring-1 focus:ring-primary select-all"
          />
        </div>
        <button
          type="button"
          id="copy-secret-btn"
          class="inline-flex items-center gap-1.5 rounded-xl border border-border bg-card px-4 py-3 text-xs font-bold text-foreground hover:bg-muted transition-all shadow-sm active:scale-95"
        >
          <svg id="copy-icon" xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/>
            <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
          </svg>
          <span id="copy-btn-text">📋 Copy</span>
        </button>
      </div>

      <!-- Status alerts -->
      <div id="secrets-page-status" class="hidden rounded-xl p-3 text-xs font-semibold"></div>
    </div>

    <!-- Advanced Workspace Overrides Accordion -->
    <div class="rounded-2xl border border-border bg-card shadow-sm overflow-hidden">
      <button
        type="button"
        id="toggle-advanced-btn"
        class="w-full flex items-center justify-between p-6 text-left hover:bg-muted/10 transition-colors"
      >
        <div>
          <h4 class="text-sm font-bold text-foreground">Advanced: Workspace Override Management</h4>
          <p class="text-xs text-muted-foreground mt-0.5">Generate a dedicated secret for this workspace or fall back to the global default.</p>
        </div>
        <svg id="advanced-chevron" xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-muted-foreground transition-transform duration-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="m6 9 6 6 6-6"/>
        </svg>
      </button>

      <div id="advanced-section" class="hidden px-6 pb-6 pt-2 border-t border-border/60 space-y-4">
        <div class="text-xs text-muted-foreground">
          By default, all workspaces share the global ingest secret unless an override is created for tenant isolation.
        </div>

        <div class="flex flex-wrap items-center gap-3 pt-2">
          <button
            type="button"
            id="generate-override-btn"
            class="rounded-xl border border-border bg-card px-4 py-2 text-xs font-bold text-foreground hover:bg-muted transition-all shadow-sm"
          >
            🔑 Generate Workspace Override
          </button>
          <button
            type="button"
            id="remove-override-btn"
            class="hidden rounded-xl border border-destructive/30 bg-destructive/10 px-4 py-2 text-xs font-bold text-destructive hover:bg-destructive/20 transition-all shadow-sm"
          >
            🗑️ Remove Workspace Override
          </button>
        </div>
      </div>
    </div>

    <!-- Verbatim Make.com Integration Instructions Card (V20.1-4 & V20.1-5) -->
    <div class="rounded-2xl border border-border bg-card p-6 shadow-sm space-y-8">
      <div class="flex items-center gap-3 border-b border-border pb-4">
        <div class="flex h-8 w-8 items-center justify-center rounded-xl bg-primary/10 text-primary font-bold">
          ⚡
        </div>
        <div>
          <h3 class="text-sm font-bold text-foreground">Make.com Scenario Configuration Instructions</h3>
          <p class="text-xs text-muted-foreground">Copy-paste ready values and expressions for Make.com webhook headers and modules.</p>
        </div>
      </div>

      <!-- HTTP Header Card (Both Scenarios) -->
      <div class="space-y-3 rounded-xl border border-border/80 bg-muted/20 p-4">
        <h4 class="text-xs font-bold text-foreground uppercase tracking-wider">Required HTTP Headers (Both Scenarios)</h4>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3 text-xs font-mono">
          <div class="p-3 rounded-lg bg-card border border-border flex items-center justify-between">
            <div>
              <span class="text-muted-foreground block text-[10px] uppercase font-bold">Header Name:</span>
              <span class="text-foreground font-bold font-mono">x-ingest-secret</span>
            </div>
            <button
              type="button"
              class="copy-field-btn rounded-lg border border-border bg-muted/40 px-2 py-1 text-[11px] font-semibold hover:bg-muted transition-all"
              data-copy-text="x-ingest-secret"
            >
              📋 Copy
            </button>
          </div>
          <div class="p-3 rounded-lg bg-card border border-border flex items-center justify-between">
            <div class="overflow-hidden mr-2">
              <span class="text-muted-foreground block text-[10px] uppercase font-bold">Header Value:</span>
              <span id="instruction-secret-val" class="text-foreground font-bold font-mono truncate block">Loading...</span>
            </div>
            <button
              type="button"
              id="copy-header-val-btn"
              class="copy-field-btn shrink-0 rounded-lg border border-border bg-muted/40 px-2 py-1 text-[11px] font-semibold hover:bg-muted transition-all"
              data-copy-target="instruction-secret-val"
            >
              📋 Copy
            </button>
          </div>
        </div>
      </div>

      <!-- SECTION 1: USER ACCOUNT ANALYTICS SCENARIO (V20.1-5) -->
      <div class="space-y-4 rounded-xl border border-border/80 bg-muted/20 p-5">
        <div class="flex items-center justify-between border-b border-border/60 pb-3">
          <div class="flex items-center gap-2">
            <span class="flex h-6 w-6 items-center justify-center rounded-lg bg-blue-500/10 text-blue-600 dark:text-blue-400 font-bold text-xs">A</span>
            <h4 class="text-xs font-bold text-foreground uppercase tracking-wider">USER ACCOUNT ANALYTICS SCENARIO</h4>
          </div>
          <span class="text-[10px] font-semibold text-muted-foreground">Endpoint: /v5/user_account/analytics</span>
        </div>

        <p class="text-xs text-muted-foreground">
          In your Pinterest API call module query parameters, map <code class="font-mono text-[11px] bg-muted/60 px-1 py-0.5 rounded">start_date</code> and <code class="font-mono text-[11px] bg-muted/60 px-1 py-0.5 rounded">end_date</code> using these offset-driven expressions (24 = Webhook module ID):
        </p>

        <!-- Scenario A start_date -->
        <div class="space-y-1.5">
          <div class="flex items-center justify-between">
            <label class="text-[11px] font-bold text-foreground font-mono">start_date</label>
            <button
              type="button"
              class="copy-field-btn rounded-lg border border-border bg-card px-2.5 py-1 text-[11px] font-semibold text-foreground hover:bg-muted transition-all"
              data-copy-target="scenario-a-start-date"
            >
              📋 Copy
            </button>
          </div>
          <textarea
            id="scenario-a-start-date"
            readonly
            rows="2"
            class="w-full rounded-xl border border-border bg-card p-3 font-mono text-xs text-foreground focus:outline-none select-all resize-none"
          >{`{{if(empty(24.start_date); formatDate(addDays(now; sub(0; if(empty(24.analytics_start_offset_days); 7; 24.analytics_start_offset_days))); "YYYY-MM-DD"); 24.start_date)}}`}</textarea>
        </div>

        <!-- Scenario A end_date -->
        <div class="space-y-1.5">
          <div class="flex items-center justify-between">
            <label class="text-[11px] font-bold text-foreground font-mono">end_date</label>
            <button
              type="button"
              class="copy-field-btn rounded-lg border border-border bg-card px-2.5 py-1 text-[11px] font-semibold text-foreground hover:bg-muted transition-all"
              data-copy-target="scenario-a-end-date"
            >
              📋 Copy
            </button>
          </div>
          <textarea
            id="scenario-a-end-date"
            readonly
            rows="2"
            class="w-full rounded-xl border border-border bg-card p-3 font-mono text-xs text-foreground focus:outline-none select-all resize-none"
          >{`{{if(empty(24.end_date); formatDate(addDays(now; sub(0; if(empty(24.analytics_end_offset_days); 1; 24.analytics_end_offset_days))); "YYYY-MM-DD"); 24.end_date)}}`}</textarea>
        </div>
      </div>

      <!-- SECTION 2: TOP PINS ITERATOR SCENARIO (V20.1-5) -->
      <div class="space-y-4 rounded-xl border border-border/80 bg-muted/20 p-5">
        <div class="flex items-center justify-between border-b border-border/60 pb-3">
          <div class="flex items-center gap-2">
            <span class="flex h-6 w-6 items-center justify-center rounded-lg bg-purple-500/10 text-purple-600 dark:text-purple-400 font-bold text-xs">B</span>
            <h4 class="text-xs font-bold text-foreground uppercase tracking-wider">TOP PINS ITERATOR SCENARIO</h4>
          </div>
          <span class="text-[10px] font-semibold text-muted-foreground">Endpoint: /v5/user_account/analytics/top_pins</span>
        </div>

        <!-- Iterator Array -->
        <div class="space-y-1.5">
          <div class="flex items-center justify-between">
            <label class="text-[11px] font-semibold text-foreground">1. Iterator Array (Simple Mapping)</label>
            <button
              type="button"
              class="copy-field-btn rounded-lg border border-border bg-card px-2.5 py-1 text-[11px] font-semibold text-foreground hover:bg-muted transition-all"
              data-copy-target="scenario-b-iterator"
            >
              📋 Copy
            </button>
          </div>
          <textarea
            id="scenario-b-iterator"
            readonly
            rows="1"
            class="w-full rounded-xl border border-border bg-card p-3 font-mono text-xs text-foreground focus:outline-none select-all resize-none"
          >{`24.sort_modes`}</textarea>
          <p class="text-[10px] text-muted-foreground">
            PinOrbit always sends <code class="font-mono text-primary">sort_modes</code> (5 modes by default: <code class="font-mono">IMPRESSION,OUTBOUND_CLICK,SAVE,ENGAGEMENT,PIN_CLICK</code>) in every top_pins payload.
          </p>
        </div>

        <!-- Pinterest Module Parameters -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
          <div class="space-y-1.5">
            <div class="flex items-center justify-between">
              <label class="text-[11px] font-semibold text-foreground">2. Pinterest sort_by</label>
              <button
                type="button"
                class="copy-field-btn rounded-lg border border-border bg-card px-2 py-0.5 text-[10px] font-semibold text-foreground hover:bg-muted transition-all"
                data-copy-text={`{{__ITEM__}}`}
              >
                📋 Copy
              </button>
            </div>
            <input
              type="text"
              readonly
              value={`{{__ITEM__}}`}
              class="w-full rounded-xl border border-border bg-card px-3 py-2 font-mono text-xs text-foreground focus:outline-none select-all"
            />
          </div>
          <div class="space-y-1.5">
            <div class="flex items-center justify-between">
              <label class="text-[11px] font-semibold text-foreground">3. num_of_pins</label>
              <button
                type="button"
                class="copy-field-btn rounded-lg border border-border bg-card px-2 py-0.5 text-[10px] font-semibold text-foreground hover:bg-muted transition-all"
                data-copy-text="50"
              >
                📋 Copy
              </button>
            </div>
            <input
              type="text"
              readonly
              value="50"
              class="w-full rounded-xl border border-border bg-card px-3 py-2 font-mono text-xs text-foreground focus:outline-none select-all"
            />
          </div>
        </div>

        <!-- Scenario B start_date -->
        <div class="space-y-1.5">
          <div class="flex items-center justify-between">
            <label class="text-[11px] font-bold text-foreground font-mono">4. start_date</label>
            <button
              type="button"
              class="copy-field-btn rounded-lg border border-border bg-card px-2.5 py-1 text-[11px] font-semibold text-foreground hover:bg-muted transition-all"
              data-copy-target="scenario-b-start-date"
            >
              📋 Copy
            </button>
          </div>
          <textarea
            id="scenario-b-start-date"
            readonly
            rows="2"
            class="w-full rounded-xl border border-border bg-card p-3 font-mono text-xs text-foreground focus:outline-none select-all resize-none"
          >{`{{if(empty(24.start_date); formatDate(addDays(now; sub(0; if(empty(24.top_pins_start_offset_days); 7; 24.top_pins_start_offset_days))); "YYYY-MM-DD"); 24.start_date)}}`}</textarea>
        </div>

        <!-- Scenario B end_date -->
        <div class="space-y-1.5">
          <div class="flex items-center justify-between">
            <label class="text-[11px] font-bold text-foreground font-mono">5. end_date</label>
            <button
              type="button"
              class="copy-field-btn rounded-lg border border-border bg-card px-2.5 py-1 text-[11px] font-semibold text-foreground hover:bg-muted transition-all"
              data-copy-target="scenario-b-end-date"
            >
              📋 Copy
            </button>
          </div>
          <textarea
            id="scenario-b-end-date"
            readonly
            rows="2"
            class="w-full rounded-xl border border-border bg-card p-3 font-mono text-xs text-foreground focus:outline-none select-all resize-none"
          >{`{{if(empty(24.end_date); formatDate(addDays(now; sub(0; if(empty(24.top_pins_end_offset_days); 2; 24.top_pins_end_offset_days))); "YYYY-MM-DD"); 24.end_date)}}`}</textarea>
        </div>
      </div>
    </div>
  </div>

  <!-- Double Confirmation Hard Gate Modal for Secret Regeneration (Mandatory B5) -->
  <div id="regenerate-confirm-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-background/80 backdrop-blur-sm p-4">
    <div class="w-full max-w-md rounded-2xl border border-destructive/30 bg-card p-6 shadow-2xl space-y-4">
      <div class="flex items-center gap-3 text-destructive">
        <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-destructive/10">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/>
            <line x1="12" y1="9" x2="12" y2="13"/>
            <line x1="12" y1="17" x2="12.01" y2="17"/>
          </svg>
        </div>
        <div>
          <h3 class="text-base font-bold text-foreground">Rotate Ingest Secret?</h3>
          <span class="text-xs text-destructive font-semibold">Immediate Invalidation (No Grace Period)</span>
        </div>
      </div>

      <!-- Warning Gate 1 -->
      <div class="rounded-xl bg-destructive/10 p-3 text-xs text-destructive space-y-1.5">
        <p class="font-bold">⚠️ Warning: Make.com scenarios will reject requests until you paste the new value into the x-ingest-secret header (both scenarios).</p>
      </div>

      <!-- Gate 2: User must type REGENERATE -->
      <div class="space-y-2 pt-2">
        <label for="confirm-type-input" class="block text-xs font-semibold text-foreground">
          Type <span class="font-mono font-bold text-destructive">REGENERATE</span> to confirm rotation:
        </label>
        <input
          type="text"
          id="confirm-type-input"
          placeholder="REGENERATE"
          class="w-full rounded-xl border border-border bg-card px-3 py-2 text-xs font-mono font-bold text-foreground uppercase focus:border-destructive focus:outline-none focus:ring-1 focus:ring-destructive"
        />
      </div>

      <div class="flex items-center justify-end gap-3 pt-4 border-t border-border">
        <button
          type="button"
          id="cancel-regenerate-modal-btn"
          class="rounded-xl border border-border px-4 py-2 text-xs font-semibold text-muted-foreground hover:bg-muted hover:text-foreground"
        >
          Cancel
        </button>
        <button
          type="button"
          id="execute-regenerate-btn"
          disabled
          class="rounded-xl bg-destructive px-4 py-2 text-xs font-bold text-destructive-foreground hover:bg-destructive/90 transition-all disabled:opacity-40 disabled:cursor-not-allowed"
        >
          Confirm Rotation
        </button>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { safeFetchJson } from '../../lib/ui-helpers';

  let currentSecret = '';
  let currentSource = '';
  let hasOverride = false;

  async function fetchSecrets() {
    try {
      const json = await safeFetchJson('/api/analytics/secrets');
      if (json.success) {
        currentSecret = json.secret || '';
        currentSource = json.source || 'global';
        hasOverride = Boolean(json.hasOverride);

        const input = document.getElementById('secret-display-input') as HTMLInputElement | null;
        if (input) input.value = currentSecret;

        const instructionVal = document.getElementById('instruction-secret-val');
        if (instructionVal) instructionVal.textContent = currentSecret;

        const badge = document.getElementById('secret-source-badge');
        if (badge) {
          if (currentSource === 'workspace') {
            badge.className = 'rounded-full bg-purple-500/10 px-2.5 py-0.5 text-xs font-bold text-purple-600 dark:text-purple-400';
            badge.textContent = 'Workspace Override';
          } else if (currentSource === 'global') {
            badge.className = 'rounded-full bg-emerald-500/10 px-2.5 py-0.5 text-xs font-bold text-emerald-600 dark:text-emerald-400';
            badge.textContent = 'Global Secret';
          } else {
            badge.className = 'rounded-full bg-blue-500/10 px-2.5 py-0.5 text-xs font-bold text-blue-600 dark:text-blue-400';
            badge.textContent = 'Environment Fallback';
          }
        }

        const removeBtn = document.getElementById('remove-override-btn');
        if (removeBtn) {
          if (hasOverride) removeBtn.classList.remove('hidden');
          else removeBtn.classList.add('hidden');
        }
      } else {
        showStatus(`Failed to load secret: ${json.error}`, 'error');
      }
    } catch (e: any) {
      showStatus(e.message, 'error');
    }
  }

  function showStatus(msg: string, type = 'success') {
    const el = document.getElementById('secrets-page-status');
    if (!el) return;
    el.classList.remove('hidden');
    if (type === 'success') {
      el.className = 'rounded-xl bg-emerald-500/10 p-3 text-xs font-semibold text-emerald-600 dark:text-emerald-400';
    } else {
      el.className = 'rounded-xl bg-destructive/10 p-3 text-xs font-semibold text-destructive';
    }
    el.textContent = msg;
  }

  // Copy Secret Button
  const copyBtn = document.getElementById('copy-secret-btn');
  if (copyBtn) {
    copyBtn.addEventListener('click', async () => {
      if (!currentSecret) return;
      try {
        await navigator.clipboard.writeText(currentSecret);
        const textSpan = document.getElementById('copy-btn-text');
        if (textSpan) textSpan.textContent = '✅ Copied!';
        setTimeout(() => {
          if (textSpan) textSpan.textContent = '📋 Copy';
        }, 2000);
      } catch (err) {
        showStatus('Failed to copy to clipboard', 'error');
      }
    });
  }

  // Generic Field Copy Buttons Listener
  document.querySelectorAll('.copy-field-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const button = btn as HTMLElement;
      let textToCopy = button.getAttribute('data-copy-text');
      const targetId = button.getAttribute('data-copy-target');

      if (!textToCopy && targetId) {
        const targetEl = document.getElementById(targetId) as HTMLInputElement | HTMLTextAreaElement | HTMLElement | null;
        if (targetEl) {
          if ('value' in targetEl) {
            textToCopy = targetEl.value;
          } else {
            textToCopy = targetEl.textContent || '';
          }
        }
      }

      if (textToCopy) {
        try {
          await navigator.clipboard.writeText(textToCopy);
          const originalText = button.textContent;
          button.textContent = '✅ Copied!';
          setTimeout(() => {
            button.textContent = originalText;
          }, 2000);
        } catch (e) {
          console.error('Clipboard copy failed:', e);
        }
      }
    });
  });

  // Advanced Accordion Toggle
  const toggleAdvancedBtn = document.getElementById('toggle-advanced-btn');
  const advancedSection = document.getElementById('advanced-section');
  const advancedChevron = document.getElementById('advanced-chevron');
  if (toggleAdvancedBtn && advancedSection) {
    toggleAdvancedBtn.addEventListener('click', () => {
      const isHidden = advancedSection.classList.contains('hidden');
      if (isHidden) {
        advancedSection.classList.remove('hidden');
        advancedChevron?.classList.add('rotate-180');
      } else {
        advancedSection.classList.add('hidden');
        advancedChevron?.classList.remove('rotate-180');
      }
    });
  }

  // Double Confirmation Gate for Regeneration
  const modal = document.getElementById('regenerate-confirm-modal');
  const openModalBtn = document.getElementById('open-regenerate-modal-btn');
  const closeModalBtn = document.getElementById('cancel-regenerate-modal-btn');
  const confirmInput = document.getElementById('confirm-type-input') as HTMLInputElement | null;
  const executeBtn = document.getElementById('execute-regenerate-btn') as HTMLButtonElement | null;

  function openRegenerateModal() {
    if (confirmInput) confirmInput.value = '';
    if (executeBtn) executeBtn.disabled = true;
    if (modal) {
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }
  }

  function closeRegenerateModal() {
    if (modal) {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }
  }

  if (openModalBtn) openModalBtn.addEventListener('click', openRegenerateModal);
  if (closeModalBtn) closeModalBtn.addEventListener('click', closeRegenerateModal);

  // Gate 2 Input Listener: Enables execute button only when REGENERATE is typed
  if (confirmInput && executeBtn) {
    confirmInput.addEventListener('input', (e: any) => {
      const val = e.target.value.trim().toUpperCase();
      executeBtn.disabled = (val !== 'REGENERATE');
    });
  }

  // Execute Rotation Handler
  if (executeBtn) {
    executeBtn.addEventListener('click', async () => {
      if (confirmInput?.value.trim().toUpperCase() !== 'REGENERATE') return;
      executeBtn.textContent = 'Rotating...';
      executeBtn.disabled = true;

      try {
        const scope = hasOverride ? 'workspace' : 'global';
        const json = await safeFetchJson('/api/analytics/secrets/regenerate', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ scope }),
        });
        if (json.success) {
          closeRegenerateModal();
          showStatus(json.message || 'Secret successfully rotated.', 'success');
          await fetchSecrets();
        } else {
          showStatus('Rotation failed: ' + (json.error || 'Unknown error'), 'error');
        }
      } catch (err: any) {
        showStatus(err.message, 'error');
      } finally {
        executeBtn.textContent = 'Confirm Rotation';
      }
    });
  }

  // Generate Workspace Override
  const genOverrideBtn = document.getElementById('generate-override-btn');
  if (genOverrideBtn) {
    genOverrideBtn.addEventListener('click', async () => {
      if (!confirm('Generate a workspace-specific override secret? This will isolate this workspace from the global secret.')) {
        return;
      }
      try {
        const json = await safeFetchJson('/api/analytics/secrets/regenerate', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ scope: 'workspace' }),
        });
        if (json.success) {
          showStatus('Workspace override secret generated.', 'success');
          await fetchSecrets();
        } else {
          showStatus(`Error: ${json.error}`, 'error');
        }
      } catch (err: any) {
        showStatus(err.message, 'error');
      }
    });
  }

  // Remove Workspace Override
  const removeOverrideBtn = document.getElementById('remove-override-btn');
  if (removeOverrideBtn) {
    removeOverrideBtn.addEventListener('click', async () => {
      if (!confirm('Remove workspace override and revert back to global secret?')) {
        return;
      }
      try {
        const json = await safeFetchJson('/api/analytics/secrets/remove-override', {
          method: 'POST',
        });
        if (json.success) {
          showStatus(json.message, 'success');
          await fetchSecrets();
        } else {
          showStatus(`Error: ${json.error}`, 'error');
        }
      } catch (err: any) {
        showStatus(err.message, 'error');
      }
    });
  }

  // Initial Load
  fetchSecrets();
</script>

