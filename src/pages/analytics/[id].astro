---
import Layout from '../../layouts/Layout.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import FastCronOptionsCard from '../../components/analytics/FastCronOptionsCard.astro';
import ConnectionHealthBanner from '../../components/analytics/ConnectionHealthBanner.astro';

import { dbClients } from '../../server/db/clients';
import { assertWorkspaceAccess } from '../../lib/auth';
import type { Database } from '../../lib/database.types';

export const prerender = false;

const { id: connectionId } = Astro.params;
const workspaceId = Astro.locals.activeWorkspaceId || '';

if (!workspaceId || !connectionId) {
  return Astro.redirect('/analytics');
}

// C1: DYNAMIC SECTION TITLES
let connection: Database['public']['Tables']['analytics_connections']['Row'] | null = null;
try {
  const analyticsClient = dbClients.getAnalytics(Astro.locals?.runtime?.env);
  const { data } = await analyticsClient
    .from('analytics_connections')
    .select('*')
    .eq('id', connectionId)
    .eq('workspace_id', workspaceId)
    .is('deleted_at', null)
    .single();
  connection = data;
} catch (e) {
  console.error('Failed to load connection details', e);
}

if (!connection) {
  return Astro.redirect('/analytics');
}

const accountName = connection.display_name || 'Account';
---

<Layout title={`${accountName} — Analytics`} description="Detailed daily snapshot logs and ranked top pins performance.">
  <!-- Back Link & Page Header -->
  <div class="mb-6" data-connection-id={connectionId} data-display-name={accountName}>
    <a
      href="/analytics"
      class="inline-flex items-center gap-1.5 text-xs font-semibold text-muted-foreground hover:text-foreground transition-colors mb-3"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      <span>Back to All Accounts</span>
    </a>

    <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
      <div>
        <div class="flex items-center gap-3">
          <h1 id="connection-title" class="text-2xl font-black tracking-tight text-foreground">
            {accountName} — Analytics
          </h1>
          <span id="connection-status-badge" class="rounded-full bg-emerald-500/10 px-2.5 py-0.5 text-xs font-bold text-emerald-600 dark:text-emerald-400">
            Active
          </span>
        </div>
        <div class="flex items-center gap-3 text-xs text-muted-foreground mt-1">
          <span>Connection ID: <code class="font-mono text-foreground/80">{connectionId}</code></span>
          <span>•</span>
          <span>Last Sync: <strong id="connection-last-sync" class="text-foreground">Loading...</strong></span>
        </div>
      </div>
    </div>
  </div>

  <!-- C2: Tabs Shell -->
  <div role="tablist" aria-label="Analytics views" class="mb-6 inline-flex rounded-xl border border-border bg-muted/30 p-1">
    <button role="tab" id="tab-data" aria-controls="panel-data" aria-selected="true"
      data-tab="data" class="rounded-lg px-4 py-1.5 text-xs font-bold bg-primary text-primary-foreground shadow-sm">📊 Data & Analytics</button>
    <button role="tab" id="tab-pipe" aria-controls="panel-pipe" aria-selected="false"
      data-tab="pipeline" class="rounded-lg px-4 py-1.5 text-xs font-semibold text-muted-foreground">⚙️ Pipeline & Automation</button>
    <button role="tab" id="tab-intel" aria-controls="panel-intel" aria-selected="false"
      data-tab="intelligence" class="rounded-lg px-4 py-1.5 text-xs font-semibold text-muted-foreground">📌 Pin Intelligence</button>
    <button role="tab" id="tab-purge" aria-controls="panel-purge" aria-selected="false"
      data-tab="purge" class="rounded-lg px-4 py-1.5 text-xs font-semibold text-muted-foreground">🧹 Data Purge</button>
  </div>

  <!-- PANEL 1: DATA & ANALYTICS -->
  <section id="panel-data" role="tabpanel" aria-labelledby="tab-data">
    <!-- Global Date Range Picker with Presets (Applies to BOTH Section 1 & Section 2) -->
    <div class="mb-8 rounded-2xl border border-border bg-card p-4 shadow-sm">
      <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
        <div class="flex items-center gap-3">
          <span class="text-xs font-bold uppercase tracking-wider text-muted-foreground">Date Range:</span>
          <!-- Presets -->
          <div class="inline-flex rounded-xl border border-border bg-muted/30 p-1" id="range-presets">
            <button data-days="7" class="preset-btn active rounded-lg bg-primary px-2.5 py-1 text-xs font-semibold text-primary-foreground shadow-sm transition-all">7D</button>
            <button data-days="14" class="preset-btn rounded-lg px-2.5 py-1 text-xs font-semibold text-muted-foreground hover:text-foreground transition-all">14D</button>
            <button data-days="30" class="preset-btn rounded-lg px-2.5 py-1 text-xs font-semibold text-muted-foreground hover:text-foreground transition-all">30D</button>
            <button data-days="90" class="preset-btn rounded-lg px-2.5 py-1 text-xs font-semibold text-muted-foreground hover:text-foreground transition-all">90D</button>
          </div>
        </div>

        <!-- Custom From/To Date Inputs -->
        <div class="flex flex-wrap items-center gap-2">
          <div class="flex items-center gap-1.5">
            <label class="text-xs font-semibold text-muted-foreground">From:</label>
            <input
              type="date"
              id="from-date-input"
              class="rounded-xl border border-border bg-card px-2.5 py-1.5 text-xs text-foreground focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
            />
          </div>
          <div class="flex items-center gap-1.5">
            <label class="text-xs font-semibold text-muted-foreground">To:</label>
            <input
              type="date"
              id="to-date-input"
              class="rounded-xl border border-border bg-card px-2.5 py-1.5 text-xs text-foreground focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
            />
          </div>
          <button
            id="apply-range-btn"
            class="rounded-xl border border-border bg-card px-3 py-1.5 text-xs font-semibold text-foreground hover:bg-muted transition-all shadow-sm"
          >
            Apply Range
          </button>
        </div>
      </div>
    </div>

    <!-- SECTION 1 — IMPORT HISTORY & SNAPSHOT LOG (Daily) -->
    <div class="mb-10 rounded-2xl border border-border bg-card shadow-sm overflow-hidden">
      <div class="flex flex-col gap-2 border-b border-border p-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <!-- C1: Dynamic Section Title -->
          <h2 id="s1-title" class="text-base font-bold text-foreground">{accountName} — Daily Metrics</h2>
          <p class="text-xs text-muted-foreground">Daily metric records from Pinterest API v5 with pooled summary totals</p>
        </div>
        <div class="flex items-center gap-2">
          <label class="text-xs font-semibold text-muted-foreground flex items-center gap-2">
            Show: 
            <select id="s1-ps" class="rounded-xl border border-border bg-background px-2 py-1 text-xs focus:outline-none focus:border-primary">
              <option value="10">10</option>
              <option value="25" selected>25</option>
              <option value="50">50</option>
              <option value="100">100</option>
            </select>
          </label>
        </div>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs">
          <thead class="border-b border-border bg-muted/20 text-[11px] uppercase tracking-wider text-muted-foreground font-semibold sticky top-0 z-10 shadow-sm">
            <tr>
              <th class="py-3 px-4 min-w-[130px] cursor-pointer hover:text-primary transition-colors select-none" data-s1-sort="metric_date">Date <span class="sort-icon"></span></th>
              <th class="py-3 px-4 text-center cursor-pointer hover:text-primary transition-colors select-none" data-s1-sort="data_status">Status <span class="sort-icon"></span></th>
              <th class="py-3 px-4 text-right cursor-pointer hover:text-primary transition-colors select-none" data-s1-sort="impressions">Impressions <span class="sort-icon"></span></th>
              <th class="py-3 px-4 text-right cursor-pointer hover:text-primary transition-colors select-none" data-s1-sort="engagements">Engagements <span class="sort-icon"></span></th>
              <th class="py-3 px-4 text-right cursor-pointer hover:text-primary transition-colors select-none" data-s1-sort="outbound_clicks">Outbound Clicks <span class="sort-icon"></span></th>
              <th class="py-3 px-4 text-right cursor-pointer hover:text-primary transition-colors select-none" data-s1-sort="pin_clicks">Pin Clicks <span class="sort-icon"></span></th>
              <th class="py-3 px-4 text-right cursor-pointer hover:text-primary transition-colors select-none" data-s1-sort="saves">Saves <span class="sort-icon"></span></th>
              <th class="py-3 px-4 text-right cursor-pointer hover:text-primary transition-colors select-none" data-s1-sort="save_rate">Save Rate <span class="sort-icon"></span></th>
              <th class="py-3 px-4 text-center">Delete</th>
            </tr>
          </thead>
          <tbody id="daily-metrics-tbody" class="divide-y divide-border [&>tr:nth-child(even)]:bg-muted/5">
            <tr>
              <td colspan="9" class="py-12 text-center text-muted-foreground">
                Loading daily metrics...
              </td>
            </tr>
          </tbody>
          <tfoot id="daily-metrics-tfoot" class="border-t-2 border-border bg-muted/40 font-bold text-foreground">
            <!-- Populated by client script -->
          </tfoot>
        </table>
      </div>
      <div id="s1-pagination" class="flex items-center justify-between p-4 border-t border-border bg-muted/10 text-xs">
        <div class="text-muted-foreground">Showing <span id="s1-range">0-0</span> of <span id="s1-total">0</span></div>
        <div class="flex gap-1" id="s1-page-buttons"></div>
      </div>
    </div>

    <!-- SECTION 2 — RANKED TOP 50 PINS -->
    <div class="mb-10 rounded-2xl border border-border bg-card shadow-sm overflow-hidden">
      <div class="flex flex-col gap-4 border-b border-border p-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <!-- C1: Dynamic Section Title -->
          <h2 id="s2-title" class="text-base font-bold text-foreground">{accountName} — Top Pins</h2>
          <p class="text-xs text-muted-foreground">Top organic pins ranked by Pinterest API v5 across core engagement metrics</p>
          <div class="mt-1" id="s2-window-badge"></div>
        </div>

        <!-- 5 Sort Tabs -->
        <div class="flex flex-col items-end gap-2">
          <div class="flex flex-wrap items-center gap-1.5 rounded-xl border border-border bg-muted/40 p-1" id="top-pins-sort-tabs">
            <button data-mode="IMPRESSION" class="mode-tab active rounded-lg bg-primary px-3 py-1 text-xs font-semibold text-primary-foreground shadow-sm transition-all">Impressions</button>
            <button data-mode="OUTBOUND_CLICK" class="mode-tab rounded-lg px-3 py-1 text-xs font-semibold text-muted-foreground transition-all hover:text-foreground">Outbound Clicks</button>
            <button data-mode="SAVE" class="mode-tab rounded-lg px-3 py-1 text-xs font-semibold text-muted-foreground transition-all hover:text-foreground">Saves</button>
            <button data-mode="ENGAGEMENT" class="mode-tab rounded-lg px-3 py-1 text-xs font-semibold text-muted-foreground transition-all hover:text-foreground">Engagements</button>
            <button data-mode="PIN_CLICK" class="mode-tab rounded-lg px-3 py-1 text-xs font-semibold text-muted-foreground transition-all hover:text-foreground">Pin Clicks</button>
          </div>
          <div class="flex items-center gap-2">
            <input type="text" id="s2-q" name="pins-search" autocomplete="off" data-lpignore="true" data-1p-ignore="true" placeholder="Search title or ID..." class="rounded-xl border border-border bg-background px-2.5 py-1 text-xs focus:outline-none focus:border-primary w-48" />
            <label class="text-xs font-semibold text-muted-foreground flex items-center gap-2">
              Show: 
              <select id="s2-ps" class="rounded-xl border border-border bg-background px-2 py-1 text-xs focus:outline-none focus:border-primary">
                <option value="10" selected>10</option>
                <option value="25">25</option>
                <option value="50">50</option>
                <option value="100">100</option>
              </select>
            </label>
          </div>
        </div>
      </div>

      <!-- F4: Top Pins Own Date Range Control -->
      <div class="flex flex-wrap items-center justify-between gap-3 bg-muted/10 px-4 py-2.5 border-b border-border text-xs">
        <div class="flex items-center gap-2">
          <span class="text-[11px] font-bold uppercase tracking-wider text-muted-foreground">Top Pins Range:</span>
          <div class="inline-flex rounded-xl border border-border bg-muted/30 p-0.5" id="s2-range-presets">
            <button data-s2-days="7" class="s2-preset-btn active rounded-lg bg-primary px-2.5 py-0.5 text-xs font-semibold text-primary-foreground shadow-sm transition-all">7D</button>
            <button data-s2-days="14" class="s2-preset-btn rounded-lg px-2.5 py-0.5 text-xs font-semibold text-muted-foreground hover:text-foreground transition-all">14D</button>
            <button data-s2-days="30" class="s2-preset-btn rounded-lg px-2.5 py-0.5 text-xs font-semibold text-muted-foreground hover:text-foreground transition-all">30D</button>
            <button data-s2-days="90" class="s2-preset-btn rounded-lg px-2.5 py-0.5 text-xs font-semibold text-muted-foreground hover:text-foreground transition-all">90D</button>
          </div>
        </div>
        <div class="flex flex-wrap items-center gap-2">
          <div class="flex items-center gap-1.5">
            <label class="text-[11px] font-semibold text-muted-foreground">From:</label>
            <input type="date" id="s2-from-date-input" class="rounded-lg border border-border bg-card px-2 py-1 text-xs text-foreground focus:border-primary focus:outline-none" />
          </div>
          <div class="flex items-center gap-1.5">
            <label class="text-[11px] font-semibold text-muted-foreground">To:</label>
            <input type="date" id="s2-to-date-input" class="rounded-lg border border-border bg-card px-2 py-1 text-xs text-foreground focus:border-primary focus:outline-none" />
          </div>
          <button id="s2-apply-range-btn" class="rounded-lg border border-border bg-card px-2.5 py-1 text-xs font-semibold text-foreground hover:bg-muted transition-all shadow-sm">Apply</button>
        </div>
      </div>

      <!-- Top Pins Table -->
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs">
          <thead class="border-b border-border bg-muted/20 text-[11px] uppercase tracking-wider text-muted-foreground font-semibold sticky top-0 z-10 shadow-sm">
            <tr>
              <th class="py-3 px-4 w-14 text-center">Rank</th>
              <th class="py-3 px-4 min-w-[280px]">Pin Details</th>
              <th class="py-3 px-4 text-center">Status</th>
              <th class="py-3 px-4 text-right">Impressions</th>
              <th class="py-3 px-4 text-right">Engagements</th>
              <th class="py-3 px-4 text-right">Outbound Clicks</th>
              <th class="py-3 px-4 text-right">Pin Clicks</th>
              <th class="py-3 px-4 text-right">Saves</th>
            </tr>
          </thead>
          <tbody id="top-pins-tbody" class="divide-y divide-border [&>tr:nth-child(even)]:bg-muted/5">
            <tr>
              <td colspan="8" class="py-12 text-center text-muted-foreground">
                Loading top pins snapshots...
              </td>
            </tr>
          </tbody>
        </table>
      </div>
      <div id="s2-pagination" class="flex items-center justify-between p-4 border-t border-border bg-muted/10 text-xs">
        <div class="text-muted-foreground">Showing <span id="s2-range">0-0</span> of <span id="s2-total">0</span></div>
        <div class="flex gap-1" id="s2-page-buttons"></div>
      </div>
    </div>
  </section>

  <!-- PANEL 2: PIPELINE & AUTOMATION -->
  <section id="panel-pipe" role="tabpanel" aria-labelledby="tab-pipe" hidden class="space-y-6">
    <!-- C2.1: Health Banner -->
    <ConnectionHealthBanner />

    <!-- C2.2: Pipeline Cards -->
    <div class="grid grid-cols-1 xl:grid-cols-2 gap-6 items-start">
      <!-- Pipeline A: Account Analytics -->
      <article data-pipeline="analytics" class="rounded-2xl border border-border bg-card p-5 shadow-sm space-y-4 flex flex-col h-full">
        <header class="flex items-center justify-between gap-3">
          <div>
            <h3 class="text-sm font-bold">Pipeline A: Account Analytics</h3>
            <p class="font-mono text-[11px] text-muted-foreground">/v5/user_account/analytics · GET</p>
          </div>
          <div class="flex flex-col items-end gap-1 text-right">
            <span data-chip class="rounded-full bg-muted px-2.5 py-0.5 text-[10px] font-bold text-muted-foreground">...</span>
            <p data-err-msg class="hidden max-w-[200px] truncate text-[10px] font-bold text-red-500"></p>
          </div>
        </header>

        <div class="grid gap-3 sm:grid-cols-2">
          <div class="sm:col-span-2 space-y-1 text-xs">
            <div class="flex items-center justify-between">
              <span class="font-semibold text-muted-foreground">Make.com Webhook URL</span>
              <button type="button" data-action="copy-webhook" class="rounded-lg border border-border bg-card px-2.5 py-0.5 text-xs font-semibold text-muted-foreground hover:text-foreground hover:bg-muted transition-all">Copy</button>
            </div>
            <input data-field="webhook_url" type="url" class="w-full rounded-xl border border-border bg-background px-3 py-2 text-xs focus:border-primary focus:outline-none" />
            <p data-err="webhook_url" class="hidden text-[10px] font-bold text-red-500"></p>
          </div>

          <label class="space-y-1 text-xs">
            <span class="font-semibold text-muted-foreground">Sync Time (HH:MM)</span>
            <input data-field="sync_time" inputmode="numeric" placeholder="04:00" class="w-full rounded-xl border border-border bg-background px-3 py-2 text-xs" />
            <p data-err="sync_time" class="hidden text-[10px] font-bold text-red-500"></p>
          </label>

          <div class="grid grid-cols-2 gap-3">
            <label class="space-y-1 text-xs">
              <span class="font-semibold text-muted-foreground">Start Offset (1–90d)</span>
              <input data-field="start_offset" type="number" min="1" max="90" class="w-full rounded-xl border border-border bg-background px-3 py-2 text-xs" />
            </label>
            <label class="space-y-1 text-xs">
              <span class="font-semibold text-muted-foreground">End Offset (0–60d)</span>
              <input data-field="end_offset" type="number" min="0" max="60" class="w-full rounded-xl border border-border bg-background px-3 py-2 text-xs" />
              <p data-err="offsets" class="hidden text-[10px] font-bold text-red-500"></p>
            </label>
          </div>

          <!-- C2: Run Now inline override date inputs -->
          <div class="grid grid-cols-2 gap-3 sm:col-span-2 border-t border-border pt-3 mt-1">
            <div class="col-span-2 text-[10px] font-bold text-muted-foreground uppercase tracking-wider mb-1">Manual Run Overrides (Optional)</div>
            <label class="space-y-1 text-xs">
              <span class="font-semibold text-muted-foreground">Override From Date</span>
              <input data-field="override_from" type="date" class="w-full rounded-xl border border-border bg-background px-3 py-2 text-xs" />
            </label>
            <label class="space-y-1 text-xs">
              <span class="font-semibold text-muted-foreground">Override To Date</span>
              <input data-field="override_to" type="date" class="w-full rounded-xl border border-border bg-background px-3 py-2 text-xs" />
              <p data-err="override_dates" class="hidden text-[10px] font-bold text-red-500"></p>
            </label>
          </div>

          <div class="sm:col-span-2 space-y-1 text-xs border-t border-border pt-3 mt-1">
            <div class="flex justify-between items-center">
              <span class="font-semibold text-muted-foreground">FastCron API Token (Write-Only Override)</span>
              <span data-token-badge class="rounded-full bg-muted/50 px-2 py-0.5 text-[10px] font-bold text-muted-foreground">Workspace Default</span>
            </div>
            <input data-field="fastcron_token" type="password" autocomplete="new-password" data-lpignore="true" data-1p-ignore="true" placeholder="Leave empty for default" class="w-full rounded-xl border border-border bg-background px-3 py-2 text-xs focus:border-primary focus:outline-none" />
          </div>
        </div>

        <footer class="flex flex-wrap gap-2 border-t border-border pt-3 mt-auto">
          <button data-action="ping" class="rounded-xl border border-border bg-card px-3 py-1.5 text-xs font-semibold hover:bg-muted">Test Ping</button>
          <button data-action="run"  class="rounded-xl bg-primary px-3 py-1.5 text-xs font-bold text-primary-foreground hover:bg-primary/90">Run Now</button>
          <button data-action="sync" class="rounded-xl border border-border bg-card px-3 py-1.5 text-xs font-semibold hover:bg-muted">⚡ Sync Schedule</button>
          <button data-action="logs" class="rounded-xl border border-border bg-card px-3 py-1.5 text-xs font-semibold hover:bg-muted">📋 View Logs</button>
          <button data-action="save" disabled class="ml-auto rounded-xl bg-emerald-600 px-4 py-1.5 text-xs font-bold text-white disabled:opacity-40">Save Settings</button>
        </footer>
      </article>

      <!-- Pipeline B: Ranked Top Pins -->
      <article data-pipeline="top_pins" class="rounded-2xl border border-border bg-card p-5 shadow-sm space-y-4 flex flex-col h-full">
        <header class="flex items-center justify-between gap-3">
          <div>
            <h3 class="text-sm font-bold">Pipeline B: Ranked Top Pins</h3>
            <p class="font-mono text-[11px] text-muted-foreground">/v5/user_account/analytics/top_pins · GET</p>
          </div>
          <div class="flex flex-col items-end gap-1 text-right">
            <span data-chip class="rounded-full bg-muted px-2.5 py-0.5 text-[10px] font-bold text-muted-foreground">...</span>
            <p data-err-msg class="hidden max-w-[200px] truncate text-[10px] font-bold text-red-500"></p>
          </div>
        </header>

        <div class="grid gap-3 sm:grid-cols-2">
          <div class="sm:col-span-2 space-y-1 text-xs">
            <div class="flex items-center justify-between">
              <span class="font-semibold text-muted-foreground">Make.com Webhook URL</span>
              <button type="button" data-action="copy-webhook" class="rounded-lg border border-border bg-card px-2.5 py-0.5 text-xs font-semibold text-muted-foreground hover:text-foreground hover:bg-muted transition-all">Copy</button>
            </div>
            <input data-field="webhook_url" type="url" class="w-full rounded-xl border border-border bg-background px-3 py-2 text-xs focus:border-primary focus:outline-none" />
            <p data-err="webhook_url" class="hidden text-[10px] font-bold text-red-500"></p>
          </div>

          <label class="space-y-1 text-xs">
            <span class="font-semibold text-muted-foreground">Sync Time (HH:MM)</span>
            <input data-field="sync_time" inputmode="numeric" placeholder="04:00" class="w-full rounded-xl border border-border bg-background px-3 py-2 text-xs" />
            <p data-err="sync_time" class="hidden text-[10px] font-bold text-red-500"></p>
          </label>

          <div class="grid grid-cols-2 gap-3">
