---
import Layout from '../layouts/Layout.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
---

<Layout title="Competitor Intelligence" description="Track competitor Pinterest growth, reach, views, followers, and board creation strategy over time.">
  <!-- Header & Primary Actions -->
  <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between mb-6">
    <SectionHeader
      title="Competitor Intelligence"
      description="Monitor competitor profile reach, follower velocity, and Pinterest board strategy timeline."
    />

    <div class="flex flex-wrap items-center gap-2.5 self-start sm:self-auto">
      <button
        id="open-paste-payload-modal"
        class="inline-flex items-center justify-center gap-2 rounded-xl border border-border bg-card px-4 py-2.5 text-xs font-semibold text-foreground shadow-sm hover:bg-muted hover:text-foreground transition-all"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/>
          <rect x="8" y="2" width="8" height="4" rx="1" ry="1"/>
        </svg>
        <span>Paste DevTools Payload</span>
      </button>

      <button
        id="open-add-competitor-modal"
        class="inline-flex items-center justify-center gap-2 rounded-xl bg-primary px-4 py-2.5 text-xs font-semibold text-primary-foreground shadow-md hover:bg-primary/90 transition-all"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
        </svg>
        <span>Track Profile</span>
      </button>
    </div>
  </div>

  <!-- Global Success / Status Banner -->
  <div id="competitor-status-banner" class="hidden mb-6 rounded-xl border border-emerald-500/30 bg-emerald-500/10 p-4 text-xs text-emerald-600 dark:text-emerald-400 flex items-center justify-between shadow-sm">
    <div class="flex items-center gap-2.5">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>
      </svg>
      <span id="competitor-status-text">Operation completed successfully.</span>
    </div>
    <button id="dismiss-status-banner" class="text-emerald-500 hover:text-emerald-400">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
  </div>

  <!-- Summary KPI Card (Single) -->
  <div class="mb-6">
    <div class="rounded-xl border border-border bg-card p-5 shadow-sm inline-block min-w-[240px]">
      <span class="text-xs font-medium text-muted-foreground uppercase tracking-wider">Tracked Profiles</span>
      <div class="text-2xl font-bold tracking-tight text-foreground mt-1 mb-2" id="kpi-total-competitors">-</div>
      <div class="flex flex-col gap-1">
        <div class="flex items-center gap-2 text-xs text-muted-foreground">
          <span class="text-sm">👤</span>
          <span>My Accounts:</span>
          <span class="font-bold text-foreground" id="kpi-own-count">0</span>
        </div>
        <div class="flex items-center gap-2 text-xs text-muted-foreground">
          <span class="text-sm">🎯</span>
          <span>Competitors:</span>
          <span class="font-bold text-foreground" id="kpi-competitor-count">0</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Competitors Table Workspace -->
  <div class="rounded-xl border border-border bg-card shadow-sm overflow-hidden mb-8">
    <!-- Header Controls: Tabs, Tag Filters, Column Visibility -->
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between border-b border-border px-6 py-4 bg-muted/30">
      <div class="flex items-center gap-4 flex-wrap">
        <!-- Account Type Filter Tabs -->
        <div class="flex items-center gap-1 bg-muted/60 p-1 rounded-xl border border-border/60">
          <button data-type-tab="all" class="account-type-tab-btn rounded-lg px-3.5 py-1.5 text-xs font-semibold bg-background text-foreground shadow-xs transition-all">
            All Profiles
          </button>
          <button data-type-tab="own" class="account-type-tab-btn rounded-lg px-3.5 py-1.5 text-xs font-semibold text-muted-foreground hover:text-foreground transition-all flex items-center gap-1">
            <span>👤 My Accounts</span>
          </button>
          <button data-type-tab="competitor" class="account-type-tab-btn rounded-lg px-3.5 py-1.5 text-xs font-semibold text-muted-foreground hover:text-foreground transition-all flex items-center gap-1">
            <span>🎯 Competitors</span>
          </button>
        </div>

        <!-- Dynamic Tag Dropdown Filter -->
        <div class="flex items-center gap-1.5">
          <label for="tag-filter-select" class="text-xs font-semibold text-muted-foreground flex items-center gap-1">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2H2v10l9.29 9.29c.94.94 2.48.94 3.42 0l6.58-6.58c.94-.94.94-2.48 0-3.42L12 2Z"/><circle cx="7" cy="7" r=".5" fill="currentColor"/></svg>
            <span>Tag:</span>
          </label>
          <select id="tag-filter-select" class="rounded-xl border border-border bg-background px-3 py-1.5 text-xs font-medium text-foreground focus:border-primary focus:outline-none">
            <option value="all">All Tags</option>
          </select>
        </div>
      </div>

      <div class="flex items-center gap-2.5 flex-wrap">
        <!-- Column Visibility Dropdown -->
        <div class="relative" id="col-visibility-wrapper">
          <button
            id="col-visibility-btn"
            class="inline-flex items-center gap-1.5 rounded-xl border border-border bg-background px-3 py-1.5 text-xs font-semibold text-foreground hover:bg-muted transition-all"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
            <span>Columns</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
          <div
            id="col-visibility-menu"
            class="hidden absolute right-0 top-full mt-1.5 z-30 w-48 rounded-xl border border-border bg-card shadow-lg p-2 space-y-0.5"
          >
            <!-- Populated by JS -->
          </div>
        </div>

        <span class="rounded-full bg-primary/10 px-2.5 py-1 text-xs font-semibold text-primary" id="competitor-badge-count">
          0 Profiles
        </span>
      </div>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs text-muted-foreground" id="competitors-table">
        <thead class="border-b border-border bg-muted/40 text-foreground font-semibold" id="competitors-thead">
          <!-- Populated by JS to support dynamic columns -->
        </thead>
        <tbody id="competitors-table-body" class="divide-y divide-border">
          <tr>
            <td colspan="9" class="py-12 text-center text-xs text-muted-foreground animate-pulse">
              Loading competitor intelligence workspace...
            </td>
          </tr>
        </tbody>
        <tfoot id="competitors-tfoot" class="hidden border-t-2 border-border bg-muted/50">
          <!-- Populated by JS -->
        </tfoot>
      </table>
    </div>
  </div>

  <!-- MODAL 1: Track Profile Modal -->
  <div id="add-competitor-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60 backdrop-blur-sm p-4" aria-modal="true" role="dialog">
    <div id="add-competitor-backdrop" class="fixed inset-0"></div>
    <div class="relative w-full max-w-lg rounded-2xl border border-border bg-card p-6 shadow-2xl space-y-5 z-10">
      <div class="flex items-center justify-between border-b border-border pb-4">
        <div class="flex items-center gap-2.5">
          <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-primary/10 text-primary">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/>
            </svg>
          </div>
          <h3 class="text-base font-bold text-foreground">Track Pinterest Profile</h3>
        </div>
        <button id="close-add-competitor-modal" class="rounded-lg p-1 text-muted-foreground hover:bg-muted hover:text-foreground">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>

      <div id="add-competitor-error" class="hidden rounded-xl border border-rose-500/30 bg-rose-500/10 p-3 text-xs text-rose-500"></div>

      <form id="add-competitor-form" class="space-y-4">
        <!-- Account Classification Switch -->
        <div class="space-y-1.5">
          <label class="block text-xs font-semibold text-foreground">Profile Classification *</label>
          <div class="grid grid-cols-2 gap-3">
            <label class="flex items-center justify-between rounded-xl border border-border bg-background p-3 cursor-pointer hover:border-primary has-[:checked]:border-primary has-[:checked]:bg-primary/5 transition-all">
              <div class="flex items-center gap-2">
                <span class="text-sm">🎯</span>
                <div>
                  <div class="text-xs font-bold text-foreground">Competitor</div>
                  <div class="text-[10px] text-muted-foreground">External target profile</div>
                </div>
              </div>
              <input type="radio" name="account_type_radio" value="competitor" checked class="text-primary focus:ring-primary" />
            </label>

            <label class="flex items-center justify-between rounded-xl border border-border bg-background p-3 cursor-pointer hover:border-primary has-[:checked]:border-primary has-[:checked]:bg-primary/5 transition-all">
              <div class="flex items-center gap-2">
                <span class="text-sm">👤</span>
                <div>
                  <div class="text-xs font-bold text-foreground">My Account</div>
                  <div class="text-[10px] text-muted-foreground">Internal brand account</div>
                </div>
              </div>
              <input type="radio" name="account_type_radio" value="own" class="text-primary focus:ring-primary" />
            </label>
          </div>
        </div>

        <div class="space-y-1.5">
          <label for="competitor-username-input" class="block text-xs font-semibold text-foreground">Pinterest Username *</label>
          <div class="relative">
            <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-xs font-semibold text-muted-foreground">@</span>
            <input
              id="competitor-username-input"
              type="text"
              required
              placeholder="e.g. tastyrecipes"
              class="w-full rounded-xl border border-border bg-background py-2.5 pl-8 pr-3 text-xs text-foreground placeholder:text-muted-foreground focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
            />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="space-y-1.5">
            <label for="competitor-niche-input" class="block text-xs font-semibold text-foreground">Niche / Category</label>
            <input
              id="competitor-niche-input"
              type="text"
              placeholder="e.g. Food & Cooking"
              class="w-full rounded-xl border border-border bg-background py-2.5 px-3 text-xs text-foreground placeholder:text-muted-foreground focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
            />
          </div>

          <div class="space-y-1.5">
            <label for="competitor-tags-input" class="block text-xs font-semibold text-foreground">Tags (Comma-Separated)</label>
            <input
              id="competitor-tags-input"
              type="text"
              placeholder="e.g. Main, E-com, Priority"
              class="w-full rounded-xl border border-border bg-background py-2.5 px-3 text-xs text-foreground placeholder:text-muted-foreground focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
            />
          </div>
        </div>

        <div class="space-y-1.5">
          <label for="competitor-notes-input" class="block text-xs font-semibold text-foreground">Internal Strategy Notes</label>
          <textarea
            id="competitor-notes-input"
            rows="3"
            placeholder="e.g. Focuses on 30-minute quick dinners and keto meal prep infographics..."
            class="w-full rounded-xl border border-border bg-background py-2 px-3 text-xs text-foreground placeholder:text-muted-foreground focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
          ></textarea>
        </div>

        <div class="flex items-center justify-end gap-3 border-t border-border pt-4">
          <button
            type="button"
            id="cancel-add-competitor-modal"
            class="rounded-xl border border-border px-4 py-2.5 text-xs font-medium text-muted-foreground hover:bg-muted hover:text-foreground"
          >
            Cancel
          </button>
          <button
            type="submit"
            id="submit-add-competitor-modal"
            class="rounded-xl bg-primary px-5 py-2.5 text-xs font-semibold text-primary-foreground shadow-md hover:bg-primary/90 transition-all"
          >
            Start Tracking
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- MODAL 2: DevTools JSON Payload Parser Modal -->
  <div id="paste-payload-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60 backdrop-blur-sm p-4" aria-modal="true" role="dialog">
    <div id="paste-payload-backdrop" class="fixed inset-0"></div>
    <div class="relative w-full max-w-2xl rounded-2xl border border-border bg-card p-6 shadow-2xl space-y-5 z-10">
      <div class="flex items-center justify-between border-b border-border pb-4">
        <div class="flex items-center gap-2.5">
          <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-emerald-500/10 text-emerald-500">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/>
              <rect x="8" y="2" width="8" height="4" rx="1" ry="1"/>
            </svg>
          </div>
          <div>
            <h3 class="text-base font-bold text-foreground">Paste Pinterest DevTools JSON Payload</h3>
            <p class="text-[11px] text-muted-foreground">Bypass rate limits by pasting raw Network tab JSON responses.</p>
          </div>
        </div>
        <button id="close-paste-payload-modal" class="rounded-lg p-1 text-muted-foreground hover:bg-muted hover:text-foreground">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>

      <div id="paste-payload-error" class="hidden rounded-xl border border-rose-500/30 bg-rose-500/10 p-3 text-xs text-rose-500"></div>

      <form id="paste-payload-form" class="space-y-4">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="space-y-1.5">
            <label for="payload-target-competitor-select" class="block text-xs font-semibold text-foreground">Target Profile *</label>
            <select
              id="payload-target-competitor-select"
              required
              class="w-full rounded-xl border border-border bg-background py-2.5 px-3 text-xs text-foreground focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
            >
              <option value="" disabled selected>Select profile...</option>
            </select>
          </div>

          <div class="space-y-1.5">
            <label class="block text-xs font-semibold text-foreground">Payload Auto-Detection</label>
            <div id="payload-detection-badge" class="flex h-10 items-center justify-between rounded-xl border border-border bg-muted/40 px-3 text-xs font-medium text-muted-foreground">
              <span>Detected Type:</span>
              <span id="detected-payload-type" class="rounded bg-muted px-2 py-0.5 text-[10px] font-semibold text-foreground">Waiting for paste...</span>
            </div>
          </div>
        </div>

        <div class="space-y-1.5">
          <label for="raw-payload-textarea" class="block text-xs font-semibold text-foreground">Raw Pinterest DevTools JSON Response *</label>
          <textarea
            id="raw-payload-textarea"
            rows="8"
            required
            placeholder='Paste response JSON here from UserResource or BoardsResource network requests...'
            class="w-full rounded-xl border border-border bg-background py-2.5 px-3 font-mono text-[11px] text-foreground placeholder:text-muted-foreground focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
          ></textarea>
        </div>

        <div class="flex items-center justify-between border-t border-border pt-4">
          <span class="text-[11px] text-muted-foreground">Supports <code class="font-mono text-primary">UserResource</code> & <code class="font-mono text-primary">BoardsResource</code></span>
          <div class="flex items-center gap-3">
            <button
              type="button"
              id="cancel-paste-payload-modal"
              class="rounded-xl border border-border px-4 py-2.5 text-xs font-medium text-muted-foreground hover:bg-muted hover:text-foreground"
            >
              Cancel
            </button>
            <button
              type="submit"
              id="submit-paste-payload-modal"
              class="rounded-xl bg-emerald-600 px-5 py-2.5 text-xs font-semibold text-white shadow-md hover:bg-emerald-500 transition-all"
            >
              Parse & Ingest Payload
            </button>
          </div>
        </div>
      </form>
    </div>
  </div>

  <!-- MODAL 3: Edit Profile Modal -->
  <div id="edit-competitor-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60 backdrop-blur-sm p-4" aria-modal="true" role="dialog">
    <div id="edit-competitor-backdrop" class="fixed inset-0"></div>
    <div class="relative w-full max-w-lg rounded-2xl border border-border bg-card p-6 shadow-2xl space-y-5 z-10">
      <div class="flex items-center justify-between border-b border-border pb-4">
        <div class="flex items-center gap-2.5">
          <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-amber-500/10 text-amber-500">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
            </svg>
          </div>
          <h3 class="text-base font-bold text-foreground">Edit Profile</h3>
        </div>
        <button id="close-edit-competitor-modal" class="rounded-lg p-1 text-muted-foreground hover:bg-muted hover:text-foreground">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>

      <div id="edit-competitor-error" class="hidden rounded-xl border border-rose-500/30 bg-rose-500/10 p-3 text-xs text-rose-500"></div>

      <form id="edit-competitor-form" class="space-y-4">
        <input type="hidden" id="edit-competitor-id" />

        <!-- Account Classification -->
        <div class="space-y-1.5">
          <label class="block text-xs font-semibold text-foreground">Profile Classification *</label>
          <div class="grid grid-cols-2 gap-3">
            <label class="flex items-center justify-between rounded-xl border border-border bg-background p-3 cursor-pointer hover:border-primary has-[:checked]:border-primary has-[:checked]:bg-primary/5 transition-all">
              <div class="flex items-center gap-2">
                <span class="text-sm">🎯</span>
                <div>
                  <div class="text-xs font-bold text-foreground">Competitor</div>
                  <div class="text-[10px] text-muted-foreground">External target profile</div>
                </div>
              </div>
              <input type="radio" name="edit_account_type_radio" value="competitor" class="text-primary focus:ring-primary" />
            </label>

            <label class="flex items-center justify-between rounded-xl border border-border bg-background p-3 cursor-pointer hover:border-primary has-[:checked]:border-primary has-[:checked]:bg-primary/5 transition-all">
              <div class="flex items-center gap-2">
                <span class="text-sm">👤</span>
                <div>
                  <div class="text-xs font-bold text-foreground">My Account</div>
                  <div class="text-[10px] text-muted-foreground">Internal brand account</div>
                </div>
              </div>
              <input type="radio" name="edit_account_type_radio" value="own" class="text-primary focus:ring-primary" />
            </label>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="space-y-1.5">
            <label for="edit-fullname-input" class="block text-xs font-semibold text-foreground">Display Name</label>
            <input
              id="edit-fullname-input"
              type="text"
              placeholder="e.g. Tasty Recipes"
              class="w-full rounded-xl border border-border bg-background py-2.5 px-3 text-xs text-foreground placeholder:text-muted-foreground focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
            />
          </div>

          <div class="space-y-1.5">
            <label for="edit-username-input" class="block text-xs font-semibold text-foreground">Pinterest Username</label>
            <div class="relative">
              <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-xs font-semibold text-muted-foreground">@</span>
              <input
                id="edit-username-input"
                type="text"
                class="w-full rounded-xl border border-border bg-background py-2.5 pl-8 pr-3 text-xs text-foreground placeholder:text-muted-foreground focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
              />
            </div>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="space-y-1.5">
            <label for="edit-niche-input" class="block text-xs font-semibold text-foreground">Niche / Category</label>
            <input
              id="edit-niche-input"
              type="text"
              placeholder="e.g. Food & Cooking"
              class="w-full rounded-xl border border-border bg-background py-2.5 px-3 text-xs text-foreground placeholder:text-muted-foreground focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
            />
          </div>

          <div class="space-y-1.5">
            <label for="edit-tags-input" class="block text-xs font-semibold text-foreground">Tags (Comma-Separated)</label>
            <input
              id="edit-tags-input"
              type="text"
              placeholder="e.g. Main, E-com, Priority"
              class="w-full rounded-xl border border-border bg-background py-2.5 px-3 text-xs text-foreground placeholder:text-muted-foreground focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
            />
          </div>
        </div>

        <div class="flex items-center justify-end gap-3 border-t border-border pt-4">
          <button
            type="button"
            id="cancel-edit-competitor-modal"
            class="rounded-xl border border-border px-4 py-2.5 text-xs font-medium text-muted-foreground hover:bg-muted hover:text-foreground"
          >
            Cancel
          </button>
          <button
            type="submit"
            id="submit-edit-competitor-modal"
            class="rounded-xl bg-amber-500 px-5 py-2.5 text-xs font-semibold text-white shadow-md hover:bg-amber-400 transition-all"
          >
            Save Changes
          </button>
        </div>
      </form>
    </div>
  </div>
</Layout>

<script>
  import {
    getCompetitors,
    addCompetitor,
    deleteCompetitor,
    updateCompetitor,
    parsePinterestPayload,
    ingestDevToolsPayload,
  } from '../lib/competitors';
  import { getActiveWorkspaceId } from '../lib/workspaces';
  import type { Competitor } from '../lib/types';

  // ─── State ────────────────────────────────────────────────────────────────
  let competitorsList: Competitor[] = [];
  let selectedCompetitorIdForPayload: string | null = null;

  // Filter state
  let activeTypeTab: 'all' | 'own' | 'competitor' = 'all';
  let selectedTag = 'all';

  // Sort state (single-column; structured for easy multi-sort extension later)
  type SortKey = 'profile_reach' | 'profile_views' | 'follower_count' | 'pin_count' | 'boards_count' | 'last_pin_at';
  let sortKey: SortKey | null = null;
  let sortDir: 'asc' | 'desc' = 'desc';

  // Column visibility state
  interface ColDef { key: string; label: string; defaultVisible: boolean; locked?: boolean; }
  const COLUMN_DEFS: ColDef[] = [
    { key: 'profile',       label: 'Profile',        defaultVisible: true,  locked: true },
    { key: 'type',          label: 'Type',           defaultVisible: true },
    { key: 'niche',         label: 'Niche',          defaultVisible: false },
    { key: 'reach',         label: 'Monthly Reach',  defaultVisible: true },
    { key: 'views',         label: 'Profile Views',  defaultVisible: true },
    { key: 'followers',     label: 'Followers',      defaultVisible: false },
    { key: 'pins',          label: 'Total Pins',     defaultVisible: true },
    { key: 'boards_count',  label: 'Boards Count',   defaultVisible: true },
    { key: 'last_pin',      label: 'Last Pin',       defaultVisible: true },
    { key: 'strategy_age',  label: 'Strategy Age',   defaultVisible: false },
    { key: 'actions',       label: 'Actions',        defaultVisible: true,  locked: true },
  ];
  // In-memory visibility map
  const colVisible: Record<string, boolean> = {};
  COLUMN_DEFS.forEach(c => { colVisible[c.key] = c.defaultVisible; });

  // ─── DOM Elements ─────────────────────────────────────────────────────────
  const competitorsTableBody  = document.getElementById('competitors-table-body') as HTMLElement;
  const competitorsThead      = document.getElementById('competitors-thead') as HTMLElement;
  const competitorsTfoot      = document.getElementById('competitors-tfoot') as HTMLElement;
  const competitorBadgeCount  = document.getElementById('competitor-badge-count') as HTMLElement;
  const statusBanner          = document.getElementById('competitor-status-banner') as HTMLElement;
  const statusText            = document.getElementById('competitor-status-text') as HTMLElement;
  const dismissStatusBannerBtn = document.getElementById('dismiss-status-banner') as HTMLElement;

  const kpiTotalCompetitors = document.getElementById('kpi-total-competitors') as HTMLElement;
  const kpiOwnCount         = document.getElementById('kpi-own-count') as HTMLElement;
  const kpiCompetitorCount  = document.getElementById('kpi-competitor-count') as HTMLElement;

  const typeTabBtns    = document.querySelectorAll<HTMLButtonElement>('.account-type-tab-btn');
  const tagFilterSelect = document.getElementById('tag-filter-select') as HTMLSelectElement;

  const colVisibilityBtn  = document.getElementById('col-visibility-btn') as HTMLButtonElement;
  const colVisibilityMenu = document.getElementById('col-visibility-menu') as HTMLElement;

  // ─── Utilities ────────────────────────────────────────────────────────────
  function formatNumber(num: number | null | undefined): string {
    if (num === null || num === undefined || isNaN(num)) return '0';
    return num.toLocaleString('en-US');
  }

  function formatDate(isoStr?: string | null): string {
    if (!isoStr) return '—';
    const d = new Date(isoStr);
    if (isNaN(d.getTime())) return '—';
    return d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
  }

  function showStatus(message: string, isError = false) {
    if (!statusBanner || !statusText) return;
    statusText.textContent = message;
    statusBanner.classList.remove('hidden');
    if (isError) {
      statusBanner.className = 'mb-6 rounded-xl border border-rose-500/30 bg-rose-500/10 p-4 text-xs text-rose-600 dark:text-rose-400 flex items-center justify-between shadow-sm';
    } else {
      statusBanner.className = 'mb-6 rounded-xl border border-emerald-500/30 bg-emerald-500/10 p-4 text-xs text-emerald-600 dark:text-emerald-400 flex items-center justify-between shadow-sm';
    }
  }

  if (dismissStatusBannerBtn) {
    dismissStatusBannerBtn.addEventListener('click', () => statusBanner.classList.add('hidden'));
  }

  // ─── Sort helpers ─────────────────────────────────────────────────────────
  function sortIndicator(key: SortKey): string {
    if (sortKey !== key) return '<span class="text-border ml-1 opacity-40">↕</span>';
    return sortDir === 'asc'
      ? '<span class="text-primary ml-1">↑</span>'
      : '<span class="text-primary ml-1">↓</span>';
  }

  function applySortAndFilter(): Competitor[] {
    let filtered = competitorsList.filter(c => {
      if (activeTypeTab === 'own') return c.account_type === 'own';
      if (activeTypeTab === 'competitor') return c.account_type !== 'own';
      return true;
    });

    if (selectedTag !== 'all') {
      filtered = filtered.filter(c => Array.isArray(c.tags) && c.tags.includes(selectedTag));
    }

    if (sortKey) {
      filtered = [...filtered].sort((a, b) => {
        let av: any;
        let bv: any;
        if (sortKey === 'last_pin_at') {
          av = a.last_pin_at ? new Date(a.last_pin_at).getTime() : 0;
          bv = b.last_pin_at ? new Date(b.last_pin_at).getTime() : 0;
        } else {
          av = (a as any)[sortKey as string] ?? 0;
          bv = (b as any)[sortKey as string] ?? 0;
        }
        return sortDir === 'asc' ? av - bv : bv - av;
      });
    }

    return filtered;
  }

  function handleSortClick(key: SortKey) {
    if (sortKey === key) {
      sortDir = sortDir === 'asc' ? 'desc' : 'asc';
    } else {
      sortKey = key;
      sortDir = 'desc';
    }
    renderTable();
  }

  // ─── Column Visibility Menu ───────────────────────────────────────────────
  function buildColVisibilityMenu() {
    if (!colVisibilityMenu) return;
    colVisibilityMenu.innerHTML = COLUMN_DEFS
      .filter(c => !c.locked)
      .map(c => `
        <label class="flex items-center gap-2 px-2 py-1.5 rounded-lg cursor-pointer hover:bg-muted/60 transition-colors text-xs font-medium text-foreground">
          <input
            type="checkbox"
            class="col-visibility-checkbox rounded accent-primary"
            data-col-key="${c.key}"
            ${colVisible[c.key] ? 'checked' : ''}
          />
          <span>${c.label}</span>
        </label>
      `).join('');

    colVisibilityMenu.querySelectorAll<HTMLInputElement>('.col-visibility-checkbox').forEach(cb => {
      cb.addEventListener('change', () => {
        const key = cb.dataset.colKey!;
        colVisible[key] = cb.checked;
        renderTable();
      });
    });
  }

  // Toggle menu open/close
  if (colVisibilityBtn) {
    colVisibilityBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      colVisibilityMenu.classList.toggle('hidden');
    });
  }
  document.addEventListener('click', (e) => {
    const wrapper = document.getElementById('col-visibility-wrapper');
    if (wrapper && !wrapper.contains(e.target as Node)) {
      colVisibilityMenu?.classList.add('hidden');
    }
  });

  // ─── Header Rendering ─────────────────────────────────────────────────────
  function renderTableHeader() {
    if (!competitorsThead) return;

    const sortableCols: Record<string, SortKey> = {
      reach:        'profile_reach',
      views:        'profile_views',
      followers:    'follower_count',
      pins:         'pin_count',
      boards_count: 'boards_count',
      last_pin:     'last_pin_at',
    };

    const visibleCols = COLUMN_DEFS.filter(c => colVisible[c.key] || c.locked);

    competitorsThead.innerHTML = `
      <tr>
        ${visibleCols.map(c => {
          const sk = sortableCols[c.key];
          const isRight = c.key === 'actions';
          const sortable = !!sk;
          const cursor = sortable ? 'cursor-pointer select-none hover:text-primary' : '';
          const align = isRight ? 'text-right' : '';
          const padding = (c.key === 'profile' || c.key === 'actions') ? 'py-3.5 px-6' : 'py-3.5 px-4';
          return `
            <th scope="col" class="${padding} ${align} ${cursor}" ${sortable ? `data-sort-col="${c.key}"` : ''}>
              <span class="inline-flex items-center gap-0.5">
                ${c.label}
                ${sk ? sortIndicator(sk) : ''}
              </span>
            </th>
          `;
        }).join('')}
      </tr>
    `;

    // Attach sort listeners
    competitorsThead.querySelectorAll<HTMLElement>('[data-sort-col]').forEach(th => {
      th.addEventListener('click', () => {
        const colKey = th.dataset.sortCol!;
        const sk = sortableCols[colKey];
        if (sk) handleSortClick(sk);
      });
    });
  }

  // ─── Summary Row (tfoot) ─────────────────────────────────────────────────
  function renderSummaryRow(filtered: Competitor[]) {
    if (!competitorsTfoot) return;

    if (filtered.length === 0) {
      competitorsTfoot.classList.add('hidden');
      return;
    }

    const totalReach = filtered.reduce((s, c) => s + (c.profile_reach || 0), 0);
    const totalViews = filtered.reduce((s, c) => s + (c.profile_views || 0), 0);
    const totalPins  = filtered.reduce((s, c) => s + (c.pin_count || 0), 0);

    const visibleCols = COLUMN_DEFS.filter(c => colVisible[c.key] || c.locked);

    const cells = visibleCols.map(c => {
      if (c.key === 'profile') {
        return `<td class="py-3 px-6 font-bold text-xs text-foreground">∑ Totals (${filtered.length} rows)</td>`;
      }
      if (c.key === 'reach') return `<td class="py-3 px-4 font-bold text-xs text-emerald-500">${formatNumber(totalReach)}</td>`;
      if (c.key === 'views') return `<td class="py-3 px-4 font-bold text-xs text-foreground">${formatNumber(totalViews)}</td>`;
      if (c.key === 'pins')  return `<td class="py-3 px-4 font-bold text-xs text-foreground">${formatNumber(totalPins)}</td>`;
      return `<td class="py-3 px-4"></td>`;
    }).join('');

    competitorsTfoot.innerHTML = `<tr class="bg-muted/40">${cells}</tr>`;
    competitorsTfoot.classList.remove('hidden');
  }

  // ─── Main Table Renderer ──────────────────────────────────────────────────
  function renderTable() {
    if (!competitorsTableBody) return;

    renderTableHeader();

    const filtered = applySortAndFilter();

    if (competitorBadgeCount) {
      competitorBadgeCount.textContent = `${filtered.length} ${filtered.length === 1 ? 'Profile' : 'Profiles'}`;
    }

    if (filtered.length === 0) {
      competitorsTableBody.innerHTML = `
        <tr>
          <td colspan="99" class="py-12 text-center text-xs text-muted-foreground">
            No profile records match your selected filters. Click <span class="font-semibold text-foreground">Track Profile</span> to add profiles!
          </td>
        </tr>
      `;
      renderSummaryRow([]);
      return;
    }

    const visibleCols = COLUMN_DEFS.filter(c => colVisible[c.key] || c.locked);

    competitorsTableBody.innerHTML = filtered.map((c) => {
      const avatar         = c.avatar_url || `https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=200&h=200&q=80`;
      const strategyAge    = c.strategy_age_days ? `${c.strategy_age_days}d active` : 'Unknown';
      const isOwn          = c.account_type === 'own';
      const typePill       = isOwn
        ? `<span class="inline-flex items-center gap-1 rounded-full bg-blue-500/10 px-2 py-0.5 text-[10px] font-bold text-blue-500 border border-blue-500/20">👤 My Account</span>`
        : `<span class="inline-flex items-center gap-1 rounded-full bg-purple-500/10 px-2 py-0.5 text-[10px] font-bold text-purple-500 border border-purple-500/20">🎯 Competitor</span>`;

      const tagsHtml = (Array.isArray(c.tags) && c.tags.length > 0)
        ? `<div class="flex flex-wrap items-center gap-1 pt-1">${c.tags.map(t => `<span class="rounded bg-muted px-1.5 py-0.5 text-[9.5px] font-semibold text-muted-foreground border border-border/50">#${t}</span>`).join('')}</div>`
        : '';

      const cellMap: Record<string, string> = {
        profile: `
          <td class="py-4 px-6">
            <div class="flex items-center gap-3">
              <img src="${avatar}" alt="${c.username}" class="h-10 w-10 rounded-full object-cover border border-border shadow-sm flex-shrink-0" />
              <div class="flex flex-col min-w-0">
                <a href="/competitors/details?id=${c.id}" class="text-xs font-bold text-foreground hover:text-primary transition-colors truncate">
                  ${c.full_name || c.username}
                </a>
                <div class="flex items-center gap-1.5 text-[11px] text-muted-foreground">
                  <span>@${c.username}</span>
                  <a href="https://www.pinterest.com/${c.username}/" target="_blank" rel="noopener noreferrer" class="text-muted-foreground/70 hover:text-primary" title="View Pinterest Profile">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 inline" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                  </a>
                </div>
                ${tagsHtml}
              </div>
            </div>
          </td>`,

        type: `<td class="py-4 px-4">${typePill}</td>`,

        niche: `
          <td class="py-4 px-4">
            <span class="inline-flex items-center rounded-md bg-muted px-2 py-1 text-[11px] font-medium text-foreground">
              ${c.niche || 'General'}
            </span>
          </td>`,

        reach:    `<td class="py-4 px-4 font-bold text-emerald-500">${formatNumber(c.profile_reach || 0)}</td>`,
        views:    `<td class="py-4 px-4 font-semibold text-foreground">${formatNumber(c.profile_views || 0)}</td>`,
        followers:`<td class="py-4 px-4 font-semibold text-foreground">${formatNumber(c.follower_count || 0)}</td>`,
        pins:     `<td class="py-4 px-4 text-foreground">${formatNumber(c.pin_count || 0)}</td>`,

        boards_count: `
          <td class="py-4 px-4">
            <span class="inline-flex items-center rounded-md bg-muted/60 px-2 py-1 text-[11px] font-semibold text-foreground">
              ${c.boards_count ?? 0}
            </span>
          </td>`,

        last_pin: `<td class="py-4 px-4 text-[11px] text-muted-foreground">${formatDate(c.last_pin_at)}</td>`,

        strategy_age: `
          <td class="py-4 px-4">
            <span class="rounded bg-primary/10 px-2 py-0.5 text-[10px] font-semibold text-primary">
              ${strategyAge}
            </span>
          </td>`,

        actions: `
          <td class="py-4 px-6 text-right">
            <div class="flex items-center justify-end gap-2">
              <button
                data-edit-id="${c.id}"
                class="edit-competitor-btn rounded-lg border border-border p-1.5 text-muted-foreground hover:bg-amber-500/10 hover:text-amber-500 transition-colors"
                title="Edit profile"
              >
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
              </button>

              <button
                data-paste-id="${c.id}"
                class="paste-payload-btn rounded-lg border border-border p-1.5 text-muted-foreground hover:bg-muted hover:text-foreground"
                title="Paste DevTools Payload for this profile"
              >
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><rect x="8" y="2" width="8" height="4" rx="1" ry="1"/></svg>
              </button>

              <a
                href="/competitors/details?id=${c.id}"
                class="inline-flex items-center gap-1 rounded-lg border border-border bg-card px-2.5 py-1.5 text-[11px] font-semibold text-foreground hover:bg-primary hover:text-primary-foreground hover:border-primary transition-all shadow-sm"
              >
                <span>Deep-Dive</span>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
              </a>

              <button
                data-delete-id="${c.id}"
                class="delete-competitor-btn rounded-lg p-1.5 text-muted-foreground hover:bg-rose-500/10 hover:text-rose-500 transition-colors"
                title="Delete profile"
              >
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
              </button>
            </div>
          </td>`,
      };

      const cells = visibleCols.map(col => cellMap[col.key] || `<td class="py-4 px-4"></td>`).join('');
      return `<tr class="hover:bg-muted/30 transition-colors">${cells}</tr>`;
    }).join('');

    // Attach row button listeners
    competitorsTableBody.querySelectorAll<HTMLElement>('.edit-competitor-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const id = btn.dataset.editId!;
        openEditModal(id);
      });
    });

    competitorsTableBody.querySelectorAll<HTMLElement>('.paste-payload-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const id = btn.dataset.pasteId;
        if (id) openPasteModal(id);
      });
    });

    competitorsTableBody.querySelectorAll<HTMLElement>('.delete-competitor-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        const id = btn.dataset.deleteId;
        if (id && confirm('Are you sure you want to remove this profile from tracking?')) {
          try {
            await deleteCompetitor(id);
            showStatus('Profile removed successfully.');
            await loadWorkspaceData();
          } catch (err: any) {
            showStatus(`Failed to delete: ${err.message}`, true);
          }
        }
      });
    });

    renderSummaryRow(filtered);
  }

  // ─── KPI Rendering ────────────────────────────────────────────────────────
  function renderKPIs() {
    const total      = competitorsList.length;
    const ownCount   = competitorsList.filter(c => c.account_type === 'own').length;
    const compCount  = competitorsList.filter(c => c.account_type !== 'own').length;

    if (kpiTotalCompetitors) kpiTotalCompetitors.textContent = String(total);
    if (kpiOwnCount)         kpiOwnCount.textContent = String(ownCount);
    if (kpiCompetitorCount)  kpiCompetitorCount.textContent = String(compCount);
  }

  // ─── Tag Dropdown ─────────────────────────────────────────────────────────
  function populateTagDropdown() {
    if (!tagFilterSelect) return;
    const tagsSet = new Set<string>();
    competitorsList.forEach(c => {
      if (Array.isArray(c.tags)) c.tags.forEach(t => tagsSet.add(t));
    });

    const tagsArr = Array.from(tagsSet).sort();
    tagFilterSelect.innerHTML = `<option value="all">All Tags</option>` +
      tagsArr.map(t => `<option value="${t}" ${selectedTag === t ? 'selected' : ''}>#${t}</option>`).join('');
  }

  // ─── Payload select ───────────────────────────────────────────────────────
  const payloadTargetSelect    = document.getElementById('payload-target-competitor-select') as HTMLSelectElement;
  const rawPayloadTextarea     = document.getElementById('raw-payload-textarea') as HTMLTextAreaElement;
  const detectedPayloadTypeSpan = document.getElementById('detected-payload-type') as HTMLElement;

  function populatePayloadSelect() {
    if (!payloadTargetSelect) return;
    payloadTargetSelect.innerHTML = `
      <option value="" disabled selected>Select profile...</option>
      ${competitorsList
        .map(c => `<option value="${c.id}" ${selectedCompetitorIdForPayload === c.id ? 'selected' : ''}>${c.full_name || c.username} (@${c.username})</option>`)
        .join('')}
    `;
  }

  // ─── Load data ────────────────────────────────────────────────────────────
  async function loadWorkspaceData() {
    const activeWsId = getActiveWorkspaceId();
    competitorsList = await getCompetitors(activeWsId);
    populateTagDropdown();
    renderKPIs();
    renderTable();
    populatePayloadSelect();
    buildColVisibilityMenu();
  }

  // ─── Filters ─────────────────────────────────────────────────────────────
  typeTabBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      typeTabBtns.forEach(b => {
        b.className = 'account-type-tab-btn rounded-lg px-3.5 py-1.5 text-xs font-semibold text-muted-foreground hover:text-foreground transition-all flex items-center gap-1';
      });
      btn.className = 'account-type-tab-btn rounded-lg px-3.5 py-1.5 text-xs font-semibold bg-background text-foreground shadow-xs transition-all flex items-center gap-1';
      activeTypeTab = (btn.dataset.typeTab as any) || 'all';
      renderTable();
    });
  });

  if (tagFilterSelect) {
    tagFilterSelect.addEventListener('change', () => {
      selectedTag = tagFilterSelect.value;
      renderTable();
    });
  }

  // ─── Add Competitor Modal ─────────────────────────────────────────────────
  const addCompetitorModal    = document.getElementById('add-competitor-modal') as HTMLElement;
  const openAddCompetitorBtn  = document.getElementById('open-add-competitor-modal') as HTMLElement;
  const closeAddCompetitorBtn = document.getElementById('close-add-competitor-modal') as HTMLElement;
  const cancelAddCompetitorBtn = document.getElementById('cancel-add-competitor-modal') as HTMLElement;
  const addCompetitorForm     = document.getElementById('add-competitor-form') as HTMLFormElement;
  const addCompetitorError    = document.getElementById('add-competitor-error') as HTMLElement;

  function openAddModal() {
    if (addCompetitorError) addCompetitorError.classList.add('hidden');
    if (addCompetitorForm) addCompetitorForm.reset();
    addCompetitorModal?.classList.remove('hidden');
    addCompetitorModal?.classList.add('flex');
  }
  function closeAddModal() {
    addCompetitorModal?.classList.add('hidden');
    addCompetitorModal?.classList.remove('flex');
  }

  if (openAddCompetitorBtn)  openAddCompetitorBtn.addEventListener('click', openAddModal);
  if (closeAddCompetitorBtn) closeAddCompetitorBtn.addEventListener('click', closeAddModal);
  if (cancelAddCompetitorBtn) cancelAddCompetitorBtn.addEventListener('click', closeAddModal);
  document.getElementById('add-competitor-backdrop')?.addEventListener('click', closeAddModal);

  if (addCompetitorForm) {
    addCompetitorForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const typeRadio    = document.querySelector<HTMLInputElement>('input[name="account_type_radio"]:checked');
      const accountTypeVal = typeRadio?.value || 'competitor';
      const usernameInput = (document.getElementById('competitor-username-input') as HTMLInputElement).value;
      const nicheInput    = (document.getElementById('competitor-niche-input') as HTMLInputElement).value;
      const tagsInput     = (document.getElementById('competitor-tags-input') as HTMLInputElement).value;
      const notesInput    = (document.getElementById('competitor-notes-input') as HTMLTextAreaElement).value;

      try {
        const activeWsId = getActiveWorkspaceId();
        await addCompetitor({ username: usernameInput, niche: nicheInput, notes: notesInput, account_type: accountTypeVal as 'own' | 'competitor', tags: tagsInput, workspace_id: activeWsId });
        closeAddModal();
        showStatus(`Profile @${usernameInput.replace(/^@/, '')} added to workspace!`);
        await loadWorkspaceData();
      } catch (err: any) {
        if (addCompetitorError) {
          addCompetitorError.textContent = err.message || 'Failed to add profile.';
          addCompetitorError.classList.remove('hidden');
        }
      }
    });
  }

  // ─── Edit Competitor Modal ────────────────────────────────────────────────
  const editCompetitorModal    = document.getElementById('edit-competitor-modal') as HTMLElement;
  const closeEditCompetitorBtn = document.getElementById('close-edit-competitor-modal') as HTMLElement;
  const cancelEditCompetitorBtn = document.getElementById('cancel-edit-competitor-modal') as HTMLElement;
  const editCompetitorForm     = document.getElementById('edit-competitor-form') as HTMLFormElement;
  const editCompetitorError    = document.getElementById('edit-competitor-error') as HTMLElement;
  const editIdInput            = document.getElementById('edit-competitor-id') as HTMLInputElement;
  const editFullnameInput      = document.getElementById('edit-fullname-input') as HTMLInputElement;
  const editUsernameInput      = document.getElementById('edit-username-input') as HTMLInputElement;
  const editNicheInput         = document.getElementById('edit-niche-input') as HTMLInputElement;
  const editTagsInput          = document.getElementById('edit-tags-input') as HTMLInputElement;

  function openEditModal(id: string) {
    const competitor = competitorsList.find(c => c.id === id);
    if (!competitor) return;

    if (editCompetitorError) editCompetitorError.classList.add('hidden');
    if (editIdInput)       editIdInput.value = id;
    if (editFullnameInput) editFullnameInput.value = competitor.full_name || '';
    if (editUsernameInput) editUsernameInput.value = competitor.username || '';
    if (editNicheInput)    editNicheInput.value = competitor.niche || '';
    if (editTagsInput)     editTagsInput.value = Array.isArray(competitor.tags) ? competitor.tags.join(', ') : '';

    // Set radio
    const currentType = competitor.account_type === 'own' ? 'own' : 'competitor';
    const radios = document.querySelectorAll<HTMLInputElement>('input[name="edit_account_type_radio"]');
    radios.forEach(r => { r.checked = r.value === currentType; });

    editCompetitorModal?.classList.remove('hidden');
    editCompetitorModal?.classList.add('flex');
  }

  function closeEditModal() {
    editCompetitorModal?.classList.add('hidden');
    editCompetitorModal?.classList.remove('flex');
  }

  if (closeEditCompetitorBtn) closeEditCompetitorBtn.addEventListener('click', closeEditModal);
  if (cancelEditCompetitorBtn) cancelEditCompetitorBtn.addEventListener('click', closeEditModal);
  document.getElementById('edit-competitor-backdrop')?.addEventListener('click', closeEditModal);

  if (editCompetitorForm) {
    editCompetitorForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const id = editIdInput?.value;
      if (!id) return;

      const typeRadio = document.querySelector<HTMLInputElement>('input[name="edit_account_type_radio"]:checked');
      const rawTags = editTagsInput?.value || '';
      const tagsArr = rawTags.split(',').map(t => t.trim()).filter(Boolean);

      const submitBtn = document.getElementById('submit-edit-competitor-modal') as HTMLButtonElement;
      if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = 'Saving…'; }

      try {
        await updateCompetitor(id, {
          full_name:    editFullnameInput?.value || undefined,
          username:     editUsernameInput?.value || undefined,
          account_type: typeRadio?.value || 'competitor',
          niche:        editNicheInput?.value || undefined,
          tags:         tagsArr,
        });

        closeEditModal();
        showStatus('Profile updated successfully.');
        await loadWorkspaceData();
      } catch (err: any) {
        if (editCompetitorError) {
          editCompetitorError.textContent = err.message || 'Failed to update profile.';
          editCompetitorError.classList.remove('hidden');
        }
      } finally {
        if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = 'Save Changes'; }
      }
    });
  }

  // ─── Paste Payload Modal ──────────────────────────────────────────────────
  const pastePayloadModal    = document.getElementById('paste-payload-modal') as HTMLElement;
  const openPastePayloadBtn  = document.getElementById('open-paste-payload-modal') as HTMLElement;
  const closePastePayloadBtn = document.getElementById('close-paste-payload-modal') as HTMLElement;
  const cancelPastePayloadBtn = document.getElementById('cancel-paste-payload-modal') as HTMLElement;
  const pastePayloadForm     = document.getElementById('paste-payload-form') as HTMLFormElement;
  const pastePayloadError    = document.getElementById('paste-payload-error') as HTMLElement;

  function openPasteModal(competitorId?: string) {
    selectedCompetitorIdForPayload = competitorId || null;
    populatePayloadSelect();
    if (pastePayloadError) pastePayloadError.classList.add('hidden');
    if (pastePayloadForm) pastePayloadForm.reset();
    if (detectedPayloadTypeSpan) {
      detectedPayloadTypeSpan.textContent = 'Waiting for paste...';
      detectedPayloadTypeSpan.className = 'rounded bg-muted px-2 py-0.5 text-[10px] font-semibold text-foreground';
    }
    pastePayloadModal?.classList.remove('hidden');
    pastePayloadModal?.classList.add('flex');
  }

  function closePasteModal() {
    pastePayloadModal?.classList.add('hidden');
    pastePayloadModal?.classList.remove('flex');
  }

  if (openPastePayloadBtn)   openPastePayloadBtn.addEventListener('click', () => openPasteModal());
  if (closePastePayloadBtn)  closePastePayloadBtn.addEventListener('click', closePasteModal);
  if (cancelPastePayloadBtn) cancelPastePayloadBtn.addEventListener('click', closePasteModal);
  document.getElementById('paste-payload-backdrop')?.addEventListener('click', closePasteModal);

  if (rawPayloadTextarea) {
    rawPayloadTextarea.addEventListener('input', () => {
      const text = rawPayloadTextarea.value.trim();
      if (!text) {
        if (detectedPayloadTypeSpan) {
          detectedPayloadTypeSpan.textContent = 'Waiting for paste...';
          detectedPayloadTypeSpan.className = 'rounded bg-muted px-2 py-0.5 text-[10px] font-semibold text-foreground';
        }
        return;
      }
      const parsed = parsePinterestPayload(text);
      if (parsed.type === 'user_profile') {
        if (detectedPayloadTypeSpan) {
          detectedPayloadTypeSpan.textContent = '✓ User Profile (UserResource)';
          detectedPayloadTypeSpan.className = 'rounded bg-emerald-500/20 text-emerald-500 px-2 py-0.5 text-[10px] font-bold';
        }
      } else if (parsed.type === 'user_boards') {
        if (detectedPayloadTypeSpan) {
          detectedPayloadTypeSpan.textContent = '✓ User Boards (BoardsResource)';
          detectedPayloadTypeSpan.className = 'rounded bg-primary/20 text-primary px-2 py-0.5 text-[10px] font-bold';
        }
      } else {
        if (detectedPayloadTypeSpan) {
          detectedPayloadTypeSpan.textContent = '✕ Unknown Payload';
          detectedPayloadTypeSpan.className = 'rounded bg-rose-500/20 text-rose-500 px-2 py-0.5 text-[10px] font-bold';
        }
      }
    });
  }

  if (pastePayloadForm) {
    pastePayloadForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const targetId   = payloadTargetSelect?.value;
      const payloadText = rawPayloadTextarea?.value.trim();

      if (!targetId) {
        if (pastePayloadError) {
          pastePayloadError.textContent = 'Please select a target profile.';
          pastePayloadError.classList.remove('hidden');
        }
        return;
      }

      const res = await ingestDevToolsPayload(targetId, payloadText);
      if (res.success) {
        closePasteModal();
        showStatus(res.message);
        await loadWorkspaceData();
      } else {
        if (pastePayloadError) {
          pastePayloadError.textContent = res.message;
          pastePayloadError.classList.remove('hidden');
        }
      }
    });
  }

  // ─── Boot ─────────────────────────────────────────────────────────────────
  loadWorkspaceData();
</script>
